APP_NAME=Swishtag
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your-mailbox@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=your-mailbox@yourdomain.com
MAIL_FROM_NAME="Swishtag"
MAIL_TO=hello@swishtag.com
MEETING_REMINDER_TO=hello@swishtag.com
MEETING_REMINDER_WINDOW_HOURS=24
MEETING_REMINDER_SEND_TO_CUSTOMER=true
MEETING_CONFIRMATION_TO=hello@swishtag.com
MEETING_CONFIRMATION_SEND_TO_CUSTOMER=true

ZOOM_ENABLED=false
ZOOM_REGISTRATION_ENABLED=true
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_MEETING_DURATION_MINUTES=30
ZOOM_CONTACT_NAME="Swishtag"
ZOOM_CONTACT_EMAIL=hello@swishtag.com
ZOOM_INVITEE_EMAILS=hello@swishtag.com
ZOOM_MEETING_TOPIC_TEMPLATE="Swishtag demo with ${companyName}"
ZOOM_MEETING_AGENDA_TEMPLATE="Demo requested by ${displayName} from ${companyName}. Focus: ${fields.solutionInterest}."

PUBLIC_FORM_SUBMISSION_MODE=direct
PUBLIC_DIRECT_FORM_ENDPOINT=/api/forms/submit
PUBLIC_WORDPRESS_FORM_ENDPOINT=https://cms.swishtag.com/wp-json/astro-form/v1/submit
WORDPRESS_PROJECTS_ENDPOINT=https://cms.swishtag.com/wp-json/wp/v2/portfolio
WORDPRESS_CMS_ORIGIN=https://cms.swishtag.com
PUBLIC_ASTRO_FORM_TOKEN=replace-with-the-wordpress-form-token
SITE_URL=https://cms.swishtag.com

DB_DRIVER=mongodb

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=swishtag
FORM_SUBMISSIONS_COLLECTION=form_submissions
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000

# To use MySQL instead, set DB_DRIVER=mysql and provide either MYSQL_URL
# or the individual connection values. On Hostinger Node apps, use 127.0.0.1.
MYSQL_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=swishtag
MYSQL_USER=swishtag_user
MYSQL_PASSWORD=
MYSQL_FORM_SUBMISSIONS_TABLE=form_submissions
MYSQL_CONNECTION_LIMIT=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-this-admin-session-secret
CRON_SECRET=change-this-cron-secret
