<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "-[a-f0-9]{10}\.(webp|png|jpg|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Non-hashed site JS/CSS (e.g. /assets/site-shell.js) change without renames: short cache.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  # Hashed Astro bundles (name.XXXXXXXX.js/css) never change: long cache. Must come after the rule above.
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Self-hosted fonts carry their version in the file name (e.g. plus-jakarta-sans-v12-latin.woff2).
  <FilesMatch "-v[0-9]+-[a-z-]+\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
