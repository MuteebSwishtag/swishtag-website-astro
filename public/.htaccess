<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "-[a-f0-9]{10}\.(webp|png|jpg|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "[.-][A-Za-z0-9_-]{8,}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Self-hosted fonts carry their version in the file name (e.g. plus-jakarta-sans-v12-latin.woff2).
  <FilesMatch "-v[0-9]+-[a-z-]+\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
