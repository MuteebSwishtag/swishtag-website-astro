# Load these only in the standalone MCP service, never in PUBLIC_* Astro vars.
# Leave blank to use mcp/config.json next to this example, regardless of working directory.
# An explicit path resolves from the service's working directory; prefer an absolute path.
MCP_CONFIG_PATH=
MCP_HOST=127.0.0.1
MCP_PORT=3100
MCP_PUBLIC_URL=https://mcp.swishtag.com/mcp
MCP_OAUTH_ISSUER=https://YOUR-IDENTITY-PROVIDER.example.com/
MCP_OAUTH_AUDIENCE=https://mcp.swishtag.com/mcp
MCP_OAUTH_JWKS_URI=https://YOUR-IDENTITY-PROVIDER.example.com/.well-known/jwks.json

# Repository-scoped GitHub fine-grained PAT or rotated GitHub App installation token.
# Contents: read/write; Actions: read/write; Pull requests: read/write; Issues: read; Metadata: read.
MCP_GITHUB_TOKEN=

# WordPress service account with only capabilities needed by assigned MCP roles.
# The application password is separate from every person's OAuth sign-in.
MCP_WORDPRESS_BASE_URL=https://cms.swishtag.com
MCP_WORDPRESS_USERNAME=
MCP_WORDPRESS_APPLICATION_PASSWORD=

# Optional Hostinger provider build-status API; native Git deployment needs no hosting token.
MCP_HOSTINGER_TOKEN=

# Durable single-instance audit volume, outside every website/public directory.
# Blank uses .mcp-runtime/audit.jsonl at the repository root.
MCP_AUDIT_PATH=
