a{color:inherit;text-decoration:none}
button{font:inherit}
img,svg{display:block;max-width:100%}
.page{width:var(--page);margin-inline:auto}
.section{position:relative;padding:102px 0}
.eyebrow{margin:0 0 18px;color:#74777b;font-size:.76rem;line-height:1;font-weight:800;letter-spacing:.145em;text-transform:uppercase}
.title{margin:0;max-width:940px;font-size:clamp(2.8rem,4.8vw,5rem);line-height:.97;letter-spacing:-.06em;font-weight:700}
.copy{margin:22px 0 0;max-width:760px;color:var(--muted);font-size:clamp(.96rem,1.1vw,1.08rem);line-height:1.68}
.btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:31px}
.btn{min-height:54px;padding:0 23px;border-radius:999px;border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:.9rem;font-weight:700;transition:transform .28s var(--ease),box-shadow .28s var(--ease),background .28s var(--ease),border-color .28s var(--ease)}
.btn:hover{transform:translateY(-3px)}
.btn-primary{background:var(--lime);color:var(--graphite);box-shadow:0 10px 24px rgba(194,255,2,.24)}
.btn-outline{background:rgba(255,255,255,.85);border-color:rgba(32,33,36,.18);backdrop-filter:blur(10px)}
.btn-dark{background:var(--graphite);color:#fff}
