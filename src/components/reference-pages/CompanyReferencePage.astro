.brand{display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:1rem;letter-spacing:.035em}
.brandmark{position:relative;width:24px;height:24px;border-radius:8px;background:linear-gradient(145deg,var(--lime) 0 28%,var(--mint) 28% 54%,var(--lavender) 54% 78%,var(--peach) 78%);box-shadow:inset 0 0 0 1px rgba(32,33,36,.08);transform:rotate(7deg)}
.brandmark:after{content:"";position:absolute;width:7px;height:7px;border-radius:50%;right:4px;top:4px;background:#fff;border:1px solid rgba(32,33,36,.08)}
.navlinks{display:flex;align-items:center;justify-content:center;gap:4px}
.navlinks a{padding:10px 12px;border-radius:999px;color:#555a60;font-size:.79rem;font-weight:700;transition:.22s ease}
.navlinks a:hover,.navlinks a.active{background:#F1F2F1;color:var(--graphite)}
.nav>.btn{min-height:46px;padding-inline:18px}
.menu-toggle{display:none;width:46px;height:46px;border:0;border-radius:50%;background:var(--gray);place-items:center;padding:0}
.menu-toggle span{display:block;width:20px;height:2px;margin:3px 0;border-radius:999px;background:var(--graphite)}
.mobile-menu{position:fixed;inset:0;z-index:100;visibility:hidden;opacity:0;pointer-events:none;transition:.22s ease}
.mobile-menu.open{visibility:visible;opacity:1;pointer-events:auto}
.mobile-backdrop{position:absolute;inset:0;background:rgba(32,33,36,.28);backdrop-filter:blur(5px)}
.mobile-panel{position:absolute;right:12px;top:12px;bottom:12px;width:min(440px,calc(100vw - 24px));padding:18px;border-radius:30px;background:radial-gradient(circle at 85% 6%,rgba(153,254,237,.26),transparent 25%),radial-gradient(circle at 10% 90%,rgba(217,214,253,.28),transparent 28%),#fff;border:1px solid rgba(32,33,36,.08);box-shadow:0 36px 100px rgba(32,33,36,.2);transform:translateX(20px);transition:.28s var(--ease);display:flex;flex-direction:column}
.mobile-menu.open .mobile-panel{transform:none}
.mobile-top{display:flex;align-items:center;justify-content:space-between;padding-bottom:14px}
.mobile-close{width:44px;height:44px;border:0;border-radius:50%;background:var(--gray);font-size:1.35rem}
.mobile-intro{padding:20px;border-radius:22px;background:var(--graphite);color:#fff;margin:8px 0 12px}
.mobile-intro small{display:block;color:rgba(255,255,255,.5);font-size:.65rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
.mobile-intro p{margin:9px 0 0;color:rgba(255,255,255,.7);font-size:.8rem;line-height:1.55}
.mobile-links{display:grid}
.mobile-links a{display:flex;align-items:center;justify-content:space-between;min-height:58px;border-bottom:1px solid var(--line);font-weight:750;font-size:.9rem}
.mobile-panel>.btn{margin-top:auto;width:100%}

/* Hero */
.hero{min-height:100svh;padding:154px 0 74px;display:flex;align-items:center;position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(circle at 88% 8%,rgba(217,214,253,.56),transparent 24%),radial-gradient(circle at 76% 24%,rgba(153,254,237,.35),transparent 25%),radial-gradient(circle at 58% 91%,rgba(255,189,155,.18),transparent 19%),linear-gradient(180deg,#fff 0%,#fbffff 100%)}
.hero-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:54px;align-items:center}
.hero h1{margin:0;max-width:780px;font-size:clamp(3.7rem,6vw,6.25rem);line-height:.92;letter-spacing:-.068em;font-weight:700}
.hero .copy{max-width:690px}
.hero-trust{margin-top:22px;display:flex;align-items:center;gap:10px;color:#777d84;font-size:.76rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.hero-trust i{width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 5px rgba(194,255,2,.16)}
.company-system{position:relative;min-height:650px;isolation:isolate}
.company-system:before{content:"";position:absolute;inset:60px 16px 10px;border-radius:50%;background:radial-gradient(circle at 50% 50%,rgba(153,254,237,.27),transparent 34%),radial-gradient(circle at 64% 55%,rgba(217,214,253,.31),transparent 48%);filter:blur(9px);z-index:-2}
.system-grid{position:absolute;inset:82px 45px 34px;background-image:linear-gradient(rgba(32,33,36,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(32,33,36,.035) 1px,transparent 1px);background-size:38px 38px;mask-image:radial-gradient(circle,#000 22%,transparent 76%);z-index:-1}
.orbit{position:absolute;left:50%;top:51%;transform:translate(-50%,-50%);border:1px solid rgba(32,33,36,.09);border-radius:50%}
.orbit.one{width:510px;height:510px}
.orbit.two{width:382px;height:382px;border-style:dashed}
.orbit.three{width:250px;height:250px;border-color:rgba(194,255,2,.36)}
.core{position:absolute;left:50%;top:51%;transform:translate(-50%,-50%);width:194px;height:194px;border-radius:50%;display:grid;place-items:center;text-align:center;background:var(--graphite);color:#fff;box-shadow:0 0 0 28px rgba(153,254,237,.12),0 28px 58px rgba(32,33,36,.17);animation:coreFloat 5.5s ease-in-out infinite}
.core small{display:block;color:var(--mint);font-size:.57rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.core strong{display:block;margin-top:8px;font-size:1.6rem;letter-spacing:-.06em}
.core span{display:block;margin-top:7px;color:rgba(255,255,255,.55);font-size:.57rem}
.core:after{content:"";position:absolute;width:8px;height:8px;border-radius:50%;bottom:25px;left:50%;transform:translateX(-50%);background:var(--lime);box-shadow:0 0 15px var(--lime)}
.connector{position:absolute;left:50%;top:51%;width:205px;height:1px;transform-origin:0 50%;background:repeating-linear-gradient(90deg,var(--lime) 0 5px,transparent 5px 13px);opacity:.68;animation:dash 4s linear infinite}
.connector.c1{transform:rotate(-90deg)}.connector.c2{transform:rotate(-18deg)}.connector.c3{transform:rotate(54deg)}.connector.c4{transform:rotate(126deg)}.connector.c5{transform:rotate(198deg)}
.system-card{position:absolute;min-width:158px;padding:15px 16px;border-radius:18px;background:rgba(255,255,255,.92);border:1px solid rgba(32,33,36,.08);box-shadow:0 18px 42px rgba(32,33,36,.10);backdrop-filter:blur(10px);animation:float 5.2s ease-in-out infinite}
.system-card small{display:flex;align-items:center;gap:6px;color:#898e94;font-size:.53rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
.system-card small i{width:7px;height:7px;border-radius:50%}
.system-card strong{display:block;margin-top:8px;font-size:.77rem;letter-spacing:-.025em}
.system-card span{display:block;margin-top:4px;color:#8a9095;font-size:.59rem;line-height:1.42}
.sc-commerce{left:4%;top:15%;animation-delay:-.7s}.sc-commerce small i{background:var(--lime)}
.sc-systems{right:2%;top:20%;animation-delay:-1.7s}.sc-systems small i{background:var(--mint)}
.sc-automation{right:4%;bottom:12%;animation-delay:-2.5s}.sc-automation small i{background:var(--peach)}
.sc-software{left:8%;bottom:10%;animation-delay:-3.2s}.sc-software small i{background:var(--lavender)}
.sc-intelligence{left:39%;top:0;animation-delay:-1.2s}.sc-intelligence small i{background:var(--mint)}

/* WHO WE ARE */
.who{background:radial-gradient(ellipse at 50% 0%,rgba(229,244,255,.36) 0%,rgba(245,250,255,.18) 38%,rgba(255,255,255,0) 70%),#fff}
.who-layout{display:grid;grid-template-columns:.83fr 1.17fr;gap:72px;align-items:start}
.who-copy{position:sticky;top:130px}
.who-copy .title{font-size:clamp(2.8rem,4.25vw,4.35rem)}
.who-copy .copy p{margin:0 0 18px}.who-copy .copy p:last-child{margin-bottom:0}
.operation-map{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.op-card{min-height:168px;padding:24px;border-radius:28px;border:1px solid rgba(32,33,36,.08);position:relative;overflow:hidden;transition:.3s var(--ease)}
.op-card:hover{transform:translateY(-6px);box-shadow:0 18px 38px rgba(32,33,36,.07)}
.op-card:nth-child(1),.op-card:nth-child(5){background:linear-gradient(145deg,#F3FBD8,#F8FFE9)}
.op-card:nth-child(2),.op-card:nth-child(6){background:linear-gradient(145deg,#E9FBF8,#F3FFFD)}
.op-card:nth-child(3){background:linear-gradient(145deg,#FFF0E7,#FFF8F3)}
.op-card:nth-child(4){background:linear-gradient(145deg,#F1EFFD,#F9F8FF)}
.op-num{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:rgba(255,255,255,.68);font-size:.62rem;font-weight:800}
.op-card h3{margin:30px 0 8px;font-size:1.08rem;letter-spacing:-.035em}
.op-card p{margin:0;color:#666c72;font-size:.74rem;line-height:1.58}
.who-close{margin-top:34px;padding:26px 0 0;border-top:1px solid var(--line);font-size:clamp(1.35rem,2.3vw,2.25rem);line-height:1.22;letter-spacing:-.04em;font-weight:700}


.who-principles{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}
.who-principles span{padding:9px 12px;border-radius:999px;background:#fff;border:1px solid var(--line);color:#686d73;font-size:.66rem;font-weight:800}

/* Story */
.story{background:var(--gray)}
.story-head{max-width:860px}
.story-rail{margin-top:50px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.story-phase{min-height:250px;padding:27px;border-radius:32px;display:flex;flex-direction:column;justify-content:space-between;transition:.3s var(--ease)}
.story-phase:hover{transform:translateY(-5px)}
.story-phase:nth-child(1){background:var(--lime)}.story-phase:nth-child(2){background:var(--mint)}.story-phase:nth-child(3){background:var(--peach)}.story-phase:nth-child(4){background:var(--lavender)}
.story-no{font-size:.69rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
.story-phase h3{margin:0 0 10px;font-size:1.42rem;letter-spacing:-.04em}
.story-phase p{margin:0;color:rgba(32,33,36,.68);font-size:.8rem;line-height:1.55}
.story-close{margin-top:40px;padding:36px;border-radius:30px;background:var(--graphite);color:#fff}
.story-close small{display:block;color:rgba(255,255,255,.48);font-size:.64rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
.story-close strong{display:block;margin-top:13px;max-width:780px;font-size:clamp(1.8rem,3vw,3.1rem);line-height:1.08;letter-spacing:-.05em}

/* Ecosystem */
.ecosystem{background:#fff}
.eco-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;margin-top:46px}
.eco-card{min-height:232px;padding:28px;border-radius:32px;border:1px solid rgba(32,33,36,.08);position:relative;overflow:hidden;transition:.32s var(--ease)}
.eco-card:hover{transform:translateY(-7px);box-shadow:0 22px 48px rgba(32,33,36,.08)}
.eco-card:nth-child(1){grid-column:span 2;background:linear-gradient(145deg,#F3FBD8,#FBFFEF)}
.eco-card:nth-child(2){grid-column:span 2;background:linear-gradient(145deg,#E7FAF7,#F7FFFD)}
.eco-card:nth-child(3){grid-column:span 2;background:linear-gradient(145deg,#FFF0E7,#FFF9F5)}
.eco-card:nth-child(4){grid-column:span 3;background:linear-gradient(145deg,#F1EFFD,#FBFAFF)}
.eco-card:nth-child(5){grid-column:span 3;background:linear-gradient(145deg,#ECF6FF,#F9FCFF)}
.eco-icon{width:50px;height:50px;display:grid;place-items:center;border-radius:16px;background:rgba(255,255,255,.62);border:1px solid rgba(32,33,36,.05)}
.eco-icon svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}
.eco-card h3{margin:42px 0 9px;font-size:1.3rem;letter-spacing:-.04em}
.eco-card p{margin:0;max-width:470px;color:var(--muted);font-size:.79rem;line-height:1.62}
.eco-arrow{position:absolute;right:22px;bottom:22px;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.5);transition:.25s var(--ease)}
.eco-card:hover .eco-arrow{transform:translate(2px,-2px);background:var(--graphite);color:#fff}
.eco-close{margin:42px 0 0;max-width:860px;font-size:clamp(1.45rem,2.6vw,2.55rem);line-height:1.16;letter-spacing:-.045em;font-weight:700}

/* Industries */
.industries{
  padding:34px 0 104px;
  background:
    radial-gradient(circle at 12% 12%,rgba(194,255,2,.10),transparent 22%),
    radial-gradient(circle at 88% 18%,rgba(217,214,253,.18),transparent 25%),
    #fff;
}
.industry-shell{
  position:relative;
  overflow:hidden;
  padding:62px;
  border-radius:42px;
  background:
    radial-gradient(circle at 90% 6%,rgba(217,214,253,.22),transparent 24%),
    radial-gradient(circle at 8% 96%,rgba(153,254,237,.18),transparent 24%),
    linear-gradient(135deg,#ffffff 0%,#fbfcff 52%,#fbfffd 100%);
  border:1px solid rgba(32,33,36,.08);
  box-shadow:0 26px 70px rgba(32,33,36,.06);
}
.industry-intro{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:.95fr 1.05fr;
  gap:68px;
  align-items:end;
}
.industry-shell .eyebrow{color:#74777b}
.industry-shell .title{
  max-width:760px;
  font-size:clamp(2.8rem,4.35vw,4.6rem);
  line-height:.97;
  color:var(--graphite);
}
.industry-intro .copy{
  margin-top:0;
  max-width:600px;
  color:var(--muted);
  font-size:clamp(.98rem,1.06vw,1.08rem);
  line-height:1.72;
}
.industry-cards{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
  margin-top:42px;
}
.industry-card{
  position:relative;
  min-height:236px;
  padding:26px;
  border-radius:30px;
  border:1px solid rgba(32,33,36,.08);
  overflow:hidden;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  color:var(--graphite);
  background:#fff;
  box-shadow:0 14px 36px rgba(32,33,36,.045);
  transition:transform .3s var(--ease),box-shadow .3s var(--ease),border-color .3s ease;
}
.industry-card:hover{
  transform:translateY(-6px);
  box-shadow:0 24px 48px rgba(32,33,36,.08);
  border-color:rgba(32,33,36,.13);
}
.industry-card:before{
  content:"";
  position:absolute;
  right:-34px;
  top:-34px;
  width:126px;
  height:126px;
  border-radius:50%;
  opacity:.72;
}
.industry-card:nth-child(1){
  background:linear-gradient(145deg,#fff 0%,#f8ffe5 100%);
}
.industry-card:nth-child(1):before{background:rgba(194,255,2,.42)}
.industry-card:nth-child(2){
  background:linear-gradient(145deg,#fff 0%,#edfffb 100%);
}
.industry-card:nth-child(2):before{background:rgba(153,254,237,.44)}
.industry-card:nth-child(3){
  background:linear-gradient(145deg,#fff 0%,#fff2ea 100%);
}
.industry-card:nth-child(3):before{background:rgba(255,189,155,.42)}
.industry-card small{
  position:relative;
  z-index:2;
  display:inline-flex;
  align-items:center;
  gap:8px;
  width:max-content;
  padding:8px 11px;
  border-radius:999px;
  background:rgba(255,255,255,.72);
  border:1px solid rgba(32,33,36,.06);
  color:#777c82;
  font-size:.61rem;
  font-weight:800;
  letter-spacing:.09em;
  text-transform:uppercase;
}
.industry-card small:before{
  content:"";
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--lime);
}
.industry-card:nth-child(2) small:before{background:var(--mint)}
.industry-card:nth-child(3) small:before{background:var(--peach)}
.industry-card h3{
  position:relative;
  z-index:2;
  margin:0 0 10px;
  font-size:1.42rem;
  letter-spacing:-.045em;
}
.industry-card p{
  position:relative;
  z-index:2;
  margin:0;
  max-width:355px;
  color:var(--muted);
  font-size:.78rem;
  line-height:1.62;
}
.industry-close{
  position:relative;
  z-index:2;
  margin:30px 0 0;
  max-width:900px;
  color:#555b61;
  font-size:.96rem;
  line-height:1.7;
  font-weight:600;
}
@media(max-width:1120px){
  .industry-intro{grid-template-columns:1fr;gap:22px;align-items:start}
  .industry-cards{grid-template-columns:1fr 1fr}
  .industry-card:last-child{grid-column:1/-1}
}
@media(max-width:880px){
  .industry-shell{padding:46px 32px}
}
@media(max-width:660px){
  .industries{padding:24px 0 82px}
  .industry-shell{padding:36px 20px;border-radius:30px}
  .industry-cards{grid-template-columns:1fr}
  .industry-card:last-child{grid-column:auto}
  .industry-card{min-height:210px}
}

/* Metrics */
.metrics{background:var(--gray)}
.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:46px}
.metric{min-height:218px;padding:28px;border-radius:30px;background:#fff;border:1px solid rgba(32,33,36,.07);transition:.3s var(--ease)}
.metric:hover{transform:translateY(-5px);box-shadow:0 18px 38px rgba(32,33,36,.06)}
.metric:nth-child(1){background:linear-gradient(145deg,#fff,#F5FFDC)}.metric:nth-child(2){background:linear-gradient(145deg,#fff,#EAFFFB)}.metric:nth-child(3){background:linear-gradient(145deg,#fff,#FFF2EA)}.metric:nth-child(4){background:linear-gradient(145deg,#fff,#F4F1FF)}
.metric b{display:block;font-size:clamp(3rem,5vw,5.1rem);line-height:.9;letter-spacing:-.07em}.metric strong{display:block;margin-top:17px;font-size:.94rem;letter-spacing:-.03em}.metric p{margin:10px 0 0;color:var(--muted);font-size:.72rem;line-height:1.58}
.trust-panel{margin-top:20px;padding:26px;border-radius:28px;background:#fff;border:1px solid var(--line);display:grid;grid-template-columns:1.3fr repeat(3,1fr);gap:12px;align-items:stretch}
.trust-copy{padding:14px 12px}.trust-copy h3{margin:0;font-size:1.35rem;letter-spacing:-.04em}.trust-copy p{margin:9px 0 0;color:var(--muted);font-size:.76rem;line-height:1.52}
.trust-card{min-height:100px;padding:16px;border-radius:18px;background:var(--gray);display:flex;flex-direction:column;justify-content:center}.trust-card:nth-child(2){background:rgba(194,255,2,.18)}.trust-card:nth-child(3){background:rgba(153,254,237,.28)}.trust-card:nth-child(4){background:rgba(217,214,253,.34)}
.trust-card small{color:var(--muted);font-size:.54rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.trust-card strong{margin-top:7px;font-size:.82rem;line-height:1.35}

/* People */
.people{background:#fff}
.people-layout{display:grid;grid-template-columns:.85fr 1.15fr;gap:68px;align-items:center}
.people .title{font-size:clamp(2.8rem,4.25vw,4.35rem)}
.people-copy .copy p{margin:0 0 18px}.people-copy .copy p:last-child{margin-bottom:0}

/* Final CTA */
.final-cta{display:flex!important;justify-content:center!important;width:100%;padding:82px 24px 86px;background:#fff}
.final-cta>.page{width:100%!important;max-width:none!important;margin:0!important}
.cta-card{position:relative;overflow:hidden;display:grid;grid-template-columns:.93fr 1.07fr;gap:38px;align-items:center;width:min(1320px,100%)!important;margin-inline:auto!important;padding:60px 56px;border-radius:40px;background:linear-gradient(135deg,#fff 0%,#FCFBFF 46%,#F8FCFF 100%);border:1px solid rgba(32,33,36,.08);box-shadow:0 28px 72px rgba(32,33,36,.08)}
.cta-card:before{content:"";position:absolute;right:-120px;bottom:-190px;width:540px;height:540px;border-radius:50%;background:radial-gradient(circle,rgba(153,254,237,.22),rgba(217,214,253,.16) 45%,rgba(255,189,155,.10) 62%,transparent 74%);filter:blur(10px)}
.cta-copy{position:relative;z-index:2}.cta-marker{display:block;width:52px;height:5px;margin:10px 0 28px;border-radius:999px;background:var(--lime)}
.cta-copy h2{margin:0;max-width:650px;font-size:clamp(2.8rem,4.4vw,4.55rem);line-height:.97;letter-spacing:-.06em;font-weight:700}.cta-copy p{margin:22px 0 0;max-width:640px;color:var(--muted);font-size:1rem;line-height:1.72}
.cta-visual{position:relative;min-height:430px;border-radius:32px;background:radial-gradient(circle at 78% 18%,rgba(217,214,253,.26),transparent 22%),radial-gradient(circle at 20% 84%,rgba(153,254,237,.20),transparent 22%),linear-gradient(135deg,#F9FAFC,#F6F3FF 58%,#F4FAFF);border:1px solid rgba(32,33,36,.06);overflow:hidden}
.cta-visual:before,.cta-visual:after{content:"";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:50%;border:1px solid rgba(32,33,36,.10)}
.cta-visual:before{width:330px;height:330px}.cta-visual:after{width:220px;height:220px;border-style:dashed}
.cta-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(12deg);width:245px;padding:20px;border-radius:28px;background:#fff;border:1px solid rgba(32,33,36,.09);box-shadow:0 28px 58px rgba(61,68,84,.14);animation:ctaFloat 6s ease-in-out infinite;z-index:3}
.cta-core small{display:block;color:#777d84;font-size:.58rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.cta-core strong{display:block;margin-top:9px;font-size:1.25rem;letter-spacing:-.04em}.cta-core p{margin:8px 0 0;color:var(--muted);font-size:.74rem;line-height:1.5}
