<script is:inline>
(() => {
  const page = document.querySelector('.company-page');
  if (!page || page.dataset.referenceInitialized === 'true') return;
  page.dataset.referenceInitialized = 'true';

  const reveals = [...page.querySelectorAll('[data-reveal]')];
  if ('IntersectionObserver' in window) {
    const ob = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
        ob.unobserve(entry.target);
      }
    }), { threshold: .08, rootMargin: '70px 0px' });
    reveals.forEach(el => ob.observe(el));
  } else {
    reveals.forEach(el => el.classList.add('show'));
  }

  const journey = page.querySelector('#peopleProcess');
  if (!journey || journey.dataset.initialized === 'true') return;
  journey.dataset.initialized = 'true';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const steps = [...journey.querySelectorAll('.people-step')];
  const labels = ['Product Thinking', 'Design', 'Engineering', 'Quality Assurance', 'Automation', 'Ecommerce'];
  const status = page.querySelector('#peopleProcessStatus');
  const endBadge = page.querySelector('#peopleProcessEnd');
  const path = page.querySelector('#peopleProcessPath');
  const livePath = page.querySelector('#peopleLivePath');
  const runner = page.querySelector('#peopleRunner');
  const ring = page.querySelector('#peopleRunnerRing');

  if (!path || !livePath || !runner || !ring) return;

  if (reduced) {
    steps.forEach(s => s.classList.add('complete'));
    if (status) status.textContent = 'Complete process';
    endBadge?.classList.add('show');
    livePath.style.strokeDashoffset = '0';
    return;
  }

  const pathLength = path.getTotalLength();
  const stepProgress = [0, 0.19, 0.39, 0.60, 0.80, 1];
  const cycleDuration = 10500;
  const completionPause = 1400;
  let start = null;
  let raf = null;
  let pauseUntil = 0;

  function setStepState(progress) {
    let activeIndex = 0;
    for (let i = 0; i < stepProgress.length; i++) {
      if (progress >= stepProgress[i]) activeIndex = i;
    }
    steps.forEach((step, i) => {
      step.classList.toggle('active', i === activeIndex && progress < 0.995);
      step.classList.toggle('complete', i < activeIndex || (progress >= 0.995 && i <= activeIndex));
    });
    if (status) status.textContent = progress >= 0.995 ? 'Process complete' : labels[activeIndex];
    endBadge?.classList.toggle('show', progress >= 0.995);
  }

  function setVisualProgress(progress) {
    livePath.style.strokeDashoffset = String(1 - progress);
    const point = path.getPointAtLength(pathLength * progress);
    runner.setAttribute('cx', point.x);
    runner.setAttribute('cy', point.y);
    ring.setAttribute('cx', point.x);
    ring.setAttribute('cy', point.y);
    setStepState(progress);
  }

  function resetCycle(now) {
    steps.forEach(s => s.classList.remove('active', 'complete'));
    endBadge?.classList.remove('show');
    if (status) status.textContent = labels[0];
    setVisualProgress(0);
    start = now;
  }

  function animate(now) {
    if (pauseUntil && now < pauseUntil) {
      raf = requestAnimationFrame(animate);
      return;
    }
    if (pauseUntil && now >= pauseUntil) {
      pauseUntil = 0;
      resetCycle(now);
    }
    if (start === null) start = now;
    const elapsed = now - start;
    const progress = Math.min(elapsed / cycleDuration, 1);
    const eased = progress < 0.5 ? 2 * progress * progress : 1 - Math.pow(-2 * progress + 2, 2) / 2;
    setVisualProgress(eased);
    if (progress >= 1) {
      setVisualProgress(1);
      pauseUntil = now + completionPause;
    }
    raf = requestAnimationFrame(animate);
  }

  raf = requestAnimationFrame(animate);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden && raf) {
      cancelAnimationFrame(raf);
      raf = null;
    } else if (!document.hidden && !raf) {
      start = null;
      pauseUntil = 0;
      raf = requestAnimationFrame(animate);
    }
  });
})();
</script>

