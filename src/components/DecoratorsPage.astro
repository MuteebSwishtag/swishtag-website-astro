---
import decoratorsRawHtml from "../legacy/decorators-body.html?raw";
import decoratorsCssUrl from "../styles/pages/decorators.css?rawcss";

const decoratorsHtml = decoratorsRawHtml
  .replace("<!-- PAGE_CSS:decorators -->", `<link rel="stylesheet" href="${decoratorsCssUrl}">`);
---

<main class="decorators-page">
  <Fragment set:html={decoratorsHtml} />
</main>
