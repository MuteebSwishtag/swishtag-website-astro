---
import "../styles/contact.css";

const formSubmissionMode = (import.meta.env.PUBLIC_FORM_SUBMISSION_MODE ?? "direct").toLowerCase();
const directFormEndpoint = import.meta.env.PUBLIC_DIRECT_FORM_ENDPOINT ?? "/api/forms/submit";
const wordpressFormEndpoint = import.meta.env.PUBLIC_WORDPRESS_FORM_ENDPOINT ?? "https://cms.swishtag.com/wp-json/astro-form/v1/submit";
const formEndpoint = formSubmissionMode === "wordpress" ? wordpressFormEndpoint : directFormEndpoint;
const formToken = formSubmissionMode === "wordpress" ? (import.meta.env.PUBLIC_ASTRO_FORM_TOKEN ?? "") : "";

const paths = [
  {
    icon: "↗",
    title: "Launch a company store",
    text: "Need a branded Shopify store for a client, team, organization, or employee program?",
    action: "Talk about company stores",
  },
  {
    icon: "⌁",
    title: "Connect your systems",
    text: "Need Shopify, SAGE, accounting, suppliers, procurement, or other platforms to work together?",
    action: "Discuss an integration",
  },
  {
    icon: "⚡",
    title: "Automate your operation",
    text: "Too much order entry, status chasing, approval management, spreadsheet work, or repetitive administration?",
    action: "Show us the workflow",
  },
  {
    icon: "◇",
    title: "Build custom software",
    text: "Have an operational problem existing software cannot solve, or an idea for a new SaaS product or internal platform?",
    action: "Discuss your idea",
  },
  {
    icon: "+",
    title: "Explore a Swishtag platform",
    text: "Interested in Promo Plus, Xecutor, Rocket Apps, or another Swishtag product?",
    action: "Explore our platforms",
  },
  {
    icon: "✦",
    title: "Something different?",
    text: "Partnerships, technology conversations, general questions, or an idea that does not fit neatly into a category are welcome too.",
    action: "Start a conversation",
  },
];

const steps = [
  ["01", "Tell us what is happening", "Share the current workflow, challenge, idea, or opportunity."],
  ["02", "We review the context", "Our team looks at the problem, the systems involved, and what a successful outcome should look like."],
  ["03", "We identify the right next step", "That might be an existing solution, a platform, an integration, custom development, or a focused discovery conversation."],
  ["04", "We move forward with clarity", "If there is a strong fit, we will define the practical next step before unnecessary development begins."],
];

const stats = [
  ["350+", "eCommerce projects"],
  ["100+", "Custom Shopify apps"],
  ["150+", "Stores managed through one connected platform"],
  ["$40M+", "Orders powered through delivered technology"],
];
---

<main class="contact-page">
  <section class="contact-hero">
    <div class="contact-wrap contact-hero__grid">
      <div class="contact-hero__copy" data-contact-reveal>
        <p class="contact-eyebrow">Contact Swishtag</p>
        <h1>Let us talk about what you are trying to build, connect, or <span>improve.</span></h1>
        <p>
          Whether you are launching a company store, connecting systems, automating a workflow,
          building custom software, or exploring one of our platforms, start by telling us what is
          happening today and where you want to go next.
        </p>
        <strong>You do not need a technical specification. Just bring us the problem.</strong>
        <div class="contact-actions">
          <a class="contact-btn contact-btn--primary" href="#contact-form">Start the conversation</a>
          <a class="contact-btn contact-btn--secondary" href="/book-demo/">Book a demo</a>
        </div>
      </div>

      <form
        class="contact-form"
        id="contact-form"
        action={formEndpoint}
        method="post"
        data-form-token={formToken}
        data-contact-form
        novalidate
        data-contact-reveal
      >
        <input type="hidden" name="form_source" value="contact" />
        <input type="hidden" name="fullName" data-contact-full-name />
        <input type="hidden" name="form_loaded_at" data-contact-loaded-at />
        <div class="contact-field contact-field--trap" aria-hidden="true">
          <label for="contact-nickname">Nickname</label>
          <input id="contact-nickname" name="nickname" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="contact-form__head">
          <h2>Tell us a little about what you are working on.</h2>
          <p>Share as much context as you have. We will help figure out the technical part.</p>
        </div>

        <div class="contact-form__grid">
          <div class="contact-field">
            <label for="contact-first-name">First name*</label>
            <input id="contact-first-name" name="firstName" data-contact-first-name required autocomplete="given-name" placeholder="Your first name" />
          </div>
          <div class="contact-field">
            <label for="contact-last-name">Last name*</label>
            <input id="contact-last-name" name="lastName" data-contact-last-name required autocomplete="family-name" placeholder="Your last name" />
          </div>
          <div class="contact-field">
            <label for="contact-work-email">Work email*</label>
            <input id="contact-work-email" name="workEmail" data-contact-work-email required type="email" autocomplete="email" placeholder="you@company.com" />
          </div>
          <div class="contact-field">
            <label for="contact-company">Company name*</label>
            <input id="contact-company" name="companyName" data-contact-company required autocomplete="organization" placeholder="Your company" />
          </div>
          <div class="contact-field contact-field--full">
            <label for="contact-role">I am a...*</label>
            <select id="contact-role" name="role" data-contact-role required>
              <option value="">Select your role</option>
              <option>Promotional Products Distributor</option>
              <option>Promotional Products Supplier</option>
              <option>Promotional Products Decorator</option>
              <option>Brand / Enterprise Buyer</option>
              <option>Technology Partner</option>
              <option>Other</option>
            </select>
          </div>
          <div class="contact-field contact-field--full">
            <label for="contact-topic">What would you like to discuss?*</label>
            <select id="contact-topic" name="topic" data-contact-topic required>
              <option value="">Choose a topic</option>
              <option>Shopify Company Store</option>
              <option>SAGE + Shopify</option>
              <option>Enterprise Company Store Automation</option>
              <option>PunchOut</option>
              <option>Custom Software & Automation</option>
              <option>System Integration</option>
              <option>Promo Plus</option>
              <option>Xecutor</option>
              <option>Rocket Apps</option>
              <option>Partnership Opportunity</option>
              <option>General Inquiry</option>
              <option>Something Else</option>
            </select>
          </div>
          <div class="contact-field contact-field--full">
            <label for="contact-message">Tell us what you are trying to solve.*</label>
            <textarea id="contact-message" name="message" data-contact-message required placeholder="What does your current process look like? What is slowing your team down? What would a better outcome look like?"></textarea>
            <p>You can mention systems like Shopify, SAGE, commonsku, QuickBooks, NetSuite, PromoStandards, Coupa, SAP Ariba, or something custom.</p>
          </div>
        </div>

        <button class="contact-btn contact-btn--dark" type="submit" data-contact-submit>Send my inquiry</button>
        <p class="contact-form__status" data-contact-status role="status" aria-live="polite"></p>
        <p class="contact-form__note"><i></i>No technical brief required. We will start with the business problem and take it from there.</p>
      </form>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-wrap">
      <div class="contact-section__head" data-contact-reveal>
        <div>
          <p class="contact-eyebrow">How can we help?</p>
          <h2>Start with the problem. We will help find the right path.</h2>
        </div>
        <p>You do not need to know which Swishtag solution you need before contacting us. Tell us what you are trying to accomplish, and we will help determine the most practical starting point.</p>
      </div>
      <div class="contact-paths">
        {paths.map((path) => (
          <article class="contact-path-card" data-contact-reveal>
            <div class="contact-path-card__icon" aria-hidden="true">{path.icon}</div>
            <h3>{path.title}</h3>
            <p>{path.text}</p>
            <a href="#contact-form">{path.action}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-section contact-section--warm">
    <div class="contact-wrap contact-next">
      <div class="contact-next__copy" data-contact-reveal>
        <p class="contact-eyebrow">After you reach out</p>
        <h2>A conversation before a recommendation.</h2>
        <p>We do not want to push you toward software before we understand how your business actually works.</p>
        <div class="contact-principle">
          The goal is not to sell you the biggest project. It is to find the <strong>smallest practical path that creates meaningful progress.</strong>
        </div>
      </div>
      <div class="contact-process">
        {steps.map(([number, title, text]) => (
          <article class="contact-step" data-contact-reveal>
            <div>{number}</div>
            <section>
              <h3>{title}</h3>
              <p>{text}</p>
            </section>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-section contact-industry">
    <div class="contact-wrap">
      <div class="contact-industry__shell" data-contact-reveal>
        <div class="contact-industry__content">
          <div>
            <p class="contact-eyebrow">Built inside the industry</p>
            <h2>Talk to a team that understands more than the storefront.</h2>
            <p>Promotional commerce gets complicated quickly. Orders, artwork, supplier data, purchase orders, accounting, procurement, and fulfillment all have to stay connected without creating another pile of manual work.</p>
            <p>Swishtag combines ecommerce, software, integrations, and automation to help promotional products businesses create clearer customer experiences and more scalable operations.</p>
            <div class="contact-trust">
              <span>Official Shopify Partner</span>
              <span>PPAI Member</span>
            </div>
            <small>Built for promotional products distributors, suppliers, and decorators.</small>
          </div>
          <div class="contact-stats">
            {stats.map(([value, label]) => (
              <div>
                <b>{value}</b>
                <span>{label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section contact-direct">
    <div class="contact-wrap contact-direct__grid">
      <div data-contact-reveal>
        <p class="contact-eyebrow">Prefer another way?</p>
        <h2>Let us stay connected.</h2>
        <p>Have a project question, partnership idea, or something you would rather discuss directly?</p>
        <div class="contact-socials">
          <a href="https://www.linkedin.com/company/helloswishtag/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://www.facebook.com/share/1F6RDHGUqG/" target="_blank" rel="noopener noreferrer">Facebook</a>
          <a href="mailto:hello@swishtag.com">Email</a>
        </div>
      </div>
      <div class="contact-cards">
        <article data-contact-reveal>
          <div aria-hidden="true">@</div>
          <section>
            <h3>Email us</h3>
            <p>For project inquiries, general questions, partnerships, and business conversations.</p>
          </section>
          <a href="mailto:hello@swishtag.com">hello@swishtag.com</a>
        </article>
        <article data-contact-reveal>
          <div aria-hidden="true">↗</div>
          <section>
            <h3>Prefer a live conversation?</h3>
            <p>Walk through your requirements directly with our team.</p>
          </section>
          <a href="/book-demo/">Book a demo</a>
        </article>
        <article data-contact-reveal>
          <div aria-hidden="true">✦</div>
          <section>
            <h3>Follow Swishtag</h3>
            <p>See what we are building, learning, and exploring across promotional commerce technology.</p>
          </section>
          <a href="https://www.linkedin.com/company/helloswishtag/" target="_blank" rel="noopener noreferrer">Follow us</a>
        </article>
      </div>
    </div>
  </section>

  <section class="contact-close">
    <div class="contact-wrap">
      <div class="contact-close__shell" data-contact-reveal>
        <p class="contact-eyebrow">Swishtag</p>
        <h2>Commerce without chaos.</h2>
        <p>Software, connected systems, and automation built around the way promotional products businesses actually work.</p>
        <div class="contact-actions">
          <a class="contact-btn contact-btn--primary" href="#contact-form">Start the conversation</a>
          <a class="contact-btn contact-btn--secondary" href="/solutions/">Explore Swishtag solutions</a>
        </div>
      </div>
    </div>
  </section>
</main>

<script is:inline>
(() => {
  const revealItems = document.querySelectorAll('[data-contact-reveal]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('is-visible');
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }

  const form = document.querySelector('[data-contact-form]');
  if (!form) return;

  const fields = {
    firstName: form.querySelector('[data-contact-first-name]'),
    lastName: form.querySelector('[data-contact-last-name]'),
    workEmail: form.querySelector('[data-contact-work-email]'),
    company: form.querySelector('[data-contact-company]'),
    role: form.querySelector('[data-contact-role]'),
    topic: form.querySelector('[data-contact-topic]'),
    message: form.querySelector('[data-contact-message]'),
    fullName: form.querySelector('[data-contact-full-name]'),
    loadedAt: form.querySelector('[data-contact-loaded-at]'),
    status: form.querySelector('[data-contact-status]'),
    submit: form.querySelector('[data-contact-submit]'),
  };

  fields.loadedAt.value = Date.now().toString();

  function setStatus(message, type = '') {
    fields.status.textContent = message;
    fields.status.dataset.state = type;
  }

  function hydrateHiddenFields() {
    const fullName = `${fields.firstName.value.trim()} ${fields.lastName.value.trim()}`.trim();
    fields.fullName.value = fullName;
  }

  async function postForm(payload) {
    const headers = {
      Accept: 'application/json',
      'Content-Type': 'application/json',
    };
    const token = form.dataset.formToken || '';
    if (token) headers['X-Astro-Form-Token'] = token;

    const response = await fetch(form.action, {
      method: 'POST',
      headers,
      body: JSON.stringify(payload),
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) {
      throw new Error(result.message || 'We could not send your request right now.');
    }
    return result;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    hydrateHiddenFields();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (form.nickname?.value.trim()) return;

    const payload = Object.fromEntries(new FormData(form).entries());
    payload.page = window.location.href;

    try {
      fields.submit.disabled = true;
      fields.submit.textContent = 'Sending...';
      setStatus('', '');
      await postForm(payload);
      form.reset();
      fields.loadedAt.value = Date.now().toString();
      setStatus('Thanks. Your inquiry has been sent to Swishtag.', 'success');
      fields.submit.textContent = 'Send my inquiry';
    } catch (error) {
      setStatus(error.message || 'We could not send your request right now. Please email hello@swishtag.com directly.', 'error');
      fields.submit.textContent = 'Send my inquiry';
    } finally {
      fields.submit.disabled = false;
    }
  });
})();
</script>
