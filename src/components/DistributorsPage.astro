---
import distributorsRawHtml from "../legacy/distributors-body.html?raw";
import distributorsCssUrl from "../styles/pages/distributors.css?rawcss";
import SharedFaq from './layout/SharedFaq.astro';
import faqs from '../data/faqs.json';

const distributorsHtml = distributorsRawHtml
  .replace("<!-- PAGE_CSS:distributors -->", `<link rel="stylesheet" href="${distributorsCssUrl}">`);

const [beforeFaq, afterFaq] = distributorsHtml.split('<!-- SHARED_FAQ -->');
---

<main class="distributors-page">
  <Fragment set:html={beforeFaq} />
  <SharedFaq {...faqs.distributors} />
  <Fragment set:html={afterFaq} />
</main>
