---
import suppliersRawHtml from "../legacy/suppliers-body.html?raw";
import suppliersCssUrl from "../styles/pages/suppliers.css?rawcss";

const suppliersHtml = suppliersRawHtml
  .replace("<!-- PAGE_CSS:suppliers -->", `<link rel="stylesheet" href="${suppliersCssUrl}">`);
---

<main class="suppliers-page">
  <Fragment set:html={suppliersHtml} />
</main>
