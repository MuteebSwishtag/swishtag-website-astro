---
const flagStars = Array.from({ length: 9 }, (_, row) =>
  Array.from({ length: row % 2 === 0 ? 6 : 5 }, (_, column) => ({
    x: (row % 2 === 0 ? 6.33 : 12.67) + column * 12.67,
    y: 5.38 + row * 5.38,
  })),
).flat();
