    {Array.from({ length: 7 }, (_, stripe) => (
      <rect x="0" y={stripe * 200 / 13} width="190" height={100 / 13} fill="#b22234" />
    ))}
    <rect width="76" height={700 / 13} fill="#3c3b6e" />
