<style is:global>
  .footer-us-based { display: inline-flex; align-items: center; gap: 4px; }
  .footer-us-flag { display: inline-block; width: 20px; height: auto; flex: none; }

  /* The brand and all six link columns share a row on wide screens. */
  .site-footer .footer-grid {
    display: grid;
    grid-template-columns: minmax(220px, 1.35fr) repeat(6, minmax(0, 1fr));
    gap: clamp(18px, 1.8vw, 34px);
    align-items: start;
  }

  .site-footer .footer-grid > * { min-width: 0; }
  .site-footer .footer-brand { grid-column: auto; }

  .site-footer .footer-contact {
    display: grid;
    gap: 10px;
    margin-top: 24px;
    color: var(--muted, #696a6d);
    font-size: .8rem;
    font-style: normal;
    line-height: 1.6;
  }

  .site-footer .footer-contact a {
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }

  .site-footer .footer-contact a:hover { color: var(--graphite, #202124); }

  @media (max-width: 1279px) {
    .site-footer .footer-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .site-footer .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 700px) {
    .site-footer .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 24px; }
  }

  @media (max-width: 420px) {
    .site-footer .footer-grid { grid-template-columns: 1fr; }
    .site-footer .footer-brand { grid-column: auto; }
  }
</style>
