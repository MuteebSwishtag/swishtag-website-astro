<div aria-hidden="true" class="mega-visual__art">
<svg viewBox="0 0 360 220">
<rect class="mega-svg-window" height="156" rx="18" width="246" x="28" y="28"></rect>
<circle class="mega-svg-dot mega-svg-dot--peach" cx="48" cy="48" r="5"></circle>
