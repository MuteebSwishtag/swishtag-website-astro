---
const solutionCtas: Record<string, { label: string; href: string }> = {
  '/solutions/shopify-company-store/': {
    label: 'Launch a Company Store',
    href: '/book-demo/?service=company-store-launch&intent=launch',
  },
  '/solutions/shopify-sage-connect-integration/': {
    label: 'Check My SAGE Integration Fit',
    href: '/book-demo/?service=sage-connected-company-store&intent=integration-fit',
  },
  '/solutions/enterprise-shopify-automation/': {
    label: 'Automate My Company',
    href: '/book-demo/?service=enterprise-company-store-automation&intent=automation',
  },
};

const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const headerCta = solutionCtas[normalizedPath] ?? {
  label: 'Book a Demo',
  href: '/book-demo/',
};
---

<header class="site-header" id="siteHeader" data-nav-native="1">
<nav aria-label="Primary navigation" class="nav modern-nav" id="mainNav">
<a aria-label="Swishtag home" class="brand modern-nav__brand" href="/">
<span aria-hidden="true" class="modern-nav__brand-mark"></span>
</a>
<div aria-label="Desktop navigation" class="desktop-nav">
<a class="desktop-nav__direct" href="/">Home</a>
<div class="desktop-nav__item" data-mega-item="">
<a aria-controls="megaSolutions" aria-expanded="false" class="desktop-nav__trigger" href="/solutions/">
<span>Solutions</span>
<svg aria-hidden="true" viewBox="0 0 16 16"><path d="m4 6 4 4 4-4"></path></svg>
</a>
<section aria-label="Swishtag solutions menu" class="mega-menu mega-menu--solutions" id="megaSolutions">
<div class="mega-menu__intro">
<span class="mega-menu__eyebrow">Commerce, software &amp; automation</span>
<h2 class="mega-menu__stacked-title">
<span>Launch it</span>
<span>Connect it.</span>
<span>Scale it.</span>
<span>Build it.</span>
</h2>
<p>
            Choose a proven solution or build custom software, integrations, SaaS,
            and automation around the way your business works.
          </p>
<a class="mega-menu__all-link" href="/solutions/">
<span>Explore solutions</span>
<span aria-hidden="true">↗</span>
</a>
</div>
<div class="mega-menu__content mega-menu__content--three-solutions">
<div class="mega-menu__primary-links mega-menu__primary-links--three">
<a class="mega-link" href="/solutions/shopify-company-store/">
