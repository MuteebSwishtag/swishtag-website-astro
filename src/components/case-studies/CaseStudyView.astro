---
import type { CaseProject, ExploreCard } from '../../data/case-studies.types';

interface Props {
  project: CaseProject;
  index: number;
  total: number;
  related: CaseProject[];
}

const { project, index, total, related } = Astro.props;
const hiddenValues = new Set(['Not specified', 'To be confirmed', 'Uncategorized']);
const text = (value?: string) => {
  const cleaned = value?.trim() ?? '';
  return cleaned && !hiddenValues.has(cleaned) ? cleaned : '';
};
const pad = (value: number) => String(value).padStart(2, '0');
const indexLabel = `${pad(index + 1)} / ${total}`;
const pageHref = (href: string) => {
  const hash = href.match(/#([a-z0-9-]+)\/?$/);
  return hash ? `/case-studies/${hash[1]}/` : href;
};

const detail = project.detail;
const story = project.panel;
const category = text(story?.category) || text(project.category);
const industry = text(story?.industry) || text(project.industry);
const platform = text(story?.platform) || text(project.platform);

const eyebrow = detail?.eyebrow || (category ? `Swishtag / ${category}` : 'Swishtag');
const subtitle = text(detail?.subtitle || story?.title);
const intro = text(detail?.intro || story?.intro);
const chips = detail?.chips?.length
  ? detail.chips
  : [...new Set([category, industry, platform].filter(Boolean))];
const heroImage = detail?.heroImage || project.image;
const heroAlt = detail?.heroAlt || `${project.name} project preview`;
const logo = text(story?.logo);
const facts = (detail?.facts?.length
  ? detail.facts
  : [
      ['Project', project.name] as [string, string],
      industry ? ['Industry', industry] as [string, string] : undefined,
      platform ? ['Platform', platform] as [string, string] : undefined,
      category ? ['Category', category] as [string, string] : undefined,
    ].filter((fact): fact is [string, string] => Boolean(fact))
).filter(([label]) => label.toLowerCase() !== 'service');
const opportunityTitle = text(detail?.opportunityTitle || story?.opportunityTitle);
const opportunity = text(detail?.opportunity || story?.opportunity);
const capabilities = detail?.capabilities?.length
  ? detail.capabilities
  : (story?.features ?? [])
      .filter(([title, body]) => text(title) || text(body))
      .map(([title, body], featureIndex): [string, string, string] => [
        `${pad(featureIndex + 1)} / Core capability`,
        title,
        body,
      ]);
const notice = text(detail?.notice || story?.status);
const gallery = detail ? [] : project.gallery.filter(Boolean);
const visitUrl = detail ? '' : text(story?.url);
const cosmifyIcons = ['◈', '♧', '↗', '⬡'];
const heroArtClass = detail
  ? project.slug === 'formeteca-monster-email-template'
    ? 'cs-study-art cs-study-art--formeteca'
    : 'cs-study-art cs-study-art--cosmify'
  : `cs-study-art cs-study-art--dynamic${project.name === 'Artbeat Studios' ? ' cs-study-art--contain' : ''}`;
const sections = detail
  ? detail.sections
  : [
      text(story?.experienceTitle) || text(story?.experience)
        ? {
            kicker: 'The product experience',
            title: text(story?.experienceTitle),
            body: text(story?.experience),
            visit: true,
          }
        : undefined,
      text(story?.takeaway) || text(story?.subtitle)
        ? {
            kicker: 'The takeaway',
            title: text(story?.takeaway),
            body: text(story?.subtitle),
          }
        : undefined,
    ].filter((section): section is { kicker: string; title: string; body: string; visit?: boolean } => Boolean(section));
const explore: ExploreCard[] = detail
  ? detail.explore.map((item) => ({ ...item, href: pageHref(item.href) }))
  : related.map((item) => ({
      name: item.name,
      href: `/case-studies/${item.slug}/`,
      image: item.image,
      category: item.category,
    }));

const numbered: string[] = [];
const kickerFor = (label: string) => {
  numbered.push(`${pad(numbered.length + 1)} / ${label}`);
  return numbered[numbered.length - 1];
};
const projectKicker = kickerFor('The project');
const opportunityKicker = opportunityTitle || opportunity ? kickerFor('The opportunity') : '';
const capabilityKicker = capabilities.length ? kickerFor('Core capabilities') : '';
const galleryKicker = gallery.length ? kickerFor('The actual experience') : '';
const displaySections = detail
  ? sections
  : sections.map((section) => ({ ...section, kicker: kickerFor(section.kicker) }));
---

<article class="cs-study" data-project={project.name}>
  <header class="cs-study-hero">
    <div class="cs-shell">
      <div class="cs-back-row">
        <a class="cs-text-btn cs-back" href="/case-studies/">← Back to projects</a>
        <span class="cs-kicker">{indexLabel} · Selected work</span>
      </div>
      <div class="cs-study-layout">
        <div>
          {eyebrow && <span class="cs-kicker">{eyebrow}</span>}
          <p class="cs-kicker cs-section-label">{projectKicker}</p>
          {logo && <img class="cs-study-logo" src={logo} alt="" />}
          <h1>{project.name}<span>.</span></h1>
          {subtitle && <h2>{subtitle}</h2>}
          {intro && <p class="cs-copy">{intro}</p>}
          {chips.length > 0 && (
            <div class:list={['cs-chips', detail ? (project.slug === 'cosmify' ? 'cs-chips--cosmify' : 'cs-chips--detail') : 'cs-chips--dynamic']}>
              {chips.map((chip, chipIndex) => (
                <span>
                  {project.slug === 'cosmify' && cosmifyIcons[chipIndex] && <i>{cosmifyIcons[chipIndex]}</i>}
                  {chip}
                </span>
              ))}
            </div>
          )}
          {visitUrl && !sections.some((section) => section.visit) && (
            <p><a class="cs-source" href={visitUrl} target="_blank" rel="noopener noreferrer">Visit project reference ↗</a></p>
          )}
        </div>
        {heroImage && (
          <div class={heroArtClass}>
            <img src={heroImage} alt={heroAlt} />
          </div>
        )}
      </div>
      {facts.length > 0 && (
        <div class:list={['cs-facts', detail ? 'cs-facts--meta' : 'cs-facts--dynamic']} data-count={facts.length}>
          {facts.map(([label, value]) => (
            <div><span>{label}</span><strong>{value}</strong></div>
          ))}
        </div>
      )}
    </div>
  </header>

  {(opportunityTitle || opportunity) && (
    <section class="cs-block">
      <div class="cs-shell cs-split">
        <div>
          <span class="cs-kicker">{opportunityKicker}</span>
          {opportunityTitle && <h2>{opportunityTitle}</h2>}
        </div>
        {opportunity && <p class="cs-copy">{opportunity}</p>}
      </div>
    </section>
  )}

  {capabilities.length > 0 && (
    <section class="cs-block">
      <div class="cs-shell">
        <span class="cs-kicker">{capabilityKicker}</span>
        <div class="cs-features">
          {capabilities.map(([label, title, body]) => (
            <article class="cs-feature">
              {label && <small>{label}</small>}
              {title && <h3>{title}</h3>}
              {body && <p>{body}</p>}
            </article>
          ))}
        </div>
        {detail && notice && <p class="cs-notice">{notice}</p>}
      </div>
    </section>
  )}

  {gallery.length > 0 && (
    <section class="cs-block">
      <div class="cs-shell">
        <span class="cs-kicker">{galleryKicker}</span>
        <h2>Explore the interface.</h2>
        <div class="cs-shots">
          {gallery.map((src, shot) => (
            <figure class="cs-shot">
              <img src={src} alt={`${project.name} project screenshot ${shot + 2}`} />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {displaySections.map((section) => (
    <section class="cs-block">
      <div class="cs-shell cs-split">
        <div>
          {section.kicker && <span class="cs-kicker">{section.kicker}</span>}
          {section.title && <h2>{section.title}</h2>}
          {section.body && <p class="cs-copy">{section.body}</p>}
          {section.visit && visitUrl && (
            <p><a class="cs-source" href={visitUrl} target="_blank" rel="noopener noreferrer">Visit project reference ↗</a></p>
          )}
        </div>
        {section.image && (
          <div class="cs-study-art">
            <img src={section.image} alt={section.alt ?? ''} />
          </div>
        )}
      </div>
    </section>
  ))}

  {!detail && notice && (
    <section class="cs-block">
      <div class="cs-shell">
        <p class="cs-notice">{notice}</p>
      </div>
    </section>
  )}

  <section class="cs-block">
    <div class="cs-shell cs-closing">
      <div>
        <span class="cs-kicker">Have a similar idea?</span>
        <h2>Build something unmistakably yours.</h2>
        <p>Explore product design and development with Swishtag.</p>
      </div>
      <a class="cs-lime" href="https://swishtag.com/" target="_blank" rel="noopener noreferrer">Visit Swishtag</a>
    </div>
  </section>

  {explore.length > 0 && (
    <section class="cs-block" aria-label="More work">
      <div class="cs-shell">
        <div class="cs-explore-head">
          <div>
            <span class="cs-kicker">Continue exploring</span>
            <h2>More work worth discovering.</h2>
          </div>
          <a class="cs-text-btn cs-all-projects" href="/case-studies/">All projects</a>
        </div>
        <div class="cs-related cs-explore-grid">
          {explore.map((item) => (
            <a class="cs-explore-card" href={item.href}>
              <span class="cs-explore-image"><img src={item.image} alt={`${item.name} project preview`} /></span>
              <span class="cs-explore-type">{item.category}</span>
              <strong>{item.name}</strong>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</article>
