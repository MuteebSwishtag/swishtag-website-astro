---
import rocketAppsRawHtml from "../legacy/rocket-apps-body.html?raw";
import rocketAppsCssUrl from "../styles/pages/rocket-apps.css?rawcss";
import SharedFaq from './layout/SharedFaq.astro';
import faqs from '../data/faqs.json';

const rocketAppsHtml = rocketAppsRawHtml
  .replace("<!-- PAGE_CSS:rocket-apps -->", `<link rel="stylesheet" href="${rocketAppsCssUrl}">`);

const [beforeFaq, afterFaq] = rocketAppsHtml.split('<!-- SHARED_FAQ -->');
---

<main class="rocket-apps-page">
  <Fragment set:html={beforeFaq} />
  <SharedFaq {...faqs.rocketApps} />
  <Fragment set:html={afterFaq} />
</main>
