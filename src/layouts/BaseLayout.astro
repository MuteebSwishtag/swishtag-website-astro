        <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" sizes="180x180" />
    <script is:inline src="/assets/url-redirects.js?v=20260904-project-routes"></script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <script defer src="/assets/site-shell.js"></script>
    <slot name="head" />
    <style is:global>
      @media (min-width: 901px) {
        .page-nav-wrap {
          top: 70px !important;
          pointer-events: none;
        }

        .page-nav-wrap > .page-shell,
        .page-nav-wrap .page-shell {
          width: min(var(--page), 1240px) !important;
          max-width: none !important;
        }

        .page-nav-shell {
          pointer-events: auto;
        }

        .site-header.is-nav-connected .modern-nav {
          border-radius: 24px 24px 0 0 !important;
          border-color: rgba(32, 33, 36, 0.08) !important;
          border-bottom-color: transparent !important;
          background: rgba(255, 255, 255, 0.97) !important;
          box-shadow: none !important;
        }

        .page-nav-wrap.is-stuck {
          padding-top: 0 !important;
          filter: drop-shadow(0 22px 42px rgba(32, 33, 36, 0.11));
        }

        .page-nav-wrap.is-stuck .page-nav-shell {
          margin-top: -1px !important;
          border-top-color: transparent !important;
          border-radius: 0 0 24px 24px !important;
          background: rgba(255, 255, 255, 0.97) !important;
          box-shadow: none !important;
        }
      }

      @media (min-width: 681px) and (max-width: 900px) {
        .page-nav-wrap {
          top: 68px !important;
        }
      }

      @media (max-width: 680px) {
        .page-nav-wrap {
          top: 64px !important;
        }
      }

      @media (min-width: 821px) {
        .site-header .desktop-nav__item {
          position: static !important;
        }

        .site-header .mega-menu {
          position: fixed !important;
          z-index: 1000 !important;
          top: 92px !important;
          left: 50% !important;
          width: min(1160px, calc(100vw - 42px)) !important;
          display: grid !important;
          grid-template-columns: minmax(230px, 0.78fr) minmax(
              380px,
              1.25fr
            ) minmax(280px, 0.92fr) !important;
          gap: 18px !important;
          padding: 18px !important;
          border: 1px solid rgba(32, 33, 36, 0.075) !important;
          border-radius: 30px !important;
          background:
            radial-gradient(
              circle at 82% 8%,
              rgba(153, 254, 237, 0.2),
              transparent 28%
            ),
            radial-gradient(
              circle at 14% 100%,
              rgba(217, 214, 253, 0.24),
              transparent 30%
            ),
            rgba(255, 255, 255, 0.97) !important;
          box-shadow:
            0 30px 90px rgba(32, 33, 36, 0.16),
            inset 0 1px 0 rgba(255, 255, 255, 0.96) !important;
          -webkit-backdrop-filter: blur(22px) !important;
          backdrop-filter: blur(22px) !important;
          opacity: 0 !important;
          visibility: hidden !important;
          pointer-events: none !important;
          transform: translate(-50%, 12px) scale(0.985) !important;
          transform-origin: top center !important;
        }

        .site-header.is-scrolled .mega-menu {
          top: 78px !important;
        }

        .site-header .desktop-nav__item:hover > .mega-menu,
        .site-header .desktop-nav__item:focus-within > .mega-menu,
        .site-header .desktop-nav__item.is-open > .mega-menu {
          opacity: 1 !important;
          visibility: visible !important;
          pointer-events: auto !important;
          transform: translate(-50%, 0) scale(1) !important;
        }

        .site-header .mega-menu > .mega-menu__intro,
        .site-header .mega-menu > .mega-menu__content,
        .site-header .mega-menu > .mega-products,
        .site-header .mega-menu > .mega-industries,
        .site-header .mega-menu > .mega-visual {
          min-height: auto !important;
          border-radius: 22px !important;
        }

        .site-header .mega-menu__intro {
          position: relative !important;
          display: flex !important;
          flex-direction: column !important;
          overflow: hidden !important;
          padding: 25px 23px !important;
          color: #202124 !important;
          background:
            radial-gradient(
              circle at 88% 12%,
              rgba(194, 255, 2, 0.18),
              transparent 28%
            ),
            linear-gradient(
              145deg,
              rgba(248, 248, 245, 0.98),
              rgba(255, 255, 255, 0.98)
            ) !important;
          border: 1px solid rgba(32, 33, 36, 0.065) !important;
          box-shadow: none !important;
        }

        .site-header .mega-menu__intro::after {
          content: "" !important;
          position: absolute !important;
          right: -60px !important;
          bottom: -58px !important;
          width: 160px !important;
          height: 160px !important;
          border: 1px dashed rgba(32, 33, 36, 0.12) !important;
          border-radius: 50% !important;
          pointer-events: none !important;
        }

        .site-header .mega-menu__eyebrow {
          display: block !important;
          margin: 0 0 18px !important;
          color: #696a6d !important;
          font-size: 0.62rem !important;
          font-weight: 800 !important;
          letter-spacing: 0.13em !important;
          text-transform: uppercase !important;
        }

        .site-header .mega-menu__intro h2,
        .site-header .mega-menu__intro .mega-menu__title {
          margin: 0 !important;
          color: #202124 !important;
          font-size: 1.55rem;
          line-height: 1.02 !important;
          letter-spacing: -0.05em !important;
          font-weight: 800 !important;
        }

        .site-header .mega-menu__intro p {
          margin: 17px 0 0 !important;
          color: #696a6d !important;
          font-size: 0.78rem !important;
          line-height: 1.58 !important;
        }

        .site-header .mega-menu__all-link {
          display: inline-flex !important;
          align-items: center !important;
          justify-content: space-between !important;
          gap: 18px !important;
          margin-top: auto !important;
          padding-top: 25px !important;
          border-top: 0 !important;
          color: #202124 !important;
          font-size: 0.72rem !important;
          font-weight: 760 !important;
        }

        .site-header .mega-menu__all-link span:last-child {
          width: 30px !important;
          height: 30px !important;
          display: grid !important;
          place-items: center !important;
          border-radius: 50% !important;
          background: #c2ff02 !important;
        }

        .site-header .mega-menu__content,
        .site-header .mega-products,
        .site-header .mega-industries {
          background: rgba(250, 250, 248, 0.92) !important;
          border: 1px solid rgba(32, 33, 36, 0.055) !important;
        }

        .site-header .mega-menu__content {
          display: block !important;
          padding: 12px !important;
        }

        .site-header .mega-menu__primary-links {
          display: grid !important;
          gap: 8px !important;
        }
      }
    </style>
  </head>
  <body>
    <GoogleTagManager placement="body" />
    <Header />
    <slot />
    <Footer />
    <HeaderBehavior />
    <slot name="scripts" />
  </body>
</html>
