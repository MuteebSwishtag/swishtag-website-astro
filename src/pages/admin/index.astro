---
import GoogleTagManager from '../../components/analytics/GoogleTagManager.astro';

const title = "Admin | Swishtag";
---
<!doctype html>
<html lang="en">
  <head>
    <GoogleTagManager placement="head" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    >
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <style is:global>
      :root {
        --ink: #202124;
        --muted: #696a6d;
        --soft: #f5f5f3;
        --white: #ffffff;
        --line: rgba(32, 33, 36, .10);
        --line-strong: rgba(32, 33, 36, .16);
        --lime: #c2ff02;
        --mint: #99feed;
        --lav: #d9d6fd;
        --peach: #ffbd9b;
        --danger: #8f352c;
        --success: #516800;
        --radius: 18px;
        --shadow: 0 24px 70px rgba(32, 33, 36, .11);
        --page: 1240px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 7% 2%, rgba(217, 214, 253, .56), transparent 29rem),
          radial-gradient(circle at 88% 0%, rgba(194, 255, 2, .46), transparent 28rem),
          radial-gradient(circle at 84% 52%, rgba(153, 254, 237, .34), transparent 31rem),
          linear-gradient(180deg, #fff 0%, #fbfbf8 42%, #f5f5f3 100%);
        color: var(--ink);
        font-family: "Plus Jakarta Sans", Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      button,
      input {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      button:disabled {
        cursor: wait;
        opacity: .72;
      }

      .admin-shell {
        width: min(var(--page), calc(100% - 40px));
        margin: 0 auto;
        padding: 28px 0 46px;
      }

      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        min-height: 68px;
        margin-bottom: 28px;
        padding: 10px 12px 10px 22px;
        border: 1px solid var(--line);
        border-radius: 34px;
        background: rgba(255, 255, 255, .86);
        box-shadow: 0 20px 60px rgba(32, 33, 36, .08);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        font-weight: 900;
        letter-spacing: 0;
      }

      .brand-mark {
        width: 126px;
        height: 42px;
        flex: 0 0 126px;
        background: url("/assets/swishtag-logo.svg") center / contain no-repeat;
      }

      .brand-text {
        display: grid;
        gap: 2px;
        padding-left: 14px;
        border-left: 1px solid var(--line);
      }

      .brand-text span {
        font-size: .92rem;
        font-weight: 900;
      }

      .brand-text small {
        color: var(--muted);
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .top-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 16px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 255, 255, .86);
        color: var(--ink);
        font-size: .86rem;
        font-weight: 850;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 28px rgba(32, 33, 36, .08);
      }

      .btn-primary {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--white);
      }

      .btn-accent {
        background: var(--lime);
        border-color: rgba(32, 33, 36, .12);
        color: var(--ink);
      }

      .login-wrap {
        min-height: calc(100vh - 150px);
        display: grid;
        place-items: center;
      }

      .login-panel {
        position: relative;
        width: min(460px, 100%);
        overflow: hidden;
        background:
          radial-gradient(circle at 100% 0%, rgba(194, 255, 2, .2), transparent 32%),
          linear-gradient(180deg, rgba(255, 255, 255, .96), rgba(255, 255, 255, .86));
        border: 1px solid var(--line);
        border-radius: 28px;
        padding: 34px;
        box-shadow: var(--shadow);
      }

      .login-panel::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 5px;
        background: linear-gradient(90deg, var(--lime), var(--mint), var(--lav), var(--peach));
      }

      .login-panel h1,
      .dashboard-title h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.5rem);
        line-height: 1.05;
        letter-spacing: -.055em;
      }

      .login-panel p,
      .dashboard-title p {
        margin: 12px 0 0;
        color: var(--muted);
        font-size: .95rem;
        line-height: 1.65;
      }

      .form-grid {
        display: grid;
        gap: 14px;
        margin-top: 24px;
      }

      .field {
        display: grid;
        gap: 8px;
      }

      .field label {
        font-size: .76rem;
        font-weight: 900;
        color: #44474d;
        letter-spacing: .04em;
        text-transform: uppercase;
      }

      .field input {
        min-height: 52px;
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: rgba(255, 255, 255, .92);
        padding: 0 15px;
        color: var(--ink);
        outline: none;
      }

      .field input:focus {
        border-color: rgba(142, 179, 0, .6);
        box-shadow: 0 0 0 4px rgba(194, 255, 2, .18);
      }

      .login-button {
        width: 100%;
        margin-top: 2px;
      }

      .feedback {
        display: none;
        min-height: 46px;
        align-items: center;
        padding: 11px 14px;
        border-radius: 16px;
        background: #fff5f0;
        border: 1px solid #f0d0c4;
        color: var(--danger);
        font-size: .9rem;
      }

      .feedback.is-visible {
        display: flex;
      }

      .dashboard {
        display: none;
      }

      .dashboard.is-visible {
        display: block;
      }

      .dashboard-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin: 30px 0 22px;
      }

      .dashboard-title {
        max-width: 780px;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
      }

      .stat {
        position: relative;
        min-height: 118px;
        overflow: hidden;
        background: rgba(255, 255, 255, .82);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 18px 45px rgba(32, 33, 36, .055);
      }

      .stat::after {
        content: "";
        position: absolute;
        right: -34px;
        bottom: -46px;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(194, 255, 2, .24);
      }

      .stat:nth-child(2)::after {
        background: rgba(153, 254, 237, .34);
      }

      .stat:nth-child(3)::after {
        background: rgba(217, 214, 253, .42);
      }

      .stat span {
        position: relative;
        z-index: 1;
        display: block;
        color: var(--muted);
        font-size: .72rem;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .stat strong {
        position: relative;
        z-index: 1;
        display: block;
        margin-top: 14px;
        font-size: clamp(2.2rem, 5vw, 3.6rem);
        line-height: 1;
        letter-spacing: -.06em;
      }

      .tabs {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 18px;
        padding: 7px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 255, 255, .74);
        box-shadow: 0 14px 38px rgba(32, 33, 36, .055);
      }

      .tab {
        min-height: 42px;
        border: 0;
        border-radius: 999px;
        padding: 0 16px;
        background: transparent;
        color: var(--ink);
        font-size: .82rem;
        font-weight: 900;
        transition: background .18s ease, color .18s ease, box-shadow .18s ease;
      }

      .tab.is-active {
        background: var(--ink);
        color: var(--white);
        box-shadow: 0 10px 24px rgba(32, 33, 36, .18);
      }

      .table-shell {
        background: rgba(255, 255, 255, .88);
        border: 1px solid var(--line);
        border-radius: 26px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .table-scroll {
        width: 100%;
        overflow-x: auto;
      }

      .submissions-table {
        width: 100%;
        min-width: 1380px;
        border-collapse: separate;
        border-spacing: 0;
      }

      .submissions-table--book-demo {
        min-width: 1960px;
      }

      .submissions-table--discuss-idea {
        min-width: 1580px;
      }

      .submissions-table--contact {
        min-width: 1460px;
      }

      .submissions-table th,
      .submissions-table td {
        padding: 15px 16px;
        border-bottom: 1px solid rgba(32, 33, 36, .07);
        border-right: 1px solid rgba(32, 33, 36, .055);
        text-align: left;
        vertical-align: top;
        line-height: 1.45;
      }

      .submissions-table th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: rgba(250, 250, 248, .98);
        color: #5f6268;
        font-size: .7rem;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .submissions-table td {
        color: #2f3136;
        font-size: .88rem;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
      }

      .submissions-table tr:last-child td {
        border-bottom: 0;
      }

      .submissions-table th:last-child,
      .submissions-table td:last-child {
        border-right: 0;
      }

      .submissions-table tbody tr:nth-child(even) td {
        background: rgba(250, 250, 248, .58);
      }

      .submissions-table tbody tr:hover td {
        background: rgba(194, 255, 2, .12);
      }

      .cell-primary {
        font-weight: 850;
        color: var(--ink);
      }

      .cell-name {
        min-width: 180px;
        max-width: 220px;
      }

      .cell-email {
        min-width: 220px;
        max-width: 260px;
      }

      .cell-company {
        min-width: 190px;
        max-width: 240px;
      }

      .cell-muted {
        color: var(--muted);
      }

      .cell-status {
        min-width: 132px;
        max-width: 150px;
        white-space: nowrap !important;
      }

      .cell-short {
        min-width: 130px;
        max-width: 170px;
        white-space: normal;
      }

      .cell-medium {
        min-width: 180px;
        max-width: 240px;
      }

      .cell-long {
        min-width: 300px;
        max-width: 430px;
      }

      .cell-url {
        min-width: 270px;
        max-width: 390px;
      }

      .cell-date {
        min-width: 178px;
        max-width: 190px;
        white-space: nowrap !important;
      }

      .cell-time {
        min-width: 138px;
        max-width: 150px;
        white-space: nowrap !important;
      }

      .cell-ip {
        min-width: 132px;
        max-width: 150px;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
        white-space: nowrap !important;
        overflow-wrap: normal !important;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        background: rgba(32, 33, 36, .08);
        color: var(--ink);
        font-size: .72rem;
        font-weight: 900;
        letter-spacing: .05em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .status-pill[data-status="sent"] {
        background: rgba(194, 255, 2, .32);
        color: var(--success);
      }

      .status-pill[data-status="failed"] {
        background: rgba(255, 189, 155, .28);
        color: var(--danger);
      }

      .status-pill[data-status="pending"],
      .status-pill[data-status="creating"] {
        background: rgba(217, 214, 253, .5);
      }

      .submissions-table a {
        color: var(--ink);
        font-weight: 800;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      .empty,
      .loading {
        min-height: 140px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, .74);
        border: 1px dashed var(--line-strong);
        border-radius: 24px;
        color: var(--muted);
        text-align: center;
        padding: 20px;
        box-shadow: 0 14px 34px rgba(32, 33, 36, .045);
      }

      [hidden] {
        display: none !important;
      }

      @media (max-width: 760px) {
        .admin-shell {
          width: min(100% - 20px, var(--page));
          padding: 18px 0;
        }

        .topbar,
        .dashboard-head {
          align-items: stretch;
          flex-direction: column;
          display: flex;
        }

        .topbar {
          border-radius: 24px;
          padding: 14px;
        }

        .brand {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
        }

        .brand-text {
          padding-left: 0;
          border-left: 0;
        }

        .top-actions,
        .top-actions .btn {
          width: 100%;
        }

        .stats {
          grid-template-columns: 1fr;
        }

        .tabs {
          border-radius: 22px;
        }

        .tab {
          flex: 1 1 100%;
        }

        .login-panel {
          padding: 30px 22px 24px;
          border-radius: 24px;
        }

      }
    </style>
  </head>
  <body>
    <GoogleTagManager placement="body" />
    <main class="admin-shell">
      <div class="topbar">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text"><span>Admin Portal</span><small>Form submissions</small></span>
        </div>
        <div class="top-actions" id="topActions" hidden>
          <button class="btn btn-accent" id="refreshButton" type="button">Refresh data</button>
          <button class="btn" id="logoutButton" type="button">Logout</button>
        </div>
      </div>

      <section class="login-wrap" id="loginView">
        <form class="login-panel" id="loginForm" autocomplete="on">
          <h1>Admin portal</h1>
          <p>Enter the admin account to view form submissions.</p>
          <div class="form-grid">
            <div class="field">
              <label for="username">Username</label>
              <input id="username" name="username" type="text" autocomplete="username" required>
            </div>
            <div class="field">
              <label for="password">Password</label>
              <input id="password" name="password" type="password" autocomplete="current-password" required>
            </div>
            <button class="btn btn-primary login-button" id="loginButton" type="submit">Sign in</button>
            <div class="feedback" id="loginFeedback" role="status" aria-live="polite"></div>
          </div>
        </form>
      </section>

      <section class="dashboard" id="dashboardView">
        <div class="dashboard-head">
          <div class="dashboard-title">
            <h1>Form Submissions</h1>
            <p id="dashboardSubtitle">Latest submissions appear first.</p>
          </div>
        </div>

        <div class="stats">
          <div class="stat"><span>Book Demo Forms</span><strong id="bookDemoCount">0</strong></div>
          <div class="stat"><span>Discuss Idea Forms</span><strong id="discussIdeaCount">0</strong></div>
          <div class="stat"><span>Contact Forms</span><strong id="contactCount">0</strong></div>
        </div>

        <div class="tabs" role="tablist" aria-label="Submission type">
          <button class="tab is-active" id="book-demo-tab" type="button" role="tab" aria-selected="true" data-type="book-demo">Book Demo Forms</button>
          <button class="tab" id="discuss-idea-tab" type="button" role="tab" aria-selected="false" data-type="discuss-idea">Discuss Idea Forms</button>
          <button class="tab" id="contact-tab" type="button" role="tab" aria-selected="false" data-type="contact">Contact Forms</button>
        </div>

        <div class="loading" id="loadingState">Loading submissions...</div>
        <div class="submissions" id="submissionsList"></div>
      </section>
    </main>

    <script>
      (() => {
        const loginView = document.getElementById("loginView");
        const dashboardView = document.getElementById("dashboardView");
        const loginForm = document.getElementById("loginForm");
        const loginButton = document.getElementById("loginButton");
        const loginFeedback = document.getElementById("loginFeedback");
        const topActions = document.getElementById("topActions");
        const refreshButton = document.getElementById("refreshButton");
        const logoutButton = document.getElementById("logoutButton");
        const tabs = [...document.querySelectorAll(".tab")];
        const loadingState = document.getElementById("loadingState");
        const submissionsList = document.getElementById("submissionsList");
        const bookDemoCount = document.getElementById("bookDemoCount");
        const discussIdeaCount = document.getElementById("discussIdeaCount");
        const contactCount = document.getElementById("contactCount");
        const dashboardSubtitle = document.getElementById("dashboardSubtitle");

        let activeType = "book-demo";
        let cachedCounts = {
          "book-demo": 0,
          "discuss-idea": 0,
          "contact": 0
        };

        const tableColumns = {
          "book-demo": [
            { key: "createdAt", label: "Submitted", type: "date", className: "cell-date" },
            { key: "emailStatus", label: "Email status", type: "root", className: "cell-status" },
            { key: "fullName", label: "Full name", type: "field", className: "cell-primary cell-name" },
            { key: "workEmail", label: "Work email", type: "field", className: "cell-email" },
            { key: "companyName", label: "Company", type: "field", className: "cell-primary cell-company" },
            { key: "website", label: "Website", type: "field", className: "cell-url", url: true },
            { key: "solutionInterest", label: "Solution interest", type: "field", className: "cell-long" },
            { key: "service", label: "Service", type: "field", className: "cell-medium" },
            { key: "intent", label: "Intent", type: "field", className: "cell-short" },
            { key: "storeCount", label: "Store count", type: "field", className: "cell-short" },
            { key: "selectedDate", label: "Selected date", type: "field", className: "cell-medium" },
            { key: "selectedTime", label: "Selected time", type: "field", className: "cell-time" },
            { key: "timezone", label: "Timezone", type: "field", className: "cell-medium" },
            { key: "notes", label: "Notes", type: "field", className: "cell-long" },
            { key: "page", label: "Page", type: "root", className: "cell-url", url: true },
            { key: "ipAddress", label: "IP", type: "root", className: "cell-ip" }
          ],
          "discuss-idea": [
            { key: "createdAt", label: "Submitted", type: "date", className: "cell-date" },
            { key: "emailStatus", label: "Email status", type: "root", className: "cell-status" },
            { key: "name", label: "Name", type: "field", className: "cell-primary cell-name" },
            { key: "email", label: "Work email", type: "field", className: "cell-email" },
            { key: "project_type", label: "Project type", type: "field", className: "cell-long" },
            { key: "stage", label: "Stage", type: "field", className: "cell-long" },
            { key: "problem", label: "Problem", type: "field", className: "cell-long" },
            { key: "integrations", label: "Integrations", type: "field", className: "cell-medium" },
            { key: "budget", label: "Estimated investment", type: "field", className: "cell-medium" },
            { key: "page", label: "Page", type: "root", className: "cell-url", url: true },
            { key: "ipAddress", label: "IP", type: "root", className: "cell-ip" }
          ],
          "contact": [
            { key: "createdAt", label: "Submitted", type: "date", className: "cell-date" },
            { key: "emailStatus", label: "Email status", type: "root", className: "cell-status" },
            { key: "fullName", label: "Full name", type: "field", className: "cell-primary cell-name" },
            { key: "workEmail", label: "Work email", type: "field", className: "cell-email" },
            { key: "companyName", label: "Company", type: "field", className: "cell-primary cell-company" },
            { key: "role", label: "Role", type: "field", className: "cell-long" },
            { key: "topic", label: "Topic", type: "field", className: "cell-long" },
            { key: "message", label: "Message", type: "field", className: "cell-long" },
            { key: "page", label: "Page", type: "root", className: "cell-url", url: true },
            { key: "ipAddress", label: "IP", type: "root", className: "cell-ip" }
          ]
        };

        function escapeHtml(value) {
          return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
        }

        function formatDate(value) {
          if (!value) return "Unknown date";
          const date = new Date(value);
          if (Number.isNaN(date.getTime())) return value;
          return new Intl.DateTimeFormat(undefined, {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "numeric",
            minute: "2-digit"
          }).format(date);
        }

        async function requestJson(url, options = {}) {
          const response = await fetch(url, {
            ...options,
            headers: {
              "Accept": "application/json",
              ...(options.headers || {})
            }
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result.ok === false) {
            throw new Error(result.message || "Request failed.");
          }
          return result;
        }

        function setLoggedIn(isLoggedIn) {
          loginView.hidden = isLoggedIn;
          dashboardView.classList.toggle("is-visible", isLoggedIn);
          topActions.hidden = !isLoggedIn;
          if (!isLoggedIn) {
            loginForm.reset();
            loginFeedback.classList.remove("is-visible");
          }
        }

        function setLoginBusy(isBusy) {
          loginButton.disabled = isBusy;
          loginButton.textContent = isBusy ? "Checking..." : "Sign in";
        }

        function showLoginError(message) {
          loginFeedback.textContent = message;
          loginFeedback.classList.add("is-visible");
        }

        function setActiveTab(type) {
          activeType = type;
          tabs.forEach(tab => {
            const isActive = tab.dataset.type === type;
            tab.classList.toggle("is-active", isActive);
            tab.setAttribute("aria-selected", String(isActive));
          });
        }

        function renderCounts() {
          bookDemoCount.textContent = cachedCounts["book-demo"];
          discussIdeaCount.textContent = cachedCounts["discuss-idea"];
          contactCount.textContent = cachedCounts["contact"];
        }

        function getColumnValue(submission, column) {
          if (column.type === "date") return formatDate(submission.createdAt);
          if (column.type === "field") return submission.fields?.[column.key] || "";
          return submission[column.key] || "";
        }

        function renderCell(value, column) {
          const displayValue = value || "-";
          const className = column.className ? ` class="${column.className}"` : "";

          if (column.key === "emailStatus" && value) {
            return `<td${className}><span class="status-pill" data-status="${escapeHtml(value)}">${escapeHtml(value)}</span></td>`;
          }

          if (column.url && value) {
            return `<td${className}><a href="${escapeHtml(value)}" target="_blank" rel="noopener noreferrer">${escapeHtml(value)}</a></td>`;
          }

          return `<td${className}>${escapeHtml(displayValue)}</td>`;
        }

        function renderTable(submissions) {
          const columns = tableColumns[activeType] || [];
          const headings = columns.map(column => {
            const className = column.className ? ` class="${column.className}"` : "";
            return `<th scope="col"${className}>${escapeHtml(column.label)}</th>`;
          }).join("");
          const rows = submissions.map(submission => {
            const cells = columns
              .map(column => renderCell(getColumnValue(submission, column), column))
              .join("");

            return `<tr>${cells}</tr>`;
          }).join("");

          return `
            <div class="table-shell">
              <div class="table-scroll">
                <table class="submissions-table submissions-table--${escapeHtml(activeType)}">
                  <thead><tr>${headings}</tr></thead>
                  <tbody>${rows}</tbody>
                </table>
              </div>
            </div>
          `;
        }

        function renderSubmissions(submissions) {
          cachedCounts[activeType] = Number(submissions.total ?? submissions.items.length);
          renderCounts();

          const typeLabel = activeType === "book-demo" ? "book demo" : activeType === "contact" ? "contact" : "discuss idea";
          dashboardSubtitle.textContent = `${cachedCounts[activeType]} ${typeLabel} submission${cachedCounts[activeType] === 1 ? "" : "s"}`;

          if (!submissions.items.length) {
            submissionsList.innerHTML = '<div class="empty">No submissions found.</div>';
            return;
          }

          submissionsList.innerHTML = renderTable(submissions.items);
        }

        async function loadSubmissions(type = activeType) {
          setActiveTab(type);
          loadingState.hidden = false;
          submissionsList.innerHTML = "";

          try {
            const result = await requestJson(`/api/admin/submissions?type=${encodeURIComponent(type)}`);
            renderSubmissions({
              total: result.total,
              items: result.submissions || []
            });
          } catch (error) {
            if (error.message === "Unauthorized.") {
              setLoggedIn(false);
              return;
            }
            submissionsList.innerHTML = `<div class="empty">${escapeHtml(error.message || "Could not load submissions.")}</div>`;
          } finally {
            loadingState.hidden = true;
          }
        }

        async function refreshAllCounts() {
          try {
            const [bookDemo, discussIdea, contact] = await Promise.all([
              requestJson("/api/admin/submissions?type=book-demo"),
              requestJson("/api/admin/submissions?type=discuss-idea"),
              requestJson("/api/admin/submissions?type=contact")
            ]);
            cachedCounts["book-demo"] = Number(bookDemo.total ?? (bookDemo.submissions || []).length);
            cachedCounts["discuss-idea"] = Number(discussIdea.total ?? (discussIdea.submissions || []).length);
            cachedCounts["contact"] = Number(contact.total ?? (contact.submissions || []).length);
            renderCounts();
          } catch {
            renderCounts();
          }
        }

        loginForm.addEventListener("submit", async event => {
          event.preventDefault();
          const formData = new FormData(loginForm);

          try {
            setLoginBusy(true);
            loginFeedback.classList.remove("is-visible");
            await requestJson("/api/admin/login", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                username: String(formData.get("username") || ""),
                password: String(formData.get("password") || "")
              })
            });
            setLoggedIn(true);
            await loadSubmissions("book-demo");
            await refreshAllCounts();
          } catch (error) {
            showLoginError(error.message || "Login failed.");
          } finally {
            setLoginBusy(false);
          }
        });

        tabs.forEach(tab => {
          tab.addEventListener("click", () => loadSubmissions(tab.dataset.type));
        });

        refreshButton.addEventListener("click", () => {
          loadSubmissions(activeType);
          refreshAllCounts();
        });

        logoutButton.addEventListener("click", async () => {
          await requestJson("/api/admin/logout", { method: "POST" }).catch(() => {});
          setLoggedIn(false);
        });

        requestJson("/api/admin/me")
          .then(result => {
            if (result.authenticated) {
              setLoggedIn(true);
              loadSubmissions("book-demo");
              refreshAllCounts();
            } else {
              setLoggedIn(false);
            }
          })
          .catch(() => setLoggedIn(false));
      })();
    </script>
  </body>
</html>
