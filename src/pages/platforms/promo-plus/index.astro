---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PromoPlusPage from '../../../components/PromoPlusPage.astro';
import SharedFaq from '../../../components/layout/SharedFaq.astro';
import faqs from '../../../data/faqs.json';
import { ORG_ID } from '../../../data/site.js';

export const prerender = true;

const title = "Artwork Proofing Software | Promo Plus by Swishtag";
const description = "Promo Plus is artwork proofing software for promotional products. Create mockups, manage client approvals and send production-ready proof files.";
const canonical = "https://swishtag.com/platforms/promo-plus/";
const robots = "index,follow";
const software = {
  "@type": "SoftwareApplication",
  "@id": `${canonical}#software`,
  name: "Promo Plus",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://promoplus.io/",
  description,
  provider: { "@id": ORG_ID },
};
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots} schema={[software]} pageProps={{ mainEntity: { "@id": software["@id"] } }} faq={faqs.promoPlus} ogImage="/assets/og/artwork-proofing-software-promo-plus.jpg" ogImageAlt="Product mockup workspace in Promo Plus artwork proofing software">
  <PromoPlusPage>
    <SharedFaq {...faqs.promoPlus} />
  </PromoPlusPage>
</BaseLayout>
