---
import GoogleTagManager from '../../components/analytics/GoogleTagManager.astro';

const target = '/shopify-apps-for-promotional-products/';
---
<!doctype html>
<html lang="en">
  <head>
    <GoogleTagManager placement="head" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://cms.swishtag.com/shopify-apps-for-promotional-products/" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirecting...</title>
    <script is:inline>location.replace('/shopify-apps-for-promotional-products/' + location.search + location.hash);</script>
  </head>
  <body>
    <GoogleTagManager placement="body" />
    <p>Redirecting to <a href="/shopify-apps-for-promotional-products/">/shopify-apps-for-promotional-products/</a></p>
  </body>
</html>
