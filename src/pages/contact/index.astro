---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactPage from '../../components/ContactPage.astro';

export const prerender = true;

const title = "Contact Swishtag | Shopify & Automation";
const description = "Contact Swishtag about Shopify company stores, system integrations, PunchOut, promotional products workflows or custom automation.";
const canonical = "https://swishtag.com/contact/";
const robots = "index,follow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <ContactPage />
</BaseLayout>
