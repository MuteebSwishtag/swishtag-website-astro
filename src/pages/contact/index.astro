---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactPage from '../../components/ContactPage.astro';

export const prerender = true;

const title = "Contact Swishtag | Talk to Our Promo Tech Team";
const description = "Contact Swishtag about Shopify company stores, PunchOut, ERP integration or workflow automation for promotional products businesses. Book a demo.";
const canonical = "https://swishtag.com/contact/";
const robots = "index,follow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots} pageType="ContactPage" contactPoint>
  <ContactPage />
</BaseLayout>
