---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

const slug = Astro.params.slug;
const WORDPRESS_POSTS_API = 'https://cms.swishtag.com/wp-json/wp/v2/posts';

async function postExistsForSlug(slug) {
  if (!slug) return false;

  const url = new URL(WORDPRESS_POSTS_API);
  url.searchParams.set('slug', slug);
  url.searchParams.set('_fields', 'id,slug');
  url.searchParams.set('per_page', '1');

  const response = await fetch(url);
  if (!response.ok) throw new Error(`WordPress returned ${response.status}`);

  const posts = await response.json();
  return Array.isArray(posts) && posts.length > 0;
}

async function postExistsForPublicSlug(slug) {
  if (!slug) return false;
  if (await postExistsForSlug(slug)) return true;
  if (slug.endsWith('-2026')) return postExistsForSlug(slug.replace(/-2026$/, ''));
  return false;
}

try {
  if (!(await postExistsForPublicSlug(slug))) {
    return new Response(null, {
      status: 404,
      statusText: 'Not found',
    });
  }
} catch (error) {
  console.warn(`Unable to verify WordPress post slug "${slug}":`, error);
}

const title = 'Insight | Swishtag';
const description = 'A practical Swishtag insight for Shopify, promotional products, integrations, automation and commerce teams.';
const canonical = `https://swishtag.com/${slug}/`;
const robots = 'index,follow';
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <link slot="head" rel="stylesheet" href="/assets/insights.css" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content="Insight | Swishtag" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <script slot="head" is:inline type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Insight | Swishtag","author":{"@type":"Organization","name":"Swishtag"},"publisher":{"@type":"Organization","name":"Swishtag"}}</script>

  <div class="progress" aria-hidden="true"></div>
  <main>
    <section class="container article-hero">
      <div class="breadcrumbs"><a href="/insights/">Insights</a><span>/</span><a href="/insights/">Blog</a><span>/</span><span>Loading insight</span></div>
      <div class="article-hero-main"><div class="eyebrow">INSIGHTS</div><h1>Loading insight...</h1><p class="article-dek">Fetching the latest article from Swishtag.</p><div class="hero-meta"><span>Swishtag Team</span><span>Loading</span></div></div>
    </section>

    <div class="featured-article-image is-loading" role="img" aria-label="Loading featured article image" aria-busy="true">
      <div class="insights-image-placeholder insights-image-placeholder--loading" aria-hidden="true"></div>
    </div>

    <section class="container article-layout">
      <aside class="share-rail" aria-label="Share this article">
        <button class="share-btn" aria-label="Share on LinkedIn"><a href="https://www.linkedin.com/company/helloswishtag/posts/" target="_blank">in</a></button>
      </aside>
      <article class="article-body">
        <details class="toc-mobile" hidden><summary>In this insight</summary><div></div></details>
        <div class="insights-state insights-state--loading">Loading insight...</div>
      </article>
      <aside class="toc" aria-label="Table of contents" hidden><h4>In this insight</h4></aside>
    </section>

    <section class="container cta-section"><div class="cta-panel"><div class="eyebrow">NEED HELP?</div><h2>Building something complicated?</h2><p>Tell us what you're trying to connect, automate or move. We'll help you figure out the cleanest way to build it.</p><div class="cta-actions"><a class="btn btn-primary" href="/book-demo/">Book a demo</a></div></div></section>
  </main>

  <script slot="scripts" is:inline src="/assets/insights.js?v=20260902-cms-media"></script>
</BaseLayout>
