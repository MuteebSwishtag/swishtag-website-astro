---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ORG_ID } from '../data/site.js';
import { loadBlogPost } from '../../integrations/blog-post-cache.mjs';

export const prerender = false;

const slug = Astro.params.slug;
const result = await loadBlogPost(slug);
if (result.status === 404) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const unavailable = result.status !== 200;
if (unavailable) {
  Astro.response.status = 503;
  Astro.response.statusText = 'Service Unavailable';
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
}

const post = result.post;
const title = post?.title || 'Insight unavailable | Swishtag';
const description = post?.description || 'This insight is temporarily unavailable. Please try again shortly.';
const canonical = post?.canonical || `https://swishtag.com/${slug}/`;
const robots = unavailable ? 'noindex,follow' : 'index,follow';
const postHeadline = post?.headline || '';
const postImage = post?.image || '';

const postAuthor = !post?.authorName
  ? null
  : /^swishtag\b/i.test(post.authorName)
    ? { '@id': ORG_ID }
    : { '@type': 'Person', name: post.authorName };
const blogPosting = postHeadline && post?.dateGmt
  ? {
      '@type': 'BlogPosting',
      '@id': `${canonical}#article`,
      headline: postHeadline,
      description: post.description,
      datePublished: post.dateGmt,
      ...(post.modifiedGmt ? { dateModified: post.modifiedGmt } : {}),
      ...(postAuthor ? { author: postAuthor } : {}),
      ...(postImage ? { image: postImage } : {}),
      publisher: { '@id': ORG_ID },
      mainEntityOfPage: { '@id': `${canonical}#webpage` },
      isPartOf: { '@id': `${canonical}#webpage` },
      url: canonical,
    }
  : null;
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots} pageName={postHeadline || title} schema={[blogPosting]} ogType="article" ogImage={postImage} ogImageAlt={postHeadline ? `${postHeadline} insight` : 'Featured image for a Swishtag insight'}>
  <link slot="head" rel="stylesheet" href="/assets/insights.css" />

  <div class="progress" aria-hidden="true"></div>
  <main>
    {unavailable ? (
      <section class="container article-hero">
        <div class="breadcrumbs"><a href="/insights/">Insights</a><span>/</span><span>Unavailable</span></div>
        <div class="article-hero-main">
          <div class="eyebrow">INSIGHTS</div>
          <h1>This insight is temporarily unavailable.</h1>
          <p class="article-dek">The article could not be loaded just now. Please try again shortly.</p>
        </div>
      </section>
    ) : (
      <>
        <section class="container article-hero">
          <div class="breadcrumbs"><a href="/insights/">Insights</a><span>/</span><a href="/insights/">{post.category}</a><span>/</span><span>{post.headline}</span></div>
          <div class="article-hero-main">
            <div class="eyebrow">{post.category}</div>
            <h1>{post.headline}</h1>
            <p class="article-dek">{post.dek}</p>
            <div class="hero-meta">
              <span>Swishtag Team</span>
              {post.dateLabel && <span>{post.dateLabel}</span>}
              <span>{post.readTime}</span>
            </div>
          </div>
        </section>

        <div class="featured-article-image" role="img" aria-label={post.headline}>
          {post.image ? (
            <img class="featured-article-image__media is-loaded" src={post.image} alt={post.headline} decoding="async" fetchpriority="high" />
          ) : (
            <div class="insights-image-placeholder" aria-hidden="true"></div>
          )}
        </div>

        <section class="container article-layout">
          <aside class="share-rail" aria-label="Share this article">
            <button class="share-btn" aria-label="Share on LinkedIn"><a href="https://www.linkedin.com/company/helloswishtag/posts/" target="_blank">in</a></button>
          </aside>
          <article class="article-body">
            {post.headings.length > 0 && (
              <details class="toc-mobile">
                <summary>In this insight</summary>
                <div>
                  {post.headings.map((heading) => <a href={`#${heading.id}`}>{heading.text}</a>)}
                </div>
              </details>
            )}
            <div set:html={post.html} />
          </article>
          <aside class="toc" aria-label="Table of contents" hidden={post.headings.length === 0}>
            <h4>In this insight</h4>
            {post.headings.map((heading) => <a href={`#${heading.id}`}>{heading.text}</a>)}
          </aside>
        </section>
      </>
    )}

    <section class="container cta-section"><div class="cta-panel"><div class="eyebrow">NEED HELP?</div><h2>Building something complicated?</h2><p>Tell us what you're trying to connect, automate or move. We'll help you figure out the cleanest way to build it.</p><div class="cta-actions"><a class="btn btn-primary" href="/book-demo/">Book a demo</a></div></div></section>
  </main>

  {!unavailable && <script slot="scripts" is:inline src="/assets/insights.js?v=20261112-ssr"></script>}
</BaseLayout>
