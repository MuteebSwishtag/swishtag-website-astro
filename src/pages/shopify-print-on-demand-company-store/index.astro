---
import GoogleTagManager from '../../components/analytics/GoogleTagManager.astro';

const target = '/solutions/shopify-company-store/';
---
<!doctype html>
<html lang="en">
  <head>
    <GoogleTagManager placement="head" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://cms.swishtag.com/solutions/shopify-company-store/" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirecting...</title>
    <script is:inline>location.replace('/solutions/shopify-company-store/' + location.search + location.hash);</script>
  </head>
  <body>
    <GoogleTagManager placement="body" />
    <p>Redirecting to <a href="/solutions/shopify-company-store/">/solutions/shopify-company-store/</a></p>
  </body>
</html>
