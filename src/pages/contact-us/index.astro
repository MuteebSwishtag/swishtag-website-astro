---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactPage from '../../components/ContactPage.astro';

const title = "Contact Swishtag | Shopify & Automation";
const description = "Contact Swishtag about company stores, integrations, automation, custom software, and promotional commerce platforms.";
const canonical = "https://cms.swishtag.com/contact-us/";
const robots = "index,follow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <ContactPage />
</BaseLayout>
