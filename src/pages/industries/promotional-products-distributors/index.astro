---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DistributorsPage from '../../../components/DistributorsPage.astro';
import faqs from '../../../data/faqs.json';

export const prerender = true;

const title = "Solutions for Promotional Products Distributors | Swishtag";
const description = "Company stores, supplier data, PunchOut and enterprise automation for promotional products distributors.";
const canonical = "https://swishtag.com/industries/promotional-products-distributors/";
const robots = "index,follow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots} faq={faqs.distributors}>
  <DistributorsPage />
</BaseLayout>
