---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DistributorsPage from '../../../components/DistributorsPage.astro';
import faqs from '../../../data/faqs.json';

export const prerender = true;

const title = "Promotional Products Distributor Solutions | Swishtag";
const description = "Promotional products distributor solutions: Shopify company stores, PunchOut, multi-store automation and custom software, built around your suppliers.";
const canonical = "https://swishtag.com/industries/promotional-products-distributors/";
const robots = "index,follow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots} faq={faqs.distributors}>
  <DistributorsPage />
</BaseLayout>
