---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SuppliersPage from '../../../components/SuppliersPage.astro';

export const prerender = true;

const title = "Promotional Products Supplier Solutions | Swishtag";
const description = "Promotional products supplier solutions: product data, Shopify ecommerce and order integration. Reduce manual handoffs across channels. Book a demo.";
const canonical = "https://swishtag.com/industries/promotional-products-suppliers/";
const robots = "index,follow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots} ogImageAlt="Swishtag rocket illustration for promotional products supplier solutions">
  <SuppliersPage />
</BaseLayout>
