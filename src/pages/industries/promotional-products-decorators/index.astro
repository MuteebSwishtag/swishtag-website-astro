---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DecoratorsPage from '../../../components/DecoratorsPage.astro';
import faqs from '../../../data/faqs.json';

export const prerender = true;

const title = "Promotional Product Decorator Software | Swishtag";
const description = "Promotional product decorator software for screen printers, embroiderers and DTG shops. Connect artwork approval to production. Book a demo.";
const canonical = "https://swishtag.com/industries/promotional-products-decorators/";
const robots = "index,follow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots} ogImageAlt="Swishtag rocket illustration for promotional product decorator software" faq={faqs.decorators}>
  <DecoratorsPage />
</BaseLayout>
