---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Enterprise Company Store Management & Automation | Swishtag";
const description = "Manage every Shopify company store from one dashboard. Add order routing, SAGE, PromoStandards, PunchOut, supplier, ERP, and AI automation as needed.";
const canonical = "https://cms.swishtag.com/solutions/enterprise-shopify-automation/";
const robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <meta slot="head" content="website" property="og:type"/>
  <meta slot="head" content="Enterprise Company Store Management &amp; Automation | Swishtag" property="og:title"/>
  <meta slot="head" content="One dashboard for every Shopify company store, with optional order routing, SAGE, PromoStandards, PunchOut, supplier, ERP, AI, and custom automation." property="og:description"/>
  <meta slot="head" content="https://cms.swishtag.com/solutions/enterprise-shopify-automation/" property="og:url"/>
  <meta slot="head" content="Swishtag" property="og:site_name"/>
  <meta slot="head" content="https://cms.swishtag.com/assets/swishtag-enterprise-automation-og.png" property="og:image"/>
  <meta slot="head" content="1200" property="og:image:width"/>
  <meta slot="head" content="630" property="og:image:height"/>
  <meta slot="head" content="Swishtag enterprise company store automation dashboard and connected workflow modules" property="og:image:alt"/>
  <meta slot="head" content="Enterprise Company Store Management &amp; Automation | Swishtag" name="twitter:title"/>
  <meta slot="head" content="One dashboard for every Shopify company store, with optional order routing, SAGE, PromoStandards, PunchOut, supplier, ERP, AI, and custom automation." name="twitter:description"/>
  <meta slot="head" content="https://cms.swishtag.com/assets/swishtag-enterprise-automation-og.png" name="twitter:image"/>
  <meta slot="head" content="summary_large_image" name="twitter:card"/>
  <script slot="head" type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://cms.swishtag.com/solutions/enterprise-shopify-automation/#service",
        "name": "Enterprise Company Store Management & Automation",
        "serviceType": "Multi-store Shopify company store management and automation",
        "provider": {
          "@type": "Organization",
          "name": "Swishtag",
          "url": "https://cms.swishtag.com/"
        },
        "url": "https://cms.swishtag.com/solutions/enterprise-shopify-automation/",
        "description": "A base platform for large promotional products distributors to manage multiple Shopify company stores from one dashboard, with paid add-ons for OMS automation, SAGE, PromoStandards, supplier APIs, QuickBooks, Sage Intacct, NetSuite, PunchOut, AI, and custom workflows.",
        "areaServed": "US",
        "audience": {
          "@type": "BusinessAudience",
          "audienceType": "Large promotional products distributors managing multiple company stores"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://cms.swishtag.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Solutions",
            "item": "https://cms.swishtag.com/solutions/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Enterprise Company Store Automation",
            "item": "https://cms.swishtag.com/solutions/enterprise-shopify-automation/"
          }
        ]
      }
    ]
  }
  </script>
  <style slot="head" is:inline>
  /* Consolidated production stylesheet. Rule order is preserved intentionally. */
  
  :root {
        --lime: #c2ff02;
        --peach: #ffbd9b;
        --lavender: #d9d6fd;
        --mint: #99feed;
        --white: #ffffff;
        --gray: #f5f5f3;
        --gray-2: #ecece8;
        --ink: #202124;
        --muted: #6c6e73;
        --line: rgba(32, 33, 36, .11);
        --line-strong: rgba(32, 33, 36, .18);
        --shadow-sm: 0 14px 38px rgba(32, 33, 36, .07);
        --shadow-md: 0 22px 58px rgba(32, 33, 36, .10);
        --shadow-lg: 0 34px 90px rgba(32, 33, 36, .14);
        --radius-xl: 42px;
        --radius-lg: 32px;
        --radius-md: 24px;
        --radius-sm: 16px;
        --page: min(1240px, calc(100vw - 48px));
        --ease: cubic-bezier(.22, .8, .24, 1);
        --header-height: 96px;
      }
  
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--white); -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        color: var(--ink);
        background: var(--white);
        font-family: "Plus Jakarta Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        overflow-x: hidden;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      body.menu-open { overflow: hidden; }
      img, svg { display: block; max-width: 100%; }
      a { color: inherit; text-decoration: none; }
      button, input, textarea, select { font: inherit; }
      button { color: inherit; }
      :focus-visible { outline: 3px solid rgba(194,255,2,.82); outline-offset: 4px; }
  
      .page-shell { width: var(--page); margin-inline: auto; }
      .section { position: relative; padding: 118px 0; }
      .section--compact { padding: 84px 0; }
      .section--gray { background: var(--gray); }
      .section--soft {
        background:
          radial-gradient(circle at 8% 12%, rgba(217,214,253,.35), transparent 24%),
          radial-gradient(circle at 90% 85%, rgba(153,254,237,.25), transparent 28%),
          #fff;
      }
  
      .eyebrow {
        margin: 0 0 18px;
        color: var(--muted);
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
      }
      .eyebrow--ink { color: var(--ink); }
      .section-title {
        max-width: 940px;
        margin: 0;
        font-size: clamp(3rem, 6vw, 6rem);
        line-height: .98;
        letter-spacing: -.062em;
        font-weight: 800;
        text-wrap: balance;
      }
      .section-title--small { font-size: clamp(2.7rem, 4.9vw, 4.9rem); }
      .section-copy {
        max-width: 730px;
        margin: 25px 0 0;
        color: var(--muted);
        font-size: clamp(1rem, 1.3vw, 1.18rem);
        line-height: 1.72;
      }
      .section-heading-split {
        display: grid;
        grid-template-columns: 1.08fr .72fr;
        align-items: end;
        gap: 64px;
      }
      .section-heading-split .section-copy { margin: 0; }
  
      .btn {
        min-height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 0 24px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: .92rem;
        font-weight: 800;
        cursor: pointer;
        transition: transform .26s var(--ease), box-shadow .26s var(--ease), background .22s ease, border-color .22s ease;
      }
      .btn:hover { transform: translateY(-3px); }
      .btn--primary { color: var(--ink); background: var(--lime); box-shadow: 0 14px 30px rgba(194,255,2,.26); }
      .btn--primary:hover { box-shadow: 0 18px 34px rgba(194,255,2,.34); }
      .btn--secondary { color: var(--ink); background: rgba(255,255,255,.8); border-color: rgba(32,33,36,.16); }
      .btn--dark { color: var(--white); background: var(--ink); }
      .btn__arrow { font-size: 1.05rem; transition: transform .24s var(--ease); }
      .btn:hover .btn__arrow { transform: translateX(4px); }
  
      .text-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 24px;
        font-size: .9rem;
        font-weight: 800;
      }
      .text-link span:last-child {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--lime);
      }
  
      /* Primary navigation */
      .site-header {
        position: fixed;
        z-index: 320;
        inset: 0 0 auto;
        padding: 14px 0;
        background: transparent;
        transition: padding .25s ease;
      }
      .site-header.is-scrolled { padding: 10px 0; }
      .modern-nav {
        width: var(--page);
        min-height: 68px;
        margin-inline: auto;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 24px;
        padding: 7px 9px 7px 21px;
        border: 1px solid rgba(255,255,255,.92);
        border-radius: 999px;
        background: rgba(255,255,255,.82);
        box-shadow: 0 14px 42px rgba(32,33,36,.075);
        -webkit-backdrop-filter: blur(18px) saturate(1.08);
        backdrop-filter: blur(18px) saturate(1.08);
        transition: min-height .28s var(--ease), background .22s ease, border-color .22s ease, box-shadow .22s ease;
      }
      .site-header.is-scrolled .modern-nav {
        min-height: 62px;
        background: rgba(255,255,255,.94);
        border-color: rgba(32,33,36,.075);
        box-shadow: 0 14px 38px rgba(32,33,36,.085);
      }
      @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .modern-nav { background: rgba(255,255,255,.97); }
      }
      .modern-nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: .96rem;
        font-weight: 800;
        letter-spacing: .055em;
        white-space: nowrap;
      }
      .modern-nav__brand-mark {
        width: 14px;
        height: 14px;
        border-radius: 5px 5px 5px 1px;
        background: var(--lime);
        box-shadow: 9px -7px 0 -4px var(--peach), 11px 7px 0 -5px var(--mint);
        transform: rotate(-12deg);
        flex: 0 0 auto;
      }
      .desktop-nav { display: flex; align-items: center; justify-content: center; gap: 5px; }
      .desktop-nav__item { position: relative; }
      .desktop-nav__trigger,
      .desktop-nav__direct {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 0 13px;
        border: 0;
        border-radius: 12px;
        background: transparent;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: background .2s ease;
      }
      .desktop-nav__trigger:hover,
      .desktop-nav__direct:hover { background: rgba(32,33,36,.045); }
      .desktop-nav__trigger svg { width: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; transition: transform .22s ease; }
      .desktop-nav__item.is-open .desktop-nav__trigger svg { transform: rotate(180deg); }
      .modern-nav__cta { min-height: 50px; padding-inline: 21px; }
  
      .mega-menu {
        position: fixed;
        z-index: 360;
        top: 94px;
        left: 50%;
        width: min(1180px, calc(100vw - 64px));
        display: grid;
        grid-template-columns: .82fr 1.24fr .82fr;
        gap: 16px;
        padding: 18px;
        border: 1px solid rgba(32,33,36,.08);
        border-radius: 30px;
        background: rgba(255,255,255,.985);
        box-shadow: var(--shadow-lg);
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, 10px) scale(.99);
        transition: opacity .22s ease, transform .25s var(--ease), visibility .22s ease;
      }
      .desktop-nav__item.is-open .mega-menu { opacity: 1; visibility: visible; transform: translate(-50%,0) scale(1); }
      .mega-menu__intro,
      .mega-menu__content,
      .mega-visual { min-height: 290px; border-radius: 22px; }
      .mega-menu__intro { padding: 26px; background: var(--gray); }
      .mega-menu__eyebrow { display: block; color: var(--muted); font-size: .64rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
      .mega-menu__title { margin: 15px 0 0; font-size: 2rem; line-height: 1.04; letter-spacing: -.045em; font-weight: 800; }
      .mega-menu__intro p:not(.mega-menu__title) { margin: 16px 0 0; color: var(--muted); font-size: .76rem; line-height: 1.65; }
      .mega-menu__all-link { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--line); font-size: .74rem; font-weight: 800; }
      .mega-menu__content { padding: 10px; border: 1px solid var(--line); }
      .mega-menu__primary-links { display: grid; gap: 7px; }
      .mega-link {
        display: grid;
        grid-template-columns: 42px 1fr auto;
        align-items: center;
        gap: 13px;
        padding: 13px;
        border-radius: 17px;
        transition: background .2s ease, transform .2s ease;
      }
      .mega-link:hover { background: var(--gray); transform: translateX(2px); }
      .mega-link[aria-current="page"] { background: rgba(217,214,253,.35); }
      .mega-link__icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; background: var(--lime); }
      .mega-link__icon--mint { background: var(--mint); }
      .mega-link__icon--lavender { background: var(--lavender); }
      .mega-link__icon--peach { background: var(--peach); }
      .mega-link__icon svg { width: 23px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
      .mega-link__copy strong,
      .mega-link__copy small { display: block; }
      .mega-link__copy strong { font-size: .8rem; }
      .mega-link__copy small { margin-top: 4px; color: var(--muted); font-size: .64rem; line-height: 1.42; }
      .mega-link__arrow { font-size: .78rem; }
      .mega-visual {
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        background: linear-gradient(145deg, rgba(153,254,237,.58), rgba(217,214,253,.78) 62%, rgba(255,189,155,.62));
        border: 1px solid rgba(255,255,255,.8);
      }
      .mega-visual__art { height: 165px; display: grid; place-items: center; }
      .mega-visual__art svg { width: 100%; max-height: 165px; }
      .mega-svg-window { fill: rgba(255,255,255,.72); stroke: rgba(32,33,36,.13); }
      .mega-svg-soft { fill: rgba(255,255,255,.48); }
      .mega-svg-line { fill: rgba(32,33,36,.16); }
      .mega-svg-lime { fill: var(--lime); }
      .mega-svg-node { fill: var(--ink); }
      .mega-svg-node--mint { fill: #31cdb8; }
      .mega-svg-node--peach { fill: #ed8f62; }
      .mega-svg-path { fill: none; stroke: rgba(32,33,36,.35); stroke-width: 2; stroke-dasharray: 5 7; }
      .mega-visual__caption span,
      .mega-visual__caption strong,
      .mega-visual__caption small { display: block; }
      .mega-visual__caption span { font-size: .58rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; opacity: .65; }
      .mega-visual__caption strong { margin-top: 7px; font-size: 1.02rem; }
      .mega-visual__caption small { margin-top: 6px; font-size: .64rem; line-height: 1.45; opacity: .72; }
  
      .menu-toggle {
        width: 48px;
        height: 48px;
        display: none;
        place-items: center;
        border: 1px solid rgba(32,33,36,.10);
        border-radius: 50%;
        background: var(--gray);
        cursor: pointer;
      }
      .modern-menu-toggle__line { width: 18px; height: 2px; display: block; border-radius: 99px; background: var(--ink); transition: transform .24s var(--ease), opacity .2s ease; }
      .modern-menu-toggle__line + .modern-menu-toggle__line { margin-top: 4px; }
      .menu-toggle[aria-expanded="true"] .modern-menu-toggle__line:first-child { transform: translateY(3px) rotate(45deg); }
      .menu-toggle[aria-expanded="true"] .modern-menu-toggle__line:nth-child(2) { transform: translateY(-3px) rotate(-45deg); }
      .menu-toggle[aria-expanded="true"] .modern-menu-toggle__line:nth-child(3) { opacity: 0; }
  
      .mobile-menu {
        position: fixed;
        z-index: 300;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        transition: opacity .25s ease, visibility .25s ease;
      }
      .mobile-menu.is-open { opacity: 1; visibility: visible; }
      .mobile-menu__backdrop { position: absolute; inset: 0; background: rgba(32,33,36,.35); }
      .mobile-menu__panel {
        position: absolute;
        top: 10px;
        right: 10px;
        width: min(520px, calc(100vw - 20px));
        max-height: calc(100dvh - 20px);
        overflow-y: auto;
        border-radius: 28px;
        background: var(--white);
        box-shadow: var(--shadow-lg);
        transform: translateY(-12px) scale(.985);
        transition: transform .3s var(--ease);
      }
      .mobile-menu.is-open .mobile-menu__panel { transform: translateY(0) scale(1); }
      .mobile-menu__top { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 20px 10px; }
      .mobile-menu__brand { display: inline-flex; align-items: center; gap: 10px; font-size: .9rem; font-weight: 800; letter-spacing: .055em; }
      .mobile-menu__close { width: 44px; height: 44px; position: relative; border: 0; border-radius: 50%; background: var(--gray); cursor: pointer; }
      .mobile-menu__close span { position: absolute; left: 12px; top: 21px; width: 20px; height: 2px; background: var(--ink); }
      .mobile-menu__close span:first-child { transform: rotate(45deg); }
      .mobile-menu__close span:last-child { transform: rotate(-45deg); }
      .mobile-menu__body { padding: 8px 20px 0; }
      .mobile-menu__intro { padding: 18px 0 22px; border-bottom: 1px solid var(--line); }
      .mobile-menu__intro span { font-size: .62rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; color: var(--muted); }
      .mobile-menu__intro p { margin: 9px 0 0; color: var(--muted); font-size: .82rem; line-height: 1.55; }
      .mobile-nav__direct,
      .mobile-nav__toggle {
        width: 100%;
        min-height: 58px;
        display: grid;
        grid-template-columns: 30px 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 0;
        border: 0;
        border-bottom: 1px solid var(--line);
        background: transparent;
        text-align: left;
        font-size: .95rem;
        font-weight: 750;
        cursor: pointer;
      }
      .mobile-nav__index { color: var(--muted); font-size: .6rem; font-weight: 800; }
      .mobile-nav__plus { width: 16px; height: 16px; position: relative; }
      .mobile-nav__plus::before,
      .mobile-nav__plus::after { content: ""; position: absolute; left: 2px; top: 7px; width: 12px; height: 2px; background: currentColor; }
      .mobile-nav__plus::after { transform: rotate(90deg); transition: transform .2s ease; }
      .mobile-nav__toggle[aria-expanded="true"] .mobile-nav__plus::after { transform: rotate(0deg); }
      .mobile-nav__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .25s var(--ease); }
      .mobile-nav__panel > div { overflow: hidden; }
      .mobile-nav__group.is-open .mobile-nav__panel { grid-template-rows: 1fr; }
      .mobile-nav__panel a { display: block; margin: 8px 0; padding: 14px 15px; border-radius: 16px; background: var(--gray); }
      .mobile-nav__panel strong,
      .mobile-nav__panel small { display: block; }
      .mobile-nav__panel strong { font-size: .82rem; }
      .mobile-nav__panel small { margin-top: 5px; color: var(--muted); font-size: .66rem; line-height: 1.45; }
      .mobile-nav__panel a[aria-current="page"] { background: rgba(217,214,253,.42); }
      .mobile-menu__footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px 20px; }
      .mobile-menu__footer .btn { min-height: 50px; }
      .mobile-menu__footer > span { color: var(--muted); font-size: .65rem; }
  
      /* Hero */
      .hero {
        min-height: 100svh;
        display: grid;
        align-items: center;
        padding: 154px 0 92px;
        overflow: hidden;
        background:
          radial-gradient(circle at 81% 10%, rgba(217,214,253,.64), transparent 27%),
          radial-gradient(circle at 75% 76%, rgba(153,254,237,.44), transparent 30%),
          radial-gradient(circle at 7% 88%, rgba(255,189,155,.26), transparent 24%),
          linear-gradient(180deg, #fff 0%, #fbfbf8 100%);
      }
      .hero-grid { display: grid; grid-template-columns: minmax(0,.96fr) minmax(520px,1.04fr); align-items: center; gap: 56px; }
      .breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-bottom: 24px; color: var(--muted); font-size: .68rem; font-weight: 700; }
      .breadcrumb span { opacity: .55; }
      .hero-title {
        max-width: 760px;
        margin: 0;
        font-size: clamp(3.7rem, 6.25vw, 6.75rem);
        line-height: .94;
        letter-spacing: -.066em;
        font-weight: 800;
        text-wrap: balance;
      }
      .hero-title .accent { position: relative; z-index: 0; display: inline-block; }
      .hero-title .accent::after { content: ""; position: absolute; z-index: -1; left: -.04em; right: -.04em; bottom: .02em; height: .28em; border-radius: 999px; background: var(--lime); transform: rotate(-1deg); }
      .hero-subheadline { max-width: 660px; margin: 22px 0 0; color: var(--ink); font-size: clamp(1.22rem,1.65vw,1.64rem); font-weight: 750; line-height: 1.38; letter-spacing: -.028em; }
      .hero-copy { max-width: 675px; margin: 14px 0 0; color: var(--muted); font-size: clamp(1rem,1.25vw,1.14rem); line-height: 1.7; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 31px; }
      .hero-meta { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 26px; }
      .meta-pill { min-height: 37px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid rgba(32,33,36,.09); border-radius: 999px; background: rgba(255,255,255,.72); color: var(--muted); font-size: .67rem; font-weight: 750; }
      .meta-pill::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 4px rgba(194,255,2,.14); }
  
      .enterprise-art { min-height: 690px; position: relative; isolation: isolate; }
      .enterprise-art::before {
        content: "";
        position: absolute;
        z-index: -2;
        inset: 4% 2% 3% 5%;
        border-radius: 44% 56% 48% 52%;
        background: radial-gradient(circle at 50% 44%, rgba(255,255,255,.98), rgba(217,214,253,.62) 42%, rgba(153,254,237,.48) 66%, rgba(255,189,155,.30) 82%, transparent 84%);
        filter: blur(5px);
      }
      .enterprise-orbit { position: absolute; inset: 9% 3% 7% 5%; border: 1px dashed rgba(32,33,36,.16); border-radius: 50%; transform: rotate(-8deg); }
      .enterprise-orbit::before,
      .enterprise-orbit::after { content: ""; position: absolute; border: 1px solid rgba(32,33,36,.10); border-radius: 50%; }
      .enterprise-orbit::before { inset: 15%; }
      .enterprise-orbit::after { inset: 31%; border-style: dashed; }
  
      .enterprise-core {
        position: absolute;
        z-index: 8;
        left: 50%;
        top: 50%;
        width: 184px;
        height: 184px;
        display: grid;
        place-items: center;
        padding: 22px;
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 50%;
        background: var(--ink);
        color: var(--white);
        box-shadow: 0 28px 70px rgba(32,33,36,.22);
        transform: translate(-50%,-50%);
      }
      .enterprise-core::before { content: ""; position: absolute; inset: -12px; border: 1px dashed rgba(32,33,36,.18); border-radius: 50%; animation: spin 28s linear infinite; }
      .enterprise-core__copy { text-align: center; }
      .enterprise-core__copy small { display: block; color: rgba(255,255,255,.6); font-size: .57rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
      .enterprise-core__copy strong { display: block; margin-top: 8px; font-size: 1.34rem; line-height: 1.05; letter-spacing: -.035em; }
      .enterprise-core__pulse { position: absolute; width: 9px; height: 9px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 6px rgba(194,255,2,.12); }
      .enterprise-core__pulse--one { top: 18px; left: 48%; }
      .enterprise-core__pulse--two { bottom: 21px; right: 33px; background: var(--mint); box-shadow: 0 0 0 6px rgba(153,254,237,.13); }
  
      .enterprise-node {
        position: absolute;
        z-index: 6;
        min-width: 178px;
        display: grid;
        grid-template-columns: 44px 1fr;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 18px;
        background: rgba(255,255,255,.88);
        box-shadow: 0 18px 50px rgba(32,33,36,.12);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
        animation: nodeFloat 6.4s ease-in-out infinite;
      }
      .enterprise-node__icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 14px; background: var(--lime); font-size: .68rem; font-weight: 800; }
      .enterprise-node__icon svg { width: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .enterprise-node__copy strong,
      .enterprise-node__copy small { display: block; }
      .enterprise-node__copy strong { font-size: .74rem; }
      .enterprise-node__copy small { margin-top: 4px; color: var(--muted); font-size: .58rem; line-height: 1.35; }
      .enterprise-node--stores { left: 0; top: 14%; }
      .enterprise-node--stores .enterprise-node__icon { background: var(--lime); }
      .enterprise-node--punchout { right: 0; top: 12%; animation-delay: -1.2s; }
      .enterprise-node--punchout .enterprise-node__icon { background: var(--lavender); }
      .enterprise-node--orders { left: 1%; bottom: 16%; animation-delay: -2.1s; }
      .enterprise-node--orders .enterprise-node__icon { background: var(--peach); }
      .enterprise-node--accounting { right: -1%; bottom: 16%; animation-delay: -3.3s; }
      .enterprise-node--accounting .enterprise-node__icon { background: var(--mint); }
      .enterprise-node--suppliers { left: 50%; top: 2%; transform: translateX(-50%); animation-delay: -4.1s; }
      .enterprise-node--suppliers .enterprise-node__icon { background: var(--mint); }
      .enterprise-node--approvals { left: 50%; bottom: 2%; transform: translateX(-50%); animation-delay: -5.0s; }
      .enterprise-node--approvals .enterprise-node__icon { background: var(--lavender); }
  
      .flow-line { position: absolute; z-index: 2; height: 1px; transform-origin: left center; background: repeating-linear-gradient(90deg, rgba(32,33,36,.30) 0 5px, transparent 5px 10px); opacity: .45; }
      .flow-line::after { content: ""; position: absolute; top: -3px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--lime); animation: packet 4s linear infinite; }
      .flow-line--1 { width: 190px; left: 18%; top: 28%; transform: rotate(28deg); }
      .flow-line--2 { width: 190px; left: 52%; top: 30%; transform: rotate(-31deg); }
      .flow-line--3 { width: 190px; left: 18%; top: 69%; transform: rotate(-29deg); }
      .flow-line--4 { width: 190px; left: 52%; top: 67%; transform: rotate(31deg); }
      .flow-line--5 { width: 150px; left: 50%; top: 22%; transform: rotate(90deg); }
      .flow-line--6 { width: 150px; left: 50%; top: 53%; transform: rotate(90deg); }
      .flow-line--2::after { animation-delay: -1.3s; background: var(--mint); }
      .flow-line--3::after { animation-delay: -2.2s; background: var(--peach); }
      .flow-line--4::after { animation-delay: -3.0s; background: var(--lavender); }
      .flow-line--5::after { animation-delay: -1.8s; }
      .flow-line--6::after { animation-delay: -2.6s; background: var(--mint); }
  
      .enterprise-mini-dashboard {
        position: absolute;
        z-index: 10;
        right: 7%;
        top: 43%;
        width: 210px;
        padding: 14px;
        border: 1px solid rgba(255,255,255,.88);
        border-radius: 18px;
        background: rgba(255,255,255,.92);
        box-shadow: 0 20px 48px rgba(32,33,36,.14);
        transform: rotate(2deg);
      }
      .mini-dashboard__bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
      .mini-dashboard__bar span { color: var(--muted); font-size: .53rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
      .mini-dashboard__bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 4px rgba(194,255,2,.14); }
      .mini-dashboard__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: 12px; }
      .mini-dashboard__stat { padding: 10px; border-radius: 12px; background: var(--gray); }
      .mini-dashboard__stat strong { display: block; font-size: .86rem; }
      .mini-dashboard__stat small { display: block; margin-top: 4px; color: var(--muted); font-size: .48rem; }
  
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes nodeFloat { 0%,100% { margin-top: 0; } 50% { margin-top: -9px; } }
      @keyframes packet { from { left: 0; } to { left: calc(100% - 7px); } }
  
      /* Proof strip */
      .proof-strip { padding: 0 0 44px; background: linear-gradient(180deg,#fbfbf8 0%,#fff 100%); }
      .proof-panel { display: grid; grid-template-columns: 1.35fr repeat(3,1fr); overflow: hidden; border: 1px solid var(--line); border-radius: 28px; background: var(--white); box-shadow: var(--shadow-sm); }
      .proof-intro,
      .proof-item { padding: 25px 27px; }
      .proof-intro { background: linear-gradient(145deg,var(--lavender),rgba(153,254,237,.74)); }
      .proof-intro strong { display: block; max-width: 330px; font-size: 1.1rem; line-height: 1.3; letter-spacing: -.025em; }
      .proof-item { border-left: 1px solid var(--line); }
      .proof-item small,
      .proof-item strong { display: block; }
      .proof-item small { color: var(--muted); font-size: .59rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
      .proof-item strong { margin-top: 8px; font-size: .84rem; line-height: 1.4; }
  
      /* Sticky secondary navigation */
      .page-nav-wrap { position: sticky; z-index: 210; top: 90px; padding: 7px 0 12px; background: transparent; }
      .page-nav-shell { position: relative; border: 1px solid rgba(32,33,36,.08); border-radius: 999px; background: rgba(255,255,255,.9); box-shadow: 0 12px 34px rgba(32,33,36,.07); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
      .page-nav { display: flex; align-items: center; gap: 3px; padding: 7px; overflow-x: auto; scrollbar-width: none; }
      .page-nav::-webkit-scrollbar { display: none; }
      .page-nav a { flex: 0 0 auto; min-height: 38px; display: inline-flex; align-items: center; padding: 0 13px; border-radius: 999px; color: var(--muted); font-size: .68rem; font-weight: 750; white-space: nowrap; transition: background .2s ease,color .2s ease; }
      .page-nav a:hover,
      .page-nav a.is-active { color: var(--ink); background: var(--gray); }
      .page-nav__cta { margin-left: auto !important; color: var(--ink) !important; background: var(--lime) !important; }
      .page-nav-toggle { display: none; }
  
      /* Problem */
      .problem-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: 52px; }
      .problem-card { min-height: 350px; display: flex; flex-direction: column; padding: 29px; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgba(255,255,255,.88); box-shadow: 0 14px 40px rgba(32,33,36,.055); transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
      .problem-card:hover { transform: translateY(-7px); box-shadow: var(--shadow-sm); }
      .problem-card__number { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 14px; background: var(--lavender); font-size: .67rem; font-weight: 800; }
      .problem-card:nth-child(2) .problem-card__number { background: var(--peach); }
      .problem-card:nth-child(3) .problem-card__number { background: var(--mint); }
      .problem-card h3 {  font-size: clamp(1.6rem,2.35vw,2.35rem); line-height: 1.03; letter-spacing: -.045em; }
      .problem-card p {  color: var(--muted); font-size: .88rem; line-height: 1.66; }
      .problem-closer { max-width: 980px; margin: 68px auto 0; text-align: center; font-size: clamp(2.5rem,5vw,5rem); line-height: .99; letter-spacing: -.06em; font-weight: 800; }
      .problem-closer span { position: relative; z-index: 0; display: inline-block; }
      .problem-closer span::after { content: ""; position: absolute; z-index: -1; left: -.04em; right: -.04em; bottom: .02em; height: .29em; border-radius: 999px; background: var(--lime); }
  
      /* Platform */
      .platform-layout { display: grid; grid-template-columns: .82fr 1.18fr; gap: 72px; align-items: start; }
      .platform-sticky { position: sticky; top: 178px; }
      .platform-list { border-top: 1px solid var(--line); }
      .platform-item { display: grid; grid-template-columns: 50px 1fr; gap: 18px; padding: 27px 0; border-bottom: 1px solid var(--line); }
      .platform-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--white); border: 1px solid var(--line); }
      .platform-icon svg { width: 21px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .platform-item h3 { margin: 0; font-size: 1.29rem; letter-spacing: -.03em; }
      .platform-item p { margin: 9px 0 0; color: var(--muted); font-size: .88rem; line-height: 1.65; }
  
      /* Architecture */
      .architecture-panel { margin-top: 50px; padding: 38px; border: 1px solid rgba(255,255,255,.85); border-radius: var(--radius-xl); background: linear-gradient(145deg,rgba(217,214,253,.80),rgba(153,254,237,.57) 54%,rgba(255,189,155,.55)); box-shadow: var(--shadow-md); }
      .architecture-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
      .architecture-layer { min-height: 460px; padding: 28px; border-radius: 28px; background: rgba(255,255,255,.82); border: 1px solid rgba(255,255,255,.92); }
      .architecture-layer__top { display: flex; align-items: center; justify-content: space-between; gap: 15px; }
      .architecture-layer__top span:first-child { font-size: .64rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
      .architecture-layer__top span:last-child { min-width: 35px; height: 35px; display: grid; place-items: center; border-radius: 50%; background: var(--gray); font-size: .62rem; font-weight: 800; }
      .architecture-layer h3 { margin: 38px 0 0; font-size: clamp(1.8rem,2.5vw,2.7rem); line-height: 1; letter-spacing: -.05em; }
      .architecture-layer p { margin: 15px 0 0; color: var(--muted); font-size: .84rem; line-height: 1.65; }
      .architecture-stack { display: grid; gap: 9px; margin-top: 28px; }
      .architecture-chip { min-height: 52px; display: flex; align-items: center; gap: 11px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 15px; background: var(--white); font-size: .72rem; font-weight: 750; }
      .architecture-chip i { width: 9px; height: 9px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 4px rgba(194,255,2,.13); }
      .architecture-layer:nth-child(2) .architecture-chip i { background: var(--lavender); box-shadow: 0 0 0 4px rgba(217,214,253,.32); }
      .architecture-layer:nth-child(3) .architecture-chip i { background: var(--mint); box-shadow: 0 0 0 4px rgba(153,254,237,.25); }
      .architecture-note { margin: 22px 0 0; color: rgba(32,33,36,.70); font-size: .78rem; line-height: 1.55; }
  
      /* Capabilities */
      .capability-grid { display: grid; grid-template-columns: repeat(12,1fr); gap: 18px; margin-top: 52px; }
      .capability-card { min-height: 310px; position: relative; overflow: hidden; padding: 28px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--white); box-shadow: 0 14px 38px rgba(32,33,36,.05); }
      .capability-card--wide { grid-column: span 7; }
      .capability-card--medium { grid-column: span 5; }
      .capability-card--half { grid-column: span 6; }
      .capability-card--mint { background: linear-gradient(145deg,rgba(153,254,237,.56),#fff 76%); }
      .capability-card--lavender { background: linear-gradient(145deg,rgba(217,214,253,.74),#fff 76%); }
      .capability-card--peach { background: linear-gradient(145deg,rgba(255,189,155,.60),#fff 78%); }
      .capability-card__index { color: var(--muted); font-size: .62rem; font-weight: 800; letter-spacing: .1em; }
      .capability-card h3 { max-width: 540px; margin: 36px 0 0; font-size: clamp(1.8rem,3vw,3.25rem); line-height: .99; letter-spacing: -.052em; }
      .capability-card p { max-width: 540px; margin: 16px 0 0; color: var(--muted); font-size: .86rem; line-height: 1.65; }
      .capability-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 25px; }
      .capability-tags span { padding: 8px 10px; border: 1px solid rgba(32,33,36,.10); border-radius: 999px; background: rgba(255,255,255,.68); font-size: .6rem; font-weight: 750; }
      .capability-visual { position: absolute; right: -18px; bottom: -15px; width: 180px; height: 170px; border-radius: 34px 0 0 0; background: rgba(255,255,255,.56); border: 1px solid rgba(255,255,255,.9); transform: rotate(-4deg); }
      .capability-visual::before,
      .capability-visual::after { content: ""; position: absolute; border-radius: 50%; }
      .capability-visual::before { width: 52px; height: 52px; left: 25px; top: 28px; background: var(--lime); }
      .capability-visual::after { width: 84px; height: 14px; left: 26px; top: 100px; border-radius: 999px; background: rgba(32,33,36,.15); box-shadow: 0 24px 0 rgba(32,33,36,.09); }
  
      /* Systems */
      .systems-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-top: 48px; }
      .system-group { padding: 25px; border: 1px solid var(--line); border-radius: 22px; background: var(--white); }
      .system-group h3 { margin: 0; font-size: 1rem; letter-spacing: -.02em; }
      .system-group ul { display: grid; gap: 9px; margin: 19px 0 0; padding: 0; list-style: none; }
      .system-group li { min-height: 38px; display: flex; align-items: center; gap: 9px; padding: 0 11px; border-radius: 11px; background: var(--gray); color: rgba(32,33,36,.76); font-size: .7rem; font-weight: 700; }
      .system-group li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--lime); }
      .systems-note { max-width: 820px; margin: 34px 0 0; font-size: 1.15rem; line-height: 1.55; letter-spacing: -.02em; font-weight: 700; }
  
      /* Workflow */
      .workflow-board { margin-top: 52px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-xl); background: #fff; box-shadow: var(--shadow-sm); }
      .workflow-track { display: grid; grid-template-columns: repeat(6,1fr); gap: 9px; }
      .workflow-step { min-height: 300px; position: relative; padding: 22px; border-radius: 22px; background: var(--gray); overflow: hidden; }
      .workflow-step:nth-child(2) { background: rgba(217,214,253,.52); }
      .workflow-step:nth-child(3) { background: rgba(153,254,237,.48); }
      .workflow-step:nth-child(4) { background: rgba(255,189,155,.45); }
      .workflow-step:nth-child(5) { background: rgba(217,214,253,.38); }
      .workflow-step:nth-child(6) { background: rgba(194,255,2,.40); }
      .workflow-step__index { display: block; color: var(--muted); font-size: .58rem; font-weight: 800; letter-spacing: .1em; }
      .workflow-step h3 { margin: 70px 0 0; font-size: 1.15rem; line-height: 1.08; letter-spacing: -.035em; }
      .workflow-step p { margin: 10px 0 0; color: var(--muted); font-size: .68rem; line-height: 1.55; }
      .workflow-step__dot { position: absolute; left: 22px; bottom: 24px; width: 10px; height: 10px; border-radius: 50%; background: var(--ink); }
      .workflow-step:not(:last-child)::after { content: "→"; position: absolute; z-index: 2; right: -16px; top: 50%; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--white); border: 1px solid var(--line); transform: translateY(-50%); font-size: .78rem; font-weight: 800; }
  
      /* Use cases */
      .use-case-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 18px; margin-top: 50px; }
      .use-case-card { min-height: 310px; padding: 30px; border: 1px solid var(--line); border-radius: 28px; background: var(--white); }
      .use-case-card__top { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
      .use-case-card__icon { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 15px; background: var(--lime); }
      .use-case-card:nth-child(2) .use-case-card__icon { background: var(--lavender); }
      .use-case-card:nth-child(3) .use-case-card__icon { background: var(--mint); }
      .use-case-card:nth-child(4) .use-case-card__icon { background: var(--peach); }
      .use-case-card__icon svg { width: 23px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .use-case-card__top small { color: var(--muted); font-size: .6rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
      .use-case-card h3 { max-width: 500px; margin: 46px 0 0; font-size: clamp(1.7rem,2.6vw,2.8rem); line-height: 1; letter-spacing: -.05em; }
      .use-case-card p { max-width: 520px; margin: 15px 0 0; color: var(--muted); font-size: .84rem; line-height: 1.64; }
  
      /* Proof / case study */
      .case-panel { display: grid; grid-template-columns: .9fr 1.1fr; gap: 40px; padding: 46px; border-radius: var(--radius-xl); background: var(--ink); color: var(--white); overflow: hidden; position: relative; }
      .case-panel::after { content: ""; position: absolute; width: 560px; height: 560px; right: -220px; top: -230px; border-radius: 50%; background: radial-gradient(circle,rgba(194,255,2,.28),rgba(153,254,237,.15) 44%,transparent 70%); }
      .case-panel .eyebrow { color: rgba(255,255,255,.54); }
      .case-panel h2 { max-width: 600px; margin: 0; font-size: clamp(2.9rem,5.2vw,5.4rem); line-height: .98; letter-spacing: -.06em; }
      .case-panel p { max-width: 610px; margin: 23px 0 0; color: rgba(255,255,255,.66); font-size: .95rem; line-height: 1.7; }
      .case-stats { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-content: center; }
      .case-stat { min-height: 170px; padding: 24px; border: 1px solid rgba(255,255,255,.12); border-radius: 24px; background: rgba(255,255,255,.07); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
      .case-stat strong { display: block; color: var(--lime); font-size: clamp(2.3rem,4vw,4.1rem); letter-spacing: -.06em; }
      .case-stat span { display: block; margin-top: 12px; color: rgba(255,255,255,.65); font-size: .68rem; line-height: 1.45; }
      .case-note { grid-column: 1/-1; color: rgba(255,255,255,.46); font-size: .58rem; line-height: 1.5; }
  
      /* Process */
      .process-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-top: 49px; }
      .process-card { min-height: 330px; display: flex; flex-direction: column; padding: 27px; border: 1px solid var(--line); border-radius: 24px; background: var(--white); }
      .process-card__index { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 14px; background: var(--gray); font-size: .68rem; font-weight: 800; }
      .process-card:nth-child(2) .process-card__index { background: var(--lavender); }
      .process-card:nth-child(3) .process-card__index { background: var(--mint); }
      .process-card:nth-child(4) .process-card__index { background: var(--lime); }
      .process-card h3 { margin: auto 0 0; font-size: 1.42rem; letter-spacing: -.035em; }
      .process-card p { margin: 13px 0 0; color: var(--muted); font-size: .82rem; line-height: 1.6; }
  
      /* FAQ */
      .faq-layout { display: grid; grid-template-columns: .78fr 1.22fr; gap: 70px; align-items: start; }
      .faq-heading { position: sticky; top: 175px; }
      .faq-list { border-top: 1px solid var(--line); }
      .faq-item { border-bottom: 1px solid var(--line); }
      .faq-item summary { min-height: 84px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 24px; list-style: none; cursor: pointer; font-size: 1.08rem; font-weight: 750; letter-spacing: -.025em; }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary::after { content: "+"; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: var(--gray); font-size: 1.1rem; transition: transform .22s ease,background .22s ease; }
      .faq-item[open] summary::after { transform: rotate(45deg); background: var(--lime); }
      .faq-item p { max-width: 700px; margin: -5px 0 28px; color: var(--muted); font-size: .87rem; line-height: 1.7; }
  
      /* Final CTA */
      .final-cta { position: relative; overflow: hidden; padding: 70px; border-radius: 44px; background: linear-gradient(135deg,var(--lavender),var(--mint) 56%,var(--peach)); }
      .final-cta::before { content: ""; position: absolute; width: 540px; height: 540px; right: -180px; top: -250px; border-radius: 50%; background: rgba(255,255,255,.33); }
      .final-cta__content { position: relative; z-index: 2; max-width: 820px; }
      .final-cta h2 { margin: 0; font-size: clamp(3rem,6.6vw,6.5rem); line-height: .95; letter-spacing: -.066em; }
