        .page-nav-toggle__icon::before { content: ""; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: translateY(-2px) rotate(45deg); }
        .page-nav-shell.is-open .page-nav-toggle__icon { transform: rotate(180deg); }
