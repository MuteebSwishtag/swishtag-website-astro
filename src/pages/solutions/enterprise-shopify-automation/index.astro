          z-index: 270;
          left: 12px;
          right: 12px;
          bottom: max(12px, env(safe-area-inset-bottom));
          display: block;
          padding: 8px;
          border: 1px solid rgba(255,255,255,.88);
          border-radius: 999px;
          background: rgba(255,255,255,.90);
          box-shadow: 0 18px 45px rgba(32,33,36,.17);
