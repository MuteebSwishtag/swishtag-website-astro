  .customer-story-v5__scope > div { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
  .customer-story-v5__scope b { padding:8px 10px; border:1px solid rgba(32,33,36,.08); border-radius:999px; background:rgba(255,255,255,.62); font-size:.61rem; }
  .customer-story-v5__link { margin-top:auto; padding-top:28px; }
  
  /* Onboarding */
  .onboarding-section {
    background:
      radial-gradient(circle at 92% 8%, rgba(217,214,253,.30), transparent 25%),
      radial-gradient(circle at 7% 85%, rgba(153,254,237,.24), transparent 24%),
      linear-gradient(180deg,#f7f7f4 0%,#fff 100%);
    overflow:hidden;
  }
  .onboarding-heading { max-width: 980px; margin:0 auto; text-align:center; }
  .onboarding-heading .section-copy { margin-inline:auto; max-width:780px; }
  .onboarding-start {
    display:grid;
    grid-template-columns:.34fr .66fr;
    gap:28px;
    align-items:center;
    margin-top:48px;
    padding:26px 30px;
    border:1px solid rgba(32,33,36,.08);
    border-radius:28px;
    background:var(--ink);
    color:#fff;
    box-shadow:0 22px 60px rgba(32,33,36,.10);
  }
  .onboarding-start__label span,.onboarding-start__label strong { display:block; }
  .onboarding-start__label span { color:var(--lime); font-size:.62rem; font-weight:800; text-transform:uppercase; letter-spacing:.1em; }
  .onboarding-start__label strong { margin-top:7px; font-size:1.45rem; letter-spacing:-.03em; }
  .onboarding-start__items { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
  .onboarding-start__items > div { min-height:120px; padding:16px; border:1px solid rgba(255,255,255,.10); border-radius:18px; background:rgba(255,255,255,.06); }
  .onboarding-start__items span,.onboarding-start__items strong,.onboarding-start__items small { display:block; }
  .onboarding-start__items span { color:var(--lime); font-size:.58rem; font-weight:800; }
  .onboarding-start__items strong { margin-top:12px; font-size:.82rem; line-height:1.35; }
  .onboarding-start__items small { margin-top:6px; color:rgba(255,255,255,.58); font-size:.66rem; line-height:1.45; }
  .onboarding-journey { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-top:22px; position:relative; }
  .onboarding-journey::before { content:""; position:absolute; left:8%; right:8%; top:31px; height:1px; background:linear-gradient(90deg,transparent,rgba(32,33,36,.15) 10%,rgba(32,33,36,.15) 90%,transparent); }
  .onboarding-step {
    position:relative;
    min-height:430px;
    display:flex;
    flex-direction:column;
    padding:22px;
    border:1px solid rgba(32,33,36,.08);
    border-radius:24px;
    background:rgba(255,255,255,.90);
    box-shadow:0 12px 32px rgba(32,33,36,.04);
    transition:transform .35s var(--ease), box-shadow .35s var(--ease), background .35s ease;
  }
  .onboarding-step:nth-child(2) { background:#f3f0ff; }
  .onboarding-step:nth-child(3) { background:#edfff9; }
  .onboarding-step:nth-child(4) { background:#fff2e9; }
