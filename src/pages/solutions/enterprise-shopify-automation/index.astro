  }
  
  /* ==========================================================
     Enterprise Company Store Automation V3 refinements
     ========================================================== */
  :root { --page-nav-top: 96px; --navigation-width: min(1240px, calc(100vw - 48px)); }
  
  /* Above-the-fold hero */
  .hero {
    min-height: min(100svh, 860px);
    padding: 124px 0 44px;
  }
  .hero-grid { grid-template-columns: minmax(0, .98fr) minmax(470px, 1.02fr); gap: 40px; }
  .hero-title { max-width: 690px; font-size: clamp(3.35rem, 5.15vw, 5.8rem); line-height: .95; }
  .hero-subheadline { max-width: 620px; margin-top: 16px; font-size: clamp(1.12rem, 1.4vw, 1.42rem); }
  .hero-copy { max-width: 620px; margin-top: 11px; font-size: .98rem; line-height: 1.6; }
  .hero-actions { margin-top: 23px; }
  .hero-meta { margin-top: 18px; }
  .enterprise-art { min-height: 560px; transform: scale(.94); transform-origin: center center; }
  
  /* Trust strip */
  .proof-strip { padding: 0 0 38px; background: linear-gradient(180deg,#fbfbf8 0%,#fff 100%); }
  .proof-panel { grid-template-columns: minmax(260px,1.2fr) repeat(3,1fr); }
  .proof-intro, .proof-item { padding: 22px 24px; }
  .proof-intro { background: linear-gradient(145deg, var(--mint), rgba(217,214,253,.78)); }
  
  /* Connected primary + secondary navigation, matched to SAGE page */
  .site-header,
  .site-header.is-scrolled,
  .site-header.is-nav-connected { z-index: 320 !important; }
  .modern-nav { width: var(--navigation-width) !important; max-width: none !important; transition: border-radius .28s var(--ease), min-height .28s var(--ease), padding .28s var(--ease), box-shadow .22s ease; }
  .mega-menu { z-index: 360 !important; }
  .page-nav-wrap,
  .page-nav-wrap.is-stuck {
    top: var(--page-nav-top);
    z-index: 210 !important;
    padding: 7px 0 12px;
    background: transparent !important;
    border: 0 !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
  }
  .page-nav-wrap > .page-shell { width: var(--navigation-width) !important; max-width: none !important; }
  .page-nav-shell { width: 100%; min-height: 52px; padding: 6px 8px 6px 17px; border-radius: 999px; transition: border-radius .28s var(--ease), box-shadow .25s ease, background .25s ease; }
  .site-header.is-nav-connected { padding-bottom: 0; }
  .site-header.is-nav-connected .modern-nav {
    min-height: 60px;
    border-color: rgba(32,33,36,.085);
    border-bottom-color: transparent;
    border-radius: 24px 24px 0 0;
    background: rgba(255,255,255,.97);
    box-shadow: none;
  }
  .page-nav-wrap.is-stuck { padding-top: 0; }
  .page-nav-wrap.is-stuck .page-nav-shell {
    position: relative;
    margin-top: -2px;
    border-color: rgba(32,33,36,.085);
    border-top-color: transparent;
    border-radius: 0 0 24px 24px;
    background: rgba(255,255,255,.97);
    box-shadow: 0 20px 48px rgba(32,33,36,.105);
  }
  .page-nav-wrap.is-stuck .page-nav-shell::before {
    content:""; position:absolute; z-index:0; left:-1px; right:-1px; top:-5px; height:7px; background:rgba(255,255,255,.97); pointer-events:none;
  }
  .page-nav-shell > * { position: relative; z-index: 1; }
  
  /* Problem closer */
  .problem-closer-card {
    max-width: 1040px;
    margin: 58px auto 0;
    display: grid;
    grid-template-columns: 7px minmax(0,1fr) auto;
    align-items: center;
    gap: 28px;
    padding: 28px 30px 28px 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(245,245,243,.95));
    box-shadow: var(--shadow-sm);
  }
  .problem-closer-card__accent { align-self: stretch; width: 7px; min-height: 120px; background: var(--lime); border-radius: 0 999px 999px 0; }
  .problem-closer-card__label { display:block; color:var(--muted); font-size:.62rem; font-weight:800; letter-spacing:.11em; text-transform:uppercase; }
  .problem-closer-card p { margin:8px 0 0; font-size:.9rem; font-weight:750; }
  .problem-closer-card h3 { max-width:760px; margin:7px 0 0; font-size:clamp(1.55rem,2.3vw,2.45rem); line-height:1.12; letter-spacing:-.04em; }
  .problem-closer-card__tags { display:grid; gap:7px; }
  .problem-closer-card__tags span { min-width:105px; padding:9px 12px; border-radius:999px; background:#fff; border:1px solid var(--line); font-size:.62rem; font-weight:800; text-align:center; }
  
  /* Base + add-on package explanation */
  .package-explainer { margin-top: 52px; display:grid; grid-template-columns:minmax(0,1fr) 80px minmax(0,1fr); align-items:stretch; gap:18px; }
  .package-card { min-height: 430px; padding:32px; border:1px solid var(--line); border-radius:32px; background:#fff; box-shadow:var(--shadow-sm); }
  .package-card--base { background: linear-gradient(145deg, rgba(194,255,2,.22), #fff 48%); border-color:rgba(32,33,36,.14); }
  .package-card--addons { background: linear-gradient(145deg, rgba(217,214,253,.48), rgba(153,254,237,.24)); }
  .package-card__top { display:flex; align-items:center; justify-content:space-between; gap:12px; color:var(--muted); font-size:.64rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .package-badge { display:inline-flex; align-items:center; min-height:29px; padding:0 10px; border-radius:999px; font-size:.58rem; }
  .package-badge--included { background:var(--lime); color:var(--ink); }
  .package-badge--optional { background:#fff; color:var(--ink); border:1px solid var(--line); }
  .package-card h3 { max-width:500px; margin:34px 0 0; font-size:clamp(2rem,3vw,3.25rem); line-height:1; letter-spacing:-.055em; }
  .package-card p { max-width:550px; margin:17px 0 0; color:var(--muted); font-size:.9rem; line-height:1.65; }
  .package-card ul { display:grid; gap:0; margin:28px 0 0; padding:0; list-style:none; border-top:1px solid rgba(32,33,36,.11); }
  .package-card li { position:relative; padding:15px 0 15px 25px; border-bottom:1px solid rgba(32,33,36,.11); font-size:.78rem; font-weight:750; }
  .package-card li::before { content:""; position:absolute; left:0; top:50%; width:8px; height:8px; transform:translateY(-50%); border-radius:50%; background:var(--lime); }
  .package-card--addons li::before { background:var(--ink); }
  .package-plus { display:grid; place-items:center; align-content:center; gap:8px; }
  .package-plus span { width:54px; height:54px; display:grid; place-items:center; border-radius:50%; background:var(--ink); color:#fff; font-size:1.4rem; font-weight:500; box-shadow:var(--shadow-sm); }
  .package-plus small { color:var(--muted); font-size:.56rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; text-align:center; }
  
  /* Add-on section UX */
  .addon-heading { display:grid; grid-template-columns:1fr auto; align-items:end; gap:36px; }
  .addon-heading .section-title { max-width:900px; }
  .addon-heading__note { max-width:310px; padding:18px 20px; border:1px solid rgba(32,33,36,.1); border-radius:18px; background:#fff; }
  .addon-heading__note span, .addon-heading__note strong { display:block; }
  .addon-heading__note span { color:var(--muted); font-size:.62rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; }
  .addon-heading__note strong { margin-top:7px; font-size:.86rem; line-height:1.4; }
  .addon-legend { display:flex; flex-wrap:wrap; gap:8px; margin-top:30px; }
  .addon-legend > span { display:inline-flex; align-items:center; gap:8px; min-height:34px; padding:0 11px; border:1px solid var(--line); border-radius:999px; background:#fff; color:var(--muted); font-size:.62rem; font-weight:750; }
  .addon-dot { width:8px; height:8px; border-radius:50%; background:var(--ink); }
  .addon-dot--ops { background:var(--lavender); } .addon-dot--data{background:var(--mint);} .addon-dot--finance{background:var(--peach);} .addon-dot--procurement{background:var(--lime);} .addon-dot--ai{background:var(--ink);}
  .capability-grid--addons { margin-top:20px; }
  .addon-card { display:flex; flex-direction:column; }
  .addon-card__top { display:flex; align-items:center; justify-content:space-between; gap:15px; }
  .addon-type { font-size:.61rem; font-weight:800; letter-spacing:.09em; text-transform:uppercase; }
  .addon-number { width:36px; height:36px; display:grid; place-items:center; flex:0 0 36px; border-radius:12px; background:rgba(255,255,255,.6); border:1px solid rgba(32,33,36,.09); font-size:.6rem; font-weight:800; }
  .addon-card h3 { margin-top:34px; }
  .addon-outcome { margin-top:auto; padding-top:22px; }
  .addon-outcome small { display:block; color:var(--muted); font-size:.58rem; font-weight:800; text-transform:uppercase; letter-spacing:.09em; }
  .addon-outcome strong { display:block; max-width:530px; margin-top:7px; font-size:.8rem; line-height:1.5; }
  .addon-card--custom { background:linear-gradient(135deg,var(--lavender),rgba(153,254,237,.5),rgba(255,189,155,.35)); }
  .addon-principle { margin-top:18px; display:flex; align-items:center; gap:12px; padding:18px 20px; border-radius:18px; background:var(--ink); color:#fff; }
  .addon-principle strong { color:var(--lime); font-size:.8rem; }
  .addon-principle span { color:rgba(255,255,255,.72); font-size:.76rem; line-height:1.5; }
  
  /* Integration groups */
  .systems-grid--five { grid-template-columns:repeat(5,1fr); }
  .system-group { min-height:285px; }
  .system-group__label { display:inline-flex; margin-bottom:14px; padding:6px 9px; border-radius:999px; background:var(--gray); color:var(--muted); font-size:.55rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .system-group:nth-child(2) .system-group__label { background:rgba(255,189,155,.4); }
  .system-group:nth-child(3) .system-group__label { background:rgba(194,255,2,.45); }
  .system-group:nth-child(4) .system-group__label { background:rgba(153,254,237,.5); }
  .system-group--ai { background:var(--ink); color:#fff; }
  .system-group--ai .system-group__label { background:rgba(255,255,255,.12); color:rgba(255,255,255,.68); }
  .system-group--ai li { background:rgba(255,255,255,.08); color:rgba(255,255,255,.82); }
  .integration-callout { margin-top:24px; display:grid; grid-template-columns:52px 1fr auto; align-items:center; gap:18px; padding:20px 22px; border:1px solid var(--line); border-radius:22px; background:linear-gradient(135deg,rgba(217,214,253,.3),rgba(153,254,237,.2)); }
  .integration-callout__mark { width:48px; height:48px; display:grid; place-items:center; border-radius:15px; background:var(--lime); font-size:1.1rem; font-weight:800; }
  .integration-callout strong { font-size:.9rem; }
  .integration-callout p { margin:5px 0 0; color:var(--muted); font-size:.72rem; line-height:1.55; }
  .integration-callout .text-link { margin:0; white-space:nowrap; }
  
  /* Order flow arrow visibility */
  .workflow-track { gap:18px; }
  .workflow-step { overflow:visible; }
  .workflow-step:not(:last-child)::after {
    right:-27px; width:36px; height:36px; z-index:20; border:1px solid rgba(32,33,36,.16); background:#fff; box-shadow:0 7px 18px rgba(32,33,36,.12); font-size:.92rem;
  }
  .workflow-board { overflow:visible; }
  
  /* Club Colors success story */
  .case-panel--club { grid-template-columns:1.02fr .98fr; min-height:560px; background:linear-gradient(145deg,#202124,#292b30 68%,#22252a); }
  .case-panel--club::before { content:""; position:absolute; width:220px; height:220px; left:-70px; bottom:-90px; border-radius:50%; background:rgba(217,214,253,.12); }
  .case-panel__copy { position:relative; z-index:2; display:flex; flex-direction:column; align-items:flex-start; }
  .case-panel__copy .btn { margin-top:28px; }
  .case-panel__bridge { margin-top:15px !important; color:rgba(255,255,255,.88) !important; font-weight:700; }
  .case-stat strong { font-size:clamp(2rem,3.4vw,3.5rem); }
  
  /* SAGE-family final CTA */
  .final-cta-section { padding:82px 0 96px; background:#fff; }
  .final-cta { min-height:570px; display:grid; grid-template-columns:1.05fr .95fr; align-items:center; gap:40px; padding:62px; border-radius:44px; background:radial-gradient(circle at 88% 10%,rgba(255,255,255,.86),transparent 26%),linear-gradient(140deg,var(--mint),var(--lavender) 54%,var(--peach)); box-shadow:var(--shadow-lg); }
  .final-cta::before { display:none; }
  .final-cta__content { max-width:none; }
  .final-cta h2 { max-width:760px; font-size:clamp(3.1rem,5.6vw,5.9rem); }
  .final-cta p { max-width:660px; }
  .final-cta__benefits { display:flex; flex-wrap:wrap; gap:8px; margin-top:25px; }
  .final-cta__benefits span { display:inline-flex; min-height:34px; align-items:center; padding:0 11px; border:1px solid rgba(32,33,36,.1); border-radius:999px; background:rgba(255,255,255,.55); font-size:.61rem; font-weight:800; }
  .final-visual { min-height:390px; position:relative; }
  .final-visual__orbit { position:absolute; border:1px solid rgba(32,33,36,.16); border-radius:50%; }
  .final-visual__orbit--one { inset:5% 7% 7% 5%; animation:finalOrbit 8s ease-in-out infinite; }
  .final-visual__orbit--two { inset:20% 23%; border-style:dashed; animation:finalOrbit 8s ease-in-out infinite reverse; }
  .final-visual__core { position:absolute; left:50%; top:50%; width:160px; height:160px; display:grid; place-items:center; align-content:center; padding:22px; transform:translate(-50%,-50%); border-radius:50%; background:var(--ink); color:#fff; text-align:center; box-shadow:0 24px 55px rgba(32,33,36,.2); }
  .final-visual__core small { color:rgba(255,255,255,.55); font-size:.55rem; font-weight:800; letter-spacing:.1em; }
  .final-visual__core strong { margin-top:7px; font-size:1rem; line-height:1.15; }
  .final-visual__chip { position:absolute; min-width:84px; display:grid; place-items:center; min-height:42px; padding:0 13px; border-radius:999px; border:1px solid rgba(255,255,255,.8); background:rgba(255,255,255,.82); box-shadow:0 12px 30px rgba(32,33,36,.1); font-size:.65rem; font-weight:800; backdrop-filter:blur(9px); animation:chipFloat 5s ease-in-out infinite; }
  .final-visual__chip--one { left:3%; top:24%; } .final-visual__chip--two { right:6%; top:16%; animation-delay:-1s; } .final-visual__chip--three { right:0; bottom:23%; animation-delay:-2s; } .final-visual__chip--four { left:8%; bottom:15%; animation-delay:-3s; } .final-visual__chip--five { left:42%; top:2%; animation-delay:-4s; }
  @keyframes finalOrbit { 50% { transform:rotate(3deg) scale(1.02); } }
  @keyframes chipFloat { 50% { transform:translateY(-7px); } }
  
  @media (max-width:1180px) {
