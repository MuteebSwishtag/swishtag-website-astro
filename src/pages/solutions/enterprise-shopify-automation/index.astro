  <script slot="scripts" is:inline>
  (() => {
    const art = document.querySelector('.enterprise-art--dashboard');
    const browser = art?.querySelector('.dashboard-browser-mockup--simple');
    const trigger = art?.querySelector('.dashboard-browser-trigger');
    const viewport = art?.querySelector('.dashboard-browser-mockup__viewport--simple');
    const dashboard = art?.querySelector('.simple-dashboard-image');
    const grid = art?.querySelector('.control-center-grid');
    const nodes = art ? Array.from(art.querySelectorAll('.enterprise-node')) : [];
    if (!art || !browser || !trigger || !viewport || !dashboard || !grid || nodes.length !== 6) return;
  
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const duration = 780;
    let packed = false;
    let busy = false;
    let targets = [];
  
    const createGrid = () => {
      grid.innerHTML = '';
      nodes.forEach((node) => {
        const item = document.createElement('div');
        item.className = 'control-center-item';
        const icon = document.createElement('span');
        icon.className = 'control-center-item__icon';
        const sourceIcon = node.querySelector('.enterprise-node__icon');
        if (sourceIcon) icon.innerHTML = sourceIcon.innerHTML;
        const title = document.createElement('strong');
        title.textContent = node.querySelector('.enterprise-node__copy strong')?.textContent?.trim() || '';
        item.append(icon, title);
        grid.append(item);
      });
    };
  
    const measureTargets = () => {
      const items = Array.from(grid.children);
      targets = items.map(item => item.getBoundingClientRect());
    };
  
    const animateNodeToTarget = (node, target, inward) => {
      const rect = node.getBoundingClientRect();
      const dx = target.left + target.width / 2 - (rect.left + rect.width / 2);
      const dy = target.top + target.height / 2 - (rect.top + rect.height / 2);
      const scale = Math.min(target.width / rect.width, target.height / rect.height) * .9;
      const keyframes = inward
        ? [
            { translate: '0px 0px', scale: '1', opacity: 1 },
            { translate: `${dx}px ${dy}px`, scale: `${scale}`, opacity: 1, offset: .82 },
            { translate: `${dx}px ${dy}px`, scale: `${scale}`, opacity: 0 }
          ]
        : [
            { translate: `${dx}px ${dy}px`, scale: `${scale}`, opacity: 0 },
            { translate: `${dx}px ${dy}px`, scale: `${scale}`, opacity: 1, offset: .14 },
            { translate: '0px 0px', scale: '1', opacity: 1 }
          ];
  
      return node.animate(keyframes, {
        duration,
        easing: 'cubic-bezier(.18,.88,.24,1)',
        fill: 'both'
      });
    };
  
    const pack = async () => {
      if (busy || packed) return;
      busy = true;
      art.classList.add('is-transitioning', 'is-packing');
      trigger.setAttribute('aria-pressed', 'true');
      trigger.setAttribute('aria-label', 'Close the Control Center. Click to return the tools to their floating positions.');
  
      grid.style.visibility = 'hidden';
      grid.style.opacity = '0';
      measureTargets();
  
      const animations = nodes.map((node, i) => animateNodeToTarget(node, targets[i], true));
  
      const gridAnimation = grid.animate(
        [{ opacity: 0 }, { opacity: 0, offset: .55 }, { opacity: 1 }],
        { duration, easing: 'ease-out', fill: 'both' }
      );
      grid.style.visibility = 'visible';
  
      await Promise.allSettled([...animations.map(a => a.finished), gridAnimation.finished]);
      animations.forEach(a => a.cancel());
      gridAnimation.cancel();
      packed = true;
      art.classList.remove('is-packing', 'is-transitioning');
      art.classList.add('is-packed');
      grid.style.removeProperty('visibility');
      grid.style.removeProperty('opacity');
      busy = false;
    };
  
    const unpack = async () => {
      if (busy || !packed) return;
      busy = true;
      art.classList.add('is-transitioning', 'is-unpacking');
      art.classList.remove('is-packed');
      trigger.setAttribute('aria-pressed', 'false');
      trigger.setAttribute('aria-label', 'Open the Control Center. Click to bring the connected company-store tools inside the dashboard.');
  
      grid.style.visibility = 'visible';
      grid.style.opacity = '1';
      measureTargets();
  
      const animations = nodes.map((node, i) => animateNodeToTarget(node, targets[i], false));
      const gridAnimation = grid.animate(
        [{ opacity: 1 }, { opacity: 0, offset: .34 }, { opacity: 0 }],
        { duration: Math.round(duration * .72), easing: 'ease-in', fill: 'both' }
      );
  
      await Promise.allSettled([...animations.map(a => a.finished), gridAnimation.finished]);
      animations.forEach(a => a.cancel());
      gridAnimation.cancel();
      packed = false;
      art.classList.remove('is-unpacking', 'is-transitioning');
      grid.style.removeProperty('visibility');
      grid.style.removeProperty('opacity');
      busy = false;
    };
  
    const toggle = () => {
      window.swishtagTrack?.(packed ? 'control_center_close' : 'control_center_open', {
        component: 'hero_control_center'
      });
  
      if (reduceMotion.matches) {
        packed = !packed;
        art.classList.toggle('is-packed', packed);
        trigger.setAttribute('aria-pressed', String(packed));
        trigger.setAttribute('aria-label', packed
          ? 'Close the Control Center. Click to return the tools to their floating positions.'
          : 'Open the Control Center. Click to bring the connected company-store tools inside the dashboard.');
        return;
      }
      packed ? unpack() : pack();
    };
  
    createGrid();
    trigger.addEventListener('click', toggle);
  
    window.addEventListener('resize', () => {
      if (busy) return;
      if (packed) requestAnimationFrame(measureTargets);
    }, { passive: true });
  })();
  </script>
  <script slot="scripts" is:inline>
  (() => {
    const track = (eventName, parameters = {}) => {
      const payload = {
        page_type: 'enterprise_company_store_automation',
        ...parameters
      };
  
      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, payload);
      } else {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: eventName, ...payload });
      }
  
      window.dispatchEvent(new CustomEvent('swishtag:analytics', {
        detail: { event: eventName, ...payload }
      }));
    };
  
    window.swishtagTrack = track;
  
    document.addEventListener('click', event => {
      const target = event.target.closest('[data-analytics-event]');
      if (!target) return;
  
      track(target.dataset.analyticsEvent, {
        link_text: target.textContent.trim().replace(/\s+/g, ' ').slice(0, 120),
        link_url: target.getAttribute('href') || ''
      });
    });
  
    document.querySelectorAll('.faq-item').forEach(item => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        track('faq_open', {
          question: item.querySelector('summary')?.textContent?.trim() || ''
        });
      });
    });
  
    const seenAddons = new WeakSet();
    const addonObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting || seenAddons.has(entry.target)) return;
        seenAddons.add(entry.target);
        track('addon_view', {
          addon_name: entry.target.querySelector('h3')?.textContent?.trim() || ''
        });
        addonObserver.unobserve(entry.target);
      });
    }, { threshold: .55 });
  
    document.querySelectorAll('.solution-addon-card').forEach(card => addonObserver.observe(card));
  
    const onboarding = document.getElementById('process');
    if (onboarding) {
      const onboardingObserver = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        track('onboarding_view');
        onboardingObserver.disconnect();
      }, { threshold: .3 });
      onboardingObserver.observe(onboarding);
    }
  })();
  </script>
</BaseLayout>
