---
import SharedFaq from '../../../components/layout/SharedFaq.astro';
import faqs from '../../../data/faqs.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import enterpriseShopifyAutomationCssUrl from "../../../styles/pages/enterprise-shopify-automation.css?rawcss";

export const prerender = true;

const title = "Enterprise Company Store Management & Automation | Swishtag";
const description = "Manage every Shopify company store from one dashboard. Add order routing, PromoStandards, PunchOut, supplier, ERP, and AI automation as needed.";
const canonical = "https://cms.swishtag.com/solutions/enterprise-shopify-automation/";
const robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <meta slot="head" content="website" property="og:type"/>
  <meta slot="head" content="Enterprise Company Store Management &amp; Automation | Swishtag" property="og:title"/>
  <meta slot="head" content="One dashboard for every Shopify company store, with optional order routing, PromoStandards, PunchOut, supplier, ERP, AI, and custom automation." property="og:description"/>
  <meta slot="head" content="https://cms.swishtag.com/solutions/enterprise-shopify-automation/" property="og:url"/>
  <meta slot="head" content="Swishtag" property="og:site_name"/>
  <meta slot="head" content="https://cms.swishtag.com/assets/swishtag-enterprise-automation-og.png" property="og:image"/>
  <meta slot="head" content="1200" property="og:image:width"/>
  <meta slot="head" content="630" property="og:image:height"/>
  <meta slot="head" content="Swishtag enterprise company store automation dashboard and connected workflow modules" property="og:image:alt"/>
  <meta slot="head" content="Enterprise Company Store Management &amp; Automation | Swishtag" name="twitter:title"/>
  <meta slot="head" content="One dashboard for every Shopify company store, with optional order routing, PromoStandards, PunchOut, supplier, ERP, AI, and custom automation." name="twitter:description"/>
  <meta slot="head" content="https://cms.swishtag.com/assets/swishtag-enterprise-automation-og.png" name="twitter:image"/>
  <meta slot="head" content="summary_large_image" name="twitter:card"/>
  <script slot="head" type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://cms.swishtag.com/solutions/enterprise-shopify-automation/#service",
        "name": "Enterprise Company Store Management & Automation",
        "serviceType": "Multi-store Shopify company store management and automation",
        "provider": {
          "@type": "Organization",
          "name": "Swishtag",
          "url": "https://cms.swishtag.com/"
        },
        "url": "https://cms.swishtag.com/solutions/enterprise-shopify-automation/",
        "description": "A base platform for large promotional products distributors to manage multiple Shopify company stores from one dashboard, with paid add-ons for OMS automation, PromoStandards, supplier APIs, QuickBooks, Sage Intacct, NetSuite, PunchOut, AI, and custom workflows.",
        "areaServed": "US",
        "audience": {
          "@type": "BusinessAudience",
          "audienceType": "Large promotional products distributors managing multiple company stores"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://cms.swishtag.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Solutions",
            "item": "https://cms.swishtag.com/solutions/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Enterprise Company Store Automation",
            "item": "https://cms.swishtag.com/solutions/enterprise-shopify-automation/"
          }
        ]
      }
    ]
  }
  </script>
  <link slot="head" rel="stylesheet" href={enterpriseShopifyAutomationCssUrl} />
  <main>
  <div class="hero-trust-composition">
  <section class="hero" id="top">
  <div class="page-shell hero-grid">
  <div class="hero-content" data-reveal="">
  <nav aria-label="Breadcrumb" class="breadcrumb"><a href="../">Home</a><span aria-hidden="true">/</span><a href="../solutions/">Solutions</a><span aria-hidden="true">/</span><strong>Enterprise Company Store Automation</strong></nav>
  <p class="eyebrow">Enterprise company store management + automation</p>
  <h1 class="hero-title">Stop managing company stores <span class="accent">one by one.</span></h1>
  <p class="hero-subheadline">One dashboard for every company store. Add automation only when it solves a real operational problem.</p>
  <p class="hero-copy">Built for large promotional distributors. Centralize orders and reporting first, then add the workflows your operation needs.</p>
  <div class="hero-actions">
  <a class="btn btn--primary" data-analytics-event="hero_automation_cta" href="../book-demo/?service=enterprise-company-store-automation&amp;intent=automation"><span>Automate My Company</span><span aria-hidden="true" class="btn__arrow">↗</span></a>
  <a class="btn btn--secondary" data-analytics-event="hero_order_flow_click" href="#workflow">See an Automated Order Flow</a>
  </div>
  <div aria-label="Service highlights" class="hero-meta"><span class="meta-pill">Centralized multi-store control</span><span class="meta-pill">Base platform + paid add-ons</span><span class="meta-pill">Built for promo distributors</span></div>
  </div>
  <div aria-label="Swishtag CEO dashboard preview inside a browser mockup" class="enterprise-art enterprise-art--dashboard" data-reveal="">
  <div aria-hidden="true" class="flow-line flow-line--1"></div>
  <div aria-hidden="true" class="flow-line flow-line--2"></div>
  <div aria-hidden="true" class="flow-line flow-line--3"></div>
  <div aria-hidden="true" class="flow-line flow-line--4"></div>
  <div aria-hidden="true" class="flow-line flow-line--5"></div>
  <div aria-hidden="true" class="flow-line flow-line--6"></div>
  <div class="dashboard-browser-mockup dashboard-browser-mockup--simple">
  <button aria-controls="controlCenterGrid" aria-label="Open the Control Center. Click to bring the connected company-store tools inside the dashboard." aria-pressed="false" class="dashboard-browser-trigger" type="button"><span class="sr-only">Toggle Control Center</span></button>
  <div aria-hidden="true" class="dashboard-browser-mockup__bar dashboard-browser-mockup__bar--minimal"><span class="traffic traffic--red"></span><span class="traffic traffic--yellow"></span><span class="traffic traffic--green"></span></div>
  <div class="dashboard-browser-mockup__viewport dashboard-browser-mockup__viewport--simple">
  <picture>
    <source srcset="/assets/swishtag-enterprise-ceo-dashboard-640.webp" type="image/webp"/>
    <img alt="Swishtag enterprise CEO dashboard showing one dashboard view across multiple company stores" class="simple-dashboard-image" decoding="async" fetchpriority="high" height="420" loading="eager" src="../assets/swishtag-enterprise-ceo-dashboard-640.webp" width="640"/>
  </picture>
  <div aria-hidden="true" class="control-center-grid" id="controlCenterGrid"></div>
  </div>
  </div>
  <div class="enterprise-node enterprise-node--stores"><span class="enterprise-node__icon">SHOP</span><div class="enterprise-node__copy"><strong>Company Stores</strong><small>One portfolio view</small></div></div>
  <div class="enterprise-node enterprise-node--punchout"><span class="enterprise-node__icon"><svg viewBox="0 0 24 24"><path d="M4 6h16v12H4zM8 10h8M8 14h5"></path></svg></span><div class="enterprise-node__copy"><strong>PunchOut</strong><small>Optional add-on</small></div></div>
  <div class="enterprise-node enterprise-node--orders"><span class="enterprise-node__icon"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"></path></svg></span><div class="enterprise-node__copy"><strong>Order Automation</strong><small>Split, PO, route</small></div></div>
  <div class="enterprise-node enterprise-node--accounting"><span class="enterprise-node__icon"><svg viewBox="0 0 24 24"><path d="M4 7h16M6 4h12v16H6zM9 11h6M9 15h4"></path></svg></span><div class="enterprise-node__copy"><strong>Supplier APIs</strong><small>Custom connections</small></div></div>
  <div class="enterprise-node enterprise-node--suppliers"><span class="enterprise-node__icon"><svg viewBox="0 0 24 24"><path d="M4 9h16v10H4zM8 9V5h8v4"></path></svg></span><div class="enterprise-node__copy"><strong>PromoStandards</strong><small>Promo data connections</small></div></div>
  <div class="enterprise-node enterprise-node--approvals"><span class="enterprise-node__icon"><svg viewBox="0 0 24 24"><path d="M5 5h14v14H5z"></path><path d="m8 12 3 3 5-6"></path></svg></span><div class="enterprise-node__copy"><strong>Decorators</strong><small>Configured routing paths</small></div></div>
  </div>
  </div>
  </section>
  <section aria-label="Trust indicators" class="enterprise-trust-bar-section">
  <div class="page-shell">
  <div class="hero-trust-card-grid hero-trust-card-grid--enterprise">
  <div aria-label="Shopify Partner" class="hero-trust-card hero-trust-card--shopify">
    <div class="hero-trust-card__logo">
      <div aria-hidden="true" class="trust-brand trust-brand--shopify">
        <svg viewBox="0 0 34 40"><path d="M8 10h20l2.2 25H5.8L8 10Z" fill="#95BF47"></path><path d="M11 12c.3-6 2.8-9 6.1-9 3.4 0 5.7 3 6 9" fill="none" stroke="#95BF47" stroke-width="3" stroke-linecap="round"></path><path d="M20.8 16.5c-1-.6-2.3-.9-3.5-.9-1.1 0-1.8.4-1.8 1.2 0 .7.6 1 1.9 1.5 2.4.9 3.4 2.2 3 4.3-.4 2.6-2.7 4.3-5.5 4.3-1.9 0-3.7-.5-4.9-1.4l1.2-3.2c1.2.9 2.5 1.3 3.9 1.3 1.1 0 1.9-.4 2-1.1.1-.7-.4-1.1-1.8-1.5-2.2-.8-3.3-2-2.9-4 .4-2.5 2.5-4.2 5.5-4.2 1.7 0 3.1.4 4.1 1l-1.2 2.7Z" fill="#fff"></path></svg>
        <span><b>shopify</b><small>PARTNER</small></span>
      </div>
    </div>
    <div class="hero-trust-card__copy"><small>OFFICIAL PARTNER</small><strong>Shopify Partner</strong></div>
  </div>
  <div aria-label="PPAI Member" class="hero-trust-card hero-trust-card--ppai">
    <div class="hero-trust-card__logo">
      <div aria-hidden="true" class="trust-brand trust-brand--ppai"><b>PPAI<sup>®</sup></b><small>MEMBER</small></div>
    </div>
    <div class="hero-trust-card__copy"><small>INDUSTRY MEMBERSHIP</small><strong>PPAI Member</strong></div>
  </div>
  <div aria-label="Trustpilot 4.6 rating" class="hero-trust-card hero-trust-card--trustpilot">
    <div class="hero-trust-card__logo hero-trust-card__logo--trustpilot"><div class="hero-trustpilot-wordmark"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 1.8l3.15 6.37 7.03 1.02-5.09 4.96 1.2 7.01L12 17.86 5.71 21.16l1.2-7.01L1.82 9.19l7.03-1.02L12 1.8z" fill="#00B67A"></path></svg><strong>Trustpilot</strong></div><div aria-hidden="true" class="hero-trustpilot-stars"><span>★</span><span>★</span><span>★</span><span>★</span><span class="partial">★</span></div></div>
    <div class="hero-trust-card__copy"><small>CUSTOMER REVIEWS</small><strong>4.6 rating</strong></div>
  </div>
  <div aria-label="100 percent project delivery" class="hero-trust-card hero-trust-card--delivery">
    <div class="hero-trust-card__logo"><div aria-hidden="true" class="trust-delivery-mark"><span>✓</span></div></div>
    <div class="hero-trust-card__copy"><small>DELIVERY RECORD</small><strong>100% Project Delivery</strong></div>
  </div>
  </div>
  </div>
  </section>
  <section aria-label="Enterprise company store platform trust points" class="proof-strip">
  <div class="page-shell proof-panel">
  <div class="proof-intro"><strong>Built for distributors running complex company-store programs.</strong></div>
  <div class="proof-item"><small>Base platform</small><strong>Stores, orders &amp; reporting in one place</strong></div>
  <div class="proof-item"><small>Automation add-ons</small><strong>Supplier routing, POs &amp; PunchOut</strong></div>
  <div class="proof-item"><small>Custom connections</small><strong>Accounting, ERP, AI &amp; your systems</strong></div>
  </div>
  </section>
  </div>
  <div class="page-nav-wrap" id="pageNavWrap">
  <div class="page-shell">
  <nav aria-label="Page navigation" class="page-nav-shell" id="pageNavShell">
  <button aria-controls="pageNavLinks" aria-expanded="false" class="page-nav-toggle" id="pageNavToggle" type="button"><span><small>On this page</small><strong id="pageNavCurrent">Problem</strong></span><span aria-hidden="true" class="page-nav-toggle__icon"></span></button>
  <div class="page-nav" id="pageNavLinks"><a href="#problem">Problem</a><a href="#platform">Base Platform</a><a href="#architecture">Platform + Add-ons</a><a href="#workflow">Order Flow</a><a href="#systems">Integrations</a><a href="#success-story">Success Story</a><a href="#process">Onboarding</a><a href="#faq">FAQs</a></div>
  </nav>
  </div>
  </div>
  <section class="section section--soft" data-nav-label="Problem" id="problem">
  <div class="page-shell">
  <div class="section-heading-split">
  <div data-reveal=""><p class="eyebrow">The multi-store problem</p><h2 class="section-title">More company stores should not mean more tabs, more spreadsheets, and more people.</h2></div>
  <p class="section-copy" data-reveal="">Large distributors rarely struggle to launch the next Shopify store. The pain comes later, when the operations team has to keep opening store after store to find orders, build reports, split supplier work, create POs, and answer enterprise client requests.</p>
  </div>
  <div class="problem-grid">
  <article class="problem-card" data-reveal=""><span class="problem-card__number">01</span><h3>You cannot see the whole business at once.</h3><p>Orders and performance are spread across separate Shopify admins, so getting a clear portfolio view means logging into stores individually or rebuilding the same report outside Shopify.</p></article>
  <article class="problem-card" data-reveal=""><span class="problem-card__number">02</span><h3>Your team is doing work the order already told you to do.</h3><p>People still split orders by supplier, create purchase orders, enter supplier orders, decide the decorator path, and chase the next step manually.</p></article>
  <article class="problem-card" data-reveal=""><span class="problem-card__number">03</span><h3>Every large client asks for something different.</h3><p>One needs PunchOut. Another needs a supplier connection. Another has a unique routing or approval rule. Off-the-shelf apps stop fitting once the workflow gets specific.</p></article>
  </div>
  <div class="better-approach-type" data-reveal="">
  <p class="eyebrow">The better approach</p>
  <h3 class="better-approach-type__interactive"><span class="better-approach-type__soft">More stores. More tabs. More manual work.</span><span>Bring every company store into one place.</span><span class="better-approach-type__accent">Automate the repetitive work eating your time and margins.</span></h3>
  <div aria-label="Recommended approach" class="better-approach-type__steps"><span>Centralize</span><i></i><span>Connect</span><i></i><span>Automate</span></div>
  </div>
  </div>
  </section>
  <section class="section section--gray" data-nav-label="Base Platform" id="platform">
  <div class="page-shell platform-layout">
  <div class="platform-sticky" data-reveal=""><p class="eyebrow">Start with the base platform</p><h2 class="section-title section-title--small">One dashboard for every company store.</h2><p class="section-copy">If your biggest problem is simply managing many stores, start here. Bring your Shopify company stores into one control layer so your team can see the portfolio without living inside separate Shopify admins.</p><a class="text-link" href="#architecture">Then add only what you need <span>→</span></a></div>
  <div class="platform-list">
  <article class="platform-item" data-reveal=""><span class="platform-icon"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h8M8 13h5"></path></svg></span><div><h3>See orders from every store in one place</h3><p>Give operations one central order view across multiple client programs instead of making people jump between Shopify stores just to see what came in.</p></div></article>
  <article class="platform-item" data-reveal=""><span class="platform-icon"><svg viewBox="0 0 24 24"><path d="M4 18V9M10 18V5M16 18v-7M22 18V7"></path></svg></span><div><h3>Get portfolio-level reporting</h3><p>See reporting across the company store portfolio, then drill into individual stores when a client, account manager, or operations team needs the detail.</p></div></article>
  <article class="platform-item" data-reveal=""><span class="platform-icon"><svg viewBox="0 0 24 24"><circle cx="6" cy="12" r="2"></circle><circle cx="18" cy="6" r="2"></circle><circle cx="18" cy="18" r="2"></circle><path d="m8 11 8-4M8 13l8 4"></path></svg></span><div><h3>Manage different store types together</h3><p>Your portfolio can include Shopify company stores with inventory, print-on-demand, or hybrid fulfillment. The platform gives you a common operational view while each store keeps the setup it needs.</p></div></article>
  <article class="platform-item" data-reveal=""><span class="platform-icon"><svg viewBox="0 0 24 24"><path d="M5 6h14v12H5z"></path><path d="m8 12 3 3 5-6"></path></svg></span><div><h3>Stop at the platform if that solves the problem</h3><p>You do not have to buy a full automation project. Use the base platform for centralized management, then add workflow automation only when the operational return makes sense.</p></div></article>
  </div>
  </div>
  </section>
  <section class="section solution-package-section" data-nav-label="Platform + Add-ons" id="architecture">
  <div class="page-shell">
  <div class="section-heading-split">
  <div data-reveal="">
  <p class="eyebrow">Base platform + optional add-ons</p>
  <h2 class="section-title">One platform. Add only what your operation needs.</h2>
  </div>
  <p class="section-copy" data-reveal="">Start with centralized company-store control. Then add workflow automation, integrations, procurement, AI, or custom logic only when it solves a real business problem.</p>
  </div>
  
  <article class="solution-base-card" data-reveal="">
  <div class="solution-base-card__top">
  <div><span class="solution-pill solution-pill--included">Included</span><span class="solution-card-kicker">Base Platform</span></div>
  <span class="solution-base-card__status">Your starting point</span>
  </div>
  <div class="solution-base-card__body">
  <div>
  <h3>One place to control every company store.</h3>
  <p>Centralize orders, reporting, store visibility, and operational status across your Shopify company-store portfolio. Use the base platform by itself if that solves the problem.</p>
  </div>
  <div class="solution-base-features">
  <div><strong>All stores</strong><span>One portfolio view</span></div>
  <div><strong>All orders</strong><span>Central order visibility</span></div>
  <div><strong>Reporting</strong><span>Portfolio + store level</span></div>
  <div><strong>Exceptions</strong><span>See what needs attention</span></div>
  </div>
  </div>
  </article>
  
  <div class="optional-addons-intro" data-reveal="">
  <span class="optional-addons-intro__icon">+</span>
  <div><small>Everything below is optional</small><strong>Add only what your business needs.</strong><p>No forced bundle. Pick one add-on, combine several, or run the base platform without any of them.</p></div>
  </div>
  
  <div class="addon-card-grid">
  <article class="solution-addon-card solution-addon-card--lavender" data-reveal="">
  <span class="solution-addon-card__bg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h6v6H4zM14 4h6v6h-6zM14 14h6v6h-6zM10 10h4M17 10v4M10 10 7 7"></path></svg></span>
  <div class="solution-addon-card__top"><div class="solution-addon-card__identity"><span class="solution-addon-card__icon"><svg viewBox="0 0 24 24"><path d="M4 7h6v6H4zM14 4h6v6h-6zM14 14h6v6h-6zM10 10h4M17 10v4M10 10 7 7"></path></svg></span><span class="solution-pill">Optional add-on</span></div><span class="solution-addon-card__number">01</span></div>
  <h3>OMS &amp; order routing</h3>
  <p>Automate the repetitive work after an order arrives. Split orders by supplier, generate POs, submit supplier orders, route work to decorators, and flag exceptions.</p>
  <div class="solution-addon-tags"><span>Order split</span><span>POs</span><span>Decorator routing</span></div>
  <div class="solution-addon-card__best"><small>Useful when</small><strong>Your team manually decides where every order goes.</strong></div>
  </article>
  
  <article class="solution-addon-card solution-addon-card--mint" data-reveal="">
  <span class="solution-addon-card__bg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 7h4v4H7zM13 13h4v4h-4zM11 9h5a3 3 0 0 1 3 3v1M13 15H8a3 3 0 0 1-3-3v-1"></path></svg></span>
  <div class="solution-addon-card__top"><div class="solution-addon-card__identity"><span class="solution-addon-card__icon"><svg viewBox="0 0 24 24"><path d="M7 7h4v4H7zM13 13h4v4h-4zM11 9h5a3 3 0 0 1 3 3v1M13 15H8a3 3 0 0 1-3-3v-1"></path></svg></span><span class="solution-pill">Optional add-on</span></div><span class="solution-addon-card__number">02</span></div>
  <h3>Supplier connections</h3>
  <p>Connect directly with approved suppliers when they provide suitable APIs or technical access. Automate product data, order submission, status updates, or another agreed workflow.</p>
  <div class="solution-addon-tags"><span>Supplier APIs</span><span>Order submission</span><span>Status sync</span></div>
  <div class="solution-addon-card__best"><small>Useful when</small><strong>Your team is re-entering supplier data or orders by hand.</strong></div>
  </article>
  
  <article class="solution-addon-card solution-addon-card--lime" data-reveal="">
  <span class="solution-addon-card__bg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 5h14v14H5zM8 9h8M8 13h8M8 17h5"></path></svg></span>
  <div class="solution-addon-card__top"><div class="solution-addon-card__identity"><span class="solution-addon-card__icon"><svg viewBox="0 0 24 24"><path d="M5 5h14v14H5zM8 9h8M8 13h8M8 17h5"></path></svg></span><span class="solution-pill">Optional add-on</span></div><span class="solution-addon-card__number">03</span></div>
  <h3>PromoStandards integration</h3>
  <p>Use PromoStandards endpoints to connect supported supplier product, pricing, inventory, order, or status data into the workflow your stores need.</p>
  <div class="solution-addon-tags"><span>Product data</span><span>Pricing</span><span>Inventory</span><span>Orders</span></div>
  <div class="solution-addon-card__best"><small>Useful when</small><strong>You want standardized promo-industry data moving automatically.</strong></div>
  </article>
  
  <article class="solution-addon-card solution-addon-card--peach" data-reveal="">
  <span class="solution-addon-card__bg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 6h14v12H5zM8 10h8M8 14h5M19 9l3 3-3 3"></path></svg></span>
  <div class="solution-addon-card__top"><div class="solution-addon-card__identity"><span class="solution-addon-card__icon"><svg viewBox="0 0 24 24"><path d="M5 6h14v12H5zM8 10h8M8 14h5M19 9l3 3-3 3"></path></svg></span><span class="solution-pill">Optional add-on</span></div><span class="solution-addon-card__number">04</span></div>
  <h3>PunchOut catalogs</h3>
  <p>Enable procurement-connected company stores when enterprise buyers need PunchOut. Scope the cXML session, cart return, authentication, PO flow, and buyer-system testing.</p>
  <div class="solution-addon-tags"><span>Coupa</span><span>SAP Ariba</span><span>Jaggaer</span><span>Oracle</span></div>
  <div class="solution-addon-card__best"><small>Useful when</small><strong>A corporate client wants to buy through procurement.</strong></div>
  </article>
  
  <article class="solution-addon-card solution-addon-card--finance" data-reveal="">
  <span class="solution-addon-card__bg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5M12 4v16"></path></svg></span>
  <div class="solution-addon-card__top"><div class="solution-addon-card__identity"><span class="solution-addon-card__icon"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5M12 4v16"></path></svg></span><span class="solution-pill">Optional add-on</span></div><span class="solution-addon-card__number">05</span></div>
  <h3>Accounting integration</h3>
