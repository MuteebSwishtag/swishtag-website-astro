      #fff;
  }
  .customer-story-v5__quote-mark { position:absolute; right:36px; top:0; color:rgba(32,33,36,.055); font-size:13rem; line-height:1; font-weight:800; }
  .customer-story-v5__quote-card blockquote { position:relative; z-index:1; margin:0; padding-top:46px; }
  .customer-story-v5__quote-card blockquote p { margin:0 0 22px; color:rgba(32,33,36,.78); font-size:clamp(1.08rem,1.55vw,1.36rem); line-height:1.68; letter-spacing:-.02em; }
  .customer-story-v5__quote-card blockquote p:first-child { font-size:clamp(1.25rem,1.8vw,1.55rem); color:var(--ink); }
  .customer-story-v5__attribution { position:relative; z-index:1; display:flex; align-items:center; gap:14px; margin-top:34px; padding-top:28px; border-top:1px solid var(--line); }
  .customer-story-v5__mark { width:58px; height:58px; flex:0 0 58px; padding:5px; border-radius:18px; background:#fff; box-shadow:0 10px 25px rgba(32,33,36,.07); }
  .customer-story-v5__mark svg { width:100%; height:100%; }
  .customer-story-v5__attribution strong,.customer-story-v5__attribution span { display:block; }
  .customer-story-v5__attribution span { margin-top:4px; color:var(--muted); font-size:.75rem; }
