  @media (prefers-reduced-motion:reduce) {
    .final-visual__orbit, .final-visual__chip { animation:none !important; }
  }
  
  
  /* ==========================================================
     V5 refinements: typography, interactive add-ons, success proof,
     onboarding journey, final CTA color system
     ========================================================== */
  .better-approach-type {
    max-width: 1080px;
    margin: 96px auto 10px;
    padding: 16px 24px 0;
    text-align: center;
  }
  .better-approach-type .eyebrow { margin-bottom: 22px; }
  .better-approach-type h3 {
    margin: 0 auto;
    display: grid;
    justify-items: center;
    gap: 7px;
    font-size: clamp(2.7rem, 5.6vw, 6.4rem);
    line-height: .98;
    letter-spacing: -.065em;
    font-weight: 800;
  }
  .better-approach-type h3 span { display: block; }
  .better-approach-type__soft { color: var(--muted); font-weight: 500; font-size: .64em; letter-spacing: -.045em; }
  .better-approach-type__accent {
    background: linear-gradient(90deg, #7a65d5 0%, #202124 42%, #527b71 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .better-approach-type__steps {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
    padding: 11px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255,255,255,.72);
    color: var(--muted);
    font-size: .65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .better-approach-type__steps i { width: 5px; height: 5px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 5px rgba(194,255,2,.13); }
  
  /* Add-on cards */
  .addon-card-grid { gap: 18px; }
  .solution-addon-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 380px;
    border-color: rgba(32,33,36,.07);
    transition: transform .38s var(--ease), box-shadow .38s var(--ease), border-color .38s var(--ease);
  }
  .solution-addon-card::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: 190px;
    height: 190px;
    right: -84px;
    top: -92px;
    border-radius: 50%;
    background: rgba(255,255,255,.48);
    transition: transform .55s var(--ease), opacity .4s ease;
  }
  .solution-addon-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    left: 24px;
    right: 24px;
    bottom: 0;
    height: 3px;
    border-radius: 999px 999px 0 0;
    background: rgba(32,33,36,.14);
    transform: scaleX(.22);
    transform-origin: left;
    transition: transform .4s var(--ease), background .4s ease;
  }
  .solution-addon-card:hover { transform: translateY(-9px) rotate(-.25deg); box-shadow: 0 28px 62px rgba(32,33,36,.105); }
  .solution-addon-card:hover::before { transform: translate(-18px, 18px) scale(1.13); }
  .solution-addon-card:hover::after { transform: scaleX(1); background: var(--lime); }
  .solution-addon-card--lavender { background: linear-gradient(145deg,#f1efff 0%,#faf9ff 62%,#fff 100%); }
  .solution-addon-card--mint { background: linear-gradient(145deg,#eafff9 0%,#f7fffd 65%,#fff 100%); }
  .solution-addon-card--lime { background: linear-gradient(145deg,#f3ffd1 0%,#fbfff0 66%,#fff 100%); }
  .solution-addon-card--peach { background: linear-gradient(145deg,#fff0e7 0%,#fff9f5 65%,#fff 100%); }
  .solution-addon-card--finance { background: linear-gradient(145deg,#fff5df 0%,#f3efff 52%,#fff 100%); }
  .solution-addon-card--ai { color: var(--ink); background: linear-gradient(145deg,#e9f4ff 0%,#eeeaff 48%,#f7fff3 100%); }
  .solution-addon-card--ai p,
  .solution-addon-card--ai .solution-addon-card__best small { color: var(--muted); }
  .solution-addon-card--ai .solution-addon-card__best strong { color: var(--ink); }
  .solution-addon-card--ai .solution-addon-tags span { color: var(--ink); border-color: rgba(32,33,36,.08); background: rgba(255,255,255,.66); }
  .solution-addon-card--ai .solution-addon-card__top > span:last-child { color: var(--muted); }
  .solution-addon-card--custom { background: linear-gradient(135deg,#eeeaff 0%,#e8fff8 48%,#fff1e8 100%); }
  .solution-addon-card__identity { display:flex; align-items:center; gap:10px; }
  .solution-addon-card__icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    flex: 0 0 48px;
    border-radius: 16px;
    color: var(--ink);
    background: rgba(255,255,255,.78);
    border: 1px solid rgba(32,33,36,.07);
    box-shadow: 0 10px 24px rgba(32,33,36,.055);
    transition: transform .38s var(--ease), box-shadow .38s var(--ease), background .38s ease;
  }
  .solution-addon-card__icon svg { width: 24px; height: 24px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .solution-addon-card__number { color: var(--muted); font-size: .62rem; font-weight: 800; }
  .solution-addon-card:hover .solution-addon-card__icon { transform: translateY(-3px) rotate(5deg) scale(1.06); background: var(--lime); box-shadow: 0 13px 28px rgba(32,33,36,.09); }
  .solution-addon-card h3 { margin-top: 32px; }
  .solution-addon-tags span { transition: transform .25s ease, background .25s ease; }
  .solution-addon-card:hover .solution-addon-tags span:nth-child(odd) { transform: translateY(-2px); background: rgba(255,255,255,.9); }
  .solution-addon-card:hover .solution-addon-tags span:nth-child(even) { transform: translateY(2px); }
  
  /* Customer story V5 */
  .customer-story-section--v5 {
    padding-top: 108px;
    padding-bottom: 118px;
    background:
      radial-gradient(circle at 8% 12%, rgba(217,214,253,.28), transparent 25%),
      radial-gradient(circle at 90% 78%, rgba(153,254,237,.25), transparent 27%),
      linear-gradient(180deg,#fff 0%,#fbfbf8 100%);
  }
  .customer-story-v5__heading { max-width: 900px; margin: 0 auto 48px; text-align: center; }
  .customer-story-v5__heading .section-copy { margin-inline: auto; }
  .customer-story-v5 {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 18px;
    align-items: start;
  }
  .customer-story-v5__quote-card,
  .customer-story-v5__proof {
    border: 1px solid rgba(32,33,36,.075);
