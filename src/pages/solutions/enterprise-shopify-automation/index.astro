  .customer-story-v5__metric:hover { transform:translateX(6px); box-shadow:0 12px 30px rgba(32,33,36,.06); }
  .customer-story-v5__metric strong { display:block; font-size:clamp(2rem,3.7vw,3.8rem); line-height:.95; letter-spacing:-.06em; }
  .customer-story-v5__metric span { display:block; margin-top:8px; color:var(--muted); font-size:.75rem; line-height:1.5; }
