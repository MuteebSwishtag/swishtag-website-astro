---
import '../../../styles/company-store.css';
import SharedFaq from '../../../components/layout/SharedFaq.astro';
import faqs from '../../../data/faqs.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { companyStoreService, companyStoreBreadcrumbs } from '../../../data/company-store.js';

export const prerender = true;

const title = "Company Store Design, Launch & Management | Swishtag";
const description = "Company stores, done for you. Swishtag designs, launches and supports branded Shopify company stores for promotional products distributors. Book a demo.";
const canonical = "https://swishtag.com/solutions/shopify-company-store/";
const robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const ogImage = "https://swishtag.com/assets/company-store/branded-storefront.webp";
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.companyStore.items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <meta slot="head" content={title} property="og:title"/>
  <meta slot="head" content={description} property="og:description"/>
  <meta slot="head" content="website" property="og:type"/>
  <meta slot="head" content={canonical} property="og:url"/>
  <meta slot="head" content="Swishtag" property="og:site_name"/>
  <meta slot="head" content="summary_large_image" name="twitter:card"/>
  <meta slot="head" content={title} name="twitter:title"/>
  <meta slot="head" content={description} name="twitter:description"/>
  <meta slot="head" content={ogImage} property="og:image"/>
  <meta slot="head" content="Shopify company store designed and launched by Swishtag" property="og:image:alt"/>
  <meta slot="head" content={ogImage} name="twitter:image"/>
  <meta slot="head" content="Shopify company store designed and launched by Swishtag" name="twitter:image:alt"/>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(companyStoreService).replace(/</g, '\u003c')} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(companyStoreBreadcrumbs).replace(/</g, '\u003c')} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema).replace(/</g, '\u003c')} />
