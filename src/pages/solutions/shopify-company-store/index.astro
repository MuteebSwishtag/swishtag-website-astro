        }
        [data-reveal] { opacity: 1; transform: none; }
      }
  
      @media print {
        .site-header, .page-nav-wrap, .mobile-sticky-cta, .mobile-menu { display: none !important; }
        .hero { min-height: auto; padding-top: 40px; }
