---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Shopify Company Stores for Promo Distributors | Swishtag";
const description = "Launch a Shopify company store using POD, inventory, or hybrid fulfillment. Help clients reorder branded merchandise while creating repeat revenue.";
const canonical = "https://cms.swishtag.com/solutions/shopify-company-store/";
const robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
