    }
  
    .process-card::before {
      inset: 12px;
      height: auto;
      border-radius: 50%;
      border: 1px dashed color-mix(in srgb, var(--process-accent, var(--lime)) 62%, rgba(32,33,36,.16));
      background: transparent;
      opacity: .72;
      pointer-events: none;
