        .launch-chip { min-width: 110px; font-size: .58rem; }
        .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px 20px; }
        .footer-bottom { flex-direction: column; }
        .mobile-sticky-cta {
          position: fixed;
          z-index: 80;
          left: 12px;
          right: 12px;
          bottom: max(12px, env(safe-area-inset-bottom));
