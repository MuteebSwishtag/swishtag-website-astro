  <script type="application/ld+json">
   {"@context": "https://schema.org", "@type": "Service", "name": "SAGE Connected Company Store", "serviceType": "SAGE Connect Shopify integration for promotional products distributors", "provider": {"@type": "Organization", "name": "Swishtag", "url": "https://cms.swishtag.com"}, "areaServed": "United States", "description": "A custom Shopify company store implementation that uses authorized SAGE product data, documented field mapping, and agreed synchronization rules.", "offers": {"@type": "Offer", "price": "5000", "priceCurrency": "USD", "description": "One-time implementation price for one controlled SAGE Connected Shopify company store."}, "url": "https://cms.swishtag.com/solutions/shopify-sage-connect-integration/"}
  </script>
  <script type="application/ld+json">
   {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://cms.swishtag.com/"}, {"@type": "ListItem", "position": 2, "name": "Solutions", "item": "https://cms.swishtag.com/solutions/"}, {"@type": "ListItem", "position": 3, "name": "SAGE Connected Company Store", "item": "https://cms.swishtag.com/solutions/shopify-sage-connect-integration/"}]}
  </script>
  <script type="application/ld+json">
   {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is this the same as a SAGE Store?", "acceptedAnswer": {"@type": "Answer", "text": "No. A SAGE Connected Company Store is a custom Shopify storefront using authorized SAGE data services. A standard SAGE Store is usually the better choice when its native features fully meet the client requirement. Choose this service when the client specifically needs Shopify, stronger customization, or a broader integration roadmap."}}, {"@type": "Question", "name": "Does this replace SAGE Workplace?", "acceptedAnswer": {"@type": "Answer", "text": "No. The distributor can continue using SAGE for product research and existing workflows. Shopify becomes the client-facing commerce layer, while the agreed SAGE data supports the storefront."}}, {"@type": "Question", "name": "What SAGE data can be used?", "acceptedAnswer": {"@type": "Answer", "text": "The exact fields depend on the distributor's SAGE licensing, SAGE Connect access, available modules, supplier data, and the approved scope. Product details, images, categories, pricing, inventory, and supplier references may be used when available."}}, {"@type": "Question", "name": "Can the entire SAGE catalog be added to Shopify?", "acceptedAnswer": {"@type": "Answer", "text": "The service is designed around a controlled catalog. Broad or full-database access depends on licensing, technical limits, search requirements, and Shopify architecture. We generally recommend starting with approved products that support the client program."}}, {"@type": "Question", "name": "Will orders automatically move back into SAGE?", "acceptedAnswer": {"@type": "Answer", "text": "Not unless order submission or order synchronization is included in the written scope. The starting package focuses on the Shopify storefront and catalog data flow. Order, purchase order, accounting, and status integrations can be added separately."}}, {"@type": "Question", "name": "How often will product data update?", "acceptedAnswer": {"@type": "Answer", "text": "The update frequency is defined during discovery and depends on available SAGE services, supplier data, catalog size, Shopify limits, and the operational importance of each field."}}, {"@type": "Question", "name": "Can the store use POD, stocked inventory, or hybrid fulfillment?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The storefront can support print on demand, stocked inventory, or a hybrid model. The SAGE data connection and the fulfillment workflow are scoped separately so each one is clear."}}, {"@type": "Question", "name": "What happens when supplier data is missing or inconsistent?", "acceptedAnswer": {"@type": "Answer", "text": "The integration can only use data available through the approved source. We identify missing fields during mapping and define whether the distributor will supply replacements, use defaults, or exclude the affected products."}}, {"@type": "Question", "name": "Who needs to provide SAGE access?", "acceptedAnswer": {"@type": "Answer", "text": "The distributor must provide authorized access, credentials, documentation, and any required SAGE approvals or subscriptions. Swishtag does not bypass licensing or use data outside the distributor's permitted access."}}, {"@type": "Question", "name": "Does the price include Shopify or SAGE fees?", "acceptedAnswer": {"@type": "Answer", "text": "No. Shopify subscriptions, SAGE subscriptions, SAGE Connect or API charges, paid applications, domains, transaction fees, product costs, and other third-party charges are separate unless explicitly included."}}, {"@type": "Question", "name": "How long does the implementation take?", "acceptedAnswer": {"@type": "Answer", "text": "The timeline is confirmed after the access and data review. A controlled catalog is usually implemented in phases: discovery, mapping, storefront development, testing, and launch. Custom order or ERP integrations extend the schedule."}}]}
  </script>
  <link as="image" fetchpriority="high" href="/assets/sage-logo.webp" rel="preload" type="image/webp"/>
  <link as="image" fetchpriority="high" href="/assets/shopify-company-store-mobile.webp" rel="preload" type="image/webp"/>
  <meta content="light" name="color-scheme"/>
  <style is:global>
    .shopify-sage-connect-integration-page .site-header,
    .shopify-sage-connect-integration-page .site-header.is-scrolled,
    .shopify-sage-connect-integration-page .site-header.is-nav-connected {
      z-index: 320 !important;
    }

    .shopify-sage-connect-integration-page .page-nav-wrap,
    .shopify-sage-connect-integration-page .page-nav-wrap.is-stuck {
      z-index: 210 !important;
    }

    .shopify-sage-connect-integration-page .page-nav-toggle > span:first-child {
      flex: 1 1 auto;
      min-width: 0;
      margin-right: 12px;
    }

    .shopify-sage-connect-integration-page .page-nav-toggle > .page-nav-toggle__icon {
      margin-left: auto !important;
      margin-right: 0 !important;
    }

    @media (min-width: 901px) {
      .shopify-sage-connect-integration-page {
        --navigation-width: min(1240px, calc(100vw - 48px));
      }

      .shopify-sage-connect-integration-page .modern-nav {
        width: var(--navigation-width) !important;
        max-width: none !important;
      }

      .shopify-sage-connect-integration-page .page-nav-wrap {
        top: var(--page-nav-top, 70px) !important;
        padding-top: 0 !important;
        pointer-events: none !important;
      }

      .shopify-sage-connect-integration-page .page-nav-wrap > .page-shell {
        width: var(--navigation-width) !important;
        max-width: none !important;
      }

      .shopify-sage-connect-integration-page .page-nav-shell {
        pointer-events: auto !important;
      }

      .shopify-sage-connect-integration-page .site-header.is-nav-connected .modern-nav {
        border-radius: 24px 24px 0 0 !important;
        border-bottom-color: transparent !important;
        box-shadow: none !important;
      }

      .shopify-sage-connect-integration-page .page-nav-wrap.is-stuck {
        filter: drop-shadow(0 22px 42px rgba(32,33,36,.11));
      }

      .shopify-sage-connect-integration-page .page-nav-wrap.is-stuck .page-nav-shell {
        margin-top: -1px !important;
        border-top-color: transparent !important;
        border-radius: 0 0 24px 24px !important;
        background: rgba(255,255,255,.97) !important;
        box-shadow: none !important;
      }
    }

    @media (max-width: 900px) {
      .shopify-sage-connect-integration-page .page-nav-wrap,
      .shopify-sage-connect-integration-page .page-nav-wrap.is-stuck {
        top: var(--page-nav-top, 70px) !important;
        pointer-events: auto !important;
      }

      .shopify-sage-connect-integration-page .page-nav-shell,
      .shopify-sage-connect-integration-page .page-nav-shell.is-open {
        overflow: visible !important;
        pointer-events: auto !important;
      }

      .shopify-sage-connect-integration-page .page-nav-toggle {
        display: flex !important;
      }

      .shopify-sage-connect-integration-page .page-nav-shell .page-nav {
        pointer-events: none !important;
      }

      .shopify-sage-connect-integration-page .page-nav-shell.is-open .page-nav {
        display: grid !important;
        max-height: min(68vh, 520px) !important;
        padding: 10px !important;
        overflow-y: auto !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        transform: translateY(0) scale(1) !important;
      }
    }
  </style>
</head>
 <body class="shopify-sage-connect-integration-page">
  <GoogleTagManager placement="body" />
  <Header />
<main class="sage-connect-page">
   <section class="hero" id="top">
    <div class="page-shell hero-grid">
     <div class="hero-content" data-reveal="">
      <nav aria-label="Breadcrumb" class="breadcrumb">
       <a data-home-link="" href="/">
        Home
       </a>
       <span aria-hidden="true">
        /
       </span>
       <a href="/solutions/">
        Solutions
       </a>
       <span aria-hidden="true">
        /
       </span>
       <strong>
        SAGE Connected Company Store
       </strong>
      </nav>
