---
import SharedFaq from '../../components/layout/SharedFaq.astro';
import faqs from '../../data/faqs.json';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const title = "Solutions for Promotional Products Distributors | Swishtag";
const description = "Compare solution paths for promotional products distributors: Company Store Launch, PunchOut Solutions, Enterprise Company Store Automation, and Custom Software & Automation.";
const canonical = "https://swishtag.com/solutions/";
const robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const solutionList = {
  "@type": "ItemList",
  itemListElement: [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Company Store Launch",
      "url": "https://swishtag.com/solutions/shopify-company-store/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "PunchOut Solutions",
      "url": "https://swishtag.com/solutions/punchout-solutions/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Enterprise Company Store Automation",
      "url": "https://swishtag.com/solutions/enterprise-shopify-automation/"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "Custom Software & Automation",
      "url": "https://swishtag.com/solutions/custom-software-automation/"
    }
  ],
};
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots} pageType="CollectionPage" pageProps={{ mainEntity: solutionList }} faq={faqs.solutions}>
  <style slot="head" is:inline>
  :root{--lime:#c2ff02;
        --peach:#ffbd9b;
        --lavender:#d9d6fd;
        --mint:#99feed;
        --white:#fff;
        --gray:#f5f5f3;
        --gray-2:#ecece8;
        --ink:#202124;
        --muted:#6c6e73;
        --line:rgba(32,33,36,.11);
        --shadow-sm:0 16px 42px rgba(32,33,36,.07);
        --shadow-md:0 28px 70px rgba(32,33,36,.11);
        --page:min(1280px,calc(100vw - 48px));
        --ease:cubic-bezier(.22,.8,.24,1);}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth;background:var(--white);-webkit-text-size-adjust:100%}
  body{margin:0;color:var(--ink);background:var(--white);font-family:"Plus Jakarta Sans",system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden;-webkit-font-smoothing:antialiased}
  body.menu-open{overflow:hidden}
  img,svg{display:block;max-width:100%}
  a{color:inherit;text-decoration:none}
  button{font:inherit;color:inherit}
  button,a{-webkit-tap-highlight-color:transparent}
  :focus-visible{outline:3px solid rgba(194,255,2,.88);outline-offset:4px}
  .page-shell{width:var(--page);margin-inline:auto}
  .section{padding:112px 0}
  .eyebrow{margin:0 0 16px;color:var(--muted);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .section-title{max-width:900px;margin:0;font-size:clamp(3rem,5.8vw,5.8rem);line-height:.98;letter-spacing:-.062em;font-weight:800;text-wrap:balance}
  .section-copy{max-width:690px;margin:22px 0 0;color:var(--muted);font-size:clamp(1rem,1.3vw,1.16rem);line-height:1.7}
  .btn{min-height:54px;display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:0 22px;border:1px solid transparent;border-radius:999px;font-size:.88rem;font-weight:800;transition:transform .24s var(--ease),box-shadow .24s var(--ease),background .2s ease}
  .btn:hover{transform:translateY(-2px)}
  .btn--primary{background:var(--lime);box-shadow:0 12px 28px rgba(194,255,2,.24)}
  .btn--dark{color:#fff;background:var(--ink)}
  .site-header{position:fixed;z-index:200;inset:0 0 auto;padding:14px 0}
  .nav{width:var(--page);min-height:68px;margin-inline:auto;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:24px;padding:7px 9px 7px 21px;border:1px solid rgba(255,255,255,.9);border-radius:999px;background:rgba(255,255,255,.86);box-shadow:0 14px 40px rgba(32,33,36,.07);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}
  .brand{display:inline-flex;align-items:center;gap:10px;font-size:.96rem;font-weight:800;letter-spacing:.055em;white-space:nowrap}
  .brand-mark{width:14px;height:14px;border-radius:5px 5px 5px 1px;background:var(--lime);box-shadow:9px -7px 0 -4px var(--peach),11px 7px 0 -5px var(--mint);transform:rotate(-12deg)}
  .desktop-nav{display:flex;align-items:center;justify-content:center;gap:6px}
  .desktop-nav a{min-height:42px;display:inline-flex;align-items:center;padding:0 13px;border-radius:12px;font-size:.8rem;font-weight:700;transition:background .2s ease}
  .desktop-nav a:hover,.desktop-nav a[aria-current="page"]{background:rgba(32,33,36,.045)}
  .nav-cta{min-height:50px;padding-inline:21px}
  .menu-toggle{width:48px;height:48px;display:none;place-items:center;border:1px solid rgba(32,33,36,.1);border-radius:50%;background:var(--gray);cursor:pointer}
  .menu-toggle span{width:18px;height:2px;display:block;margin:4px auto;border-radius:99px;background:var(--ink);transition:transform .22s ease,opacity .2s ease}
  .menu-toggle[aria-expanded="true"] span:first-child{transform:translateY(6px) rotate(45deg)}
  .menu-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
  .menu-toggle[aria-expanded="true"] span:last-child{transform:translateY(-6px) rotate(-45deg)}
  .mobile-menu{position:fixed;z-index:190;inset:0;padding:92px 12px 12px;background:rgba(32,33,36,.32);opacity:0;visibility:hidden;transition:opacity .22s ease,visibility .22s ease}
  .mobile-menu.is-open{opacity:1;visibility:visible}
  .mobile-menu__panel{max-height:calc(100dvh - 104px);overflow:auto;padding:22px;border-radius:28px;background:#fff;box-shadow:var(--shadow-md);transform:translateY(-10px);transition:transform .25s var(--ease)}
  .mobile-menu.is-open .mobile-menu__panel{transform:none}
  .mobile-menu__top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:16px;border-bottom:1px solid var(--line)}
  .mobile-menu__close{width:44px;height:44px;border:0;border-radius:50%;background:var(--gray);font-size:1.35rem;cursor:pointer}
  .mobile-links{display:grid;padding:8px 0}
  .mobile-links a{padding:16px 4px;border-bottom:1px solid var(--line);font-size:1rem;font-weight:750}
  .mobile-menu .btn{width:100%;margin-top:18px}
  .hero{position:relative;padding:150px 0 86px;overflow:hidden;isolation:isolate;background:radial-gradient(circle at 13% 15%,rgba(255,189,155,.24),transparent 22%),radial-gradient(circle at 82% 12%,rgba(217,214,253,.68),transparent 28%),radial-gradient(circle at 72% 78%,rgba(153,254,237,.42),transparent 30%),linear-gradient(180deg,#fff 0%,#f8f8f4 100%)}
  .hero::before{content:"";position:absolute;z-index:-2;inset:0;background-image:radial-gradient(circle,rgba(32,33,36,.12) 1px,transparent 1.2px);background-size:28px 28px;mask-image:linear-gradient(180deg,rgba(0,0,0,.4),transparent 72%);opacity:.28}
  .hero::after{content:"";position:absolute;z-index:-1;left:4%;right:4%;top:56%;height:330px;border:1px dashed rgba(32,33,36,.08);border-radius:50%;transform:rotate(-4deg);pointer-events:none}
  .hero-head{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 360px;align-items:start;gap:0;position:relative;text-align:left;overflow:visible}
  .hero-copy-block{min-width:0;position:relative;z-index:3;overflow:visible}
  .breadcrumb{display:flex;justify-content:flex-start;flex-wrap:wrap;gap:7px;margin-bottom:22px;color:var(--muted);font-size:.68rem;font-weight:700}
  .breadcrumb span{opacity:.5}
  .hero-title{margin:0;font-size:clamp(4.35rem,8.7vw,8rem);line-height:.86;letter-spacing:-.082em;font-weight:800;text-wrap:balance;position:relative}
  .hero-word{position:relative;z-index:0;display:inline-block;color:var(--ink);text-decoration:none;transition:transform .28s var(--ease),opacity .22s ease}
  .hero-word::after{content:"";position:absolute;z-index:-1;left:-.025em;right:-.025em;bottom:.015em;height:.24em;border-radius:999px;background:transparent;transform:scaleX(.55) rotate(-1deg);transform-origin:left center;transition:background .24s ease,transform .3s var(--ease),opacity .2s ease;opacity:0}
  .hero-word:hover,.hero-word:focus-visible{opacity:1;transform:translateX(5px)}
  .hero[data-active="launch"] .hero-word[data-solution="launch"]::after{background:var(--lime);transform:scaleX(1) rotate(-1deg);opacity:1}
  .hero[data-active="connect"] .hero-word[data-solution="connect"]::after{background:var(--mint);transform:scaleX(1) rotate(.6deg);opacity:1}
  .hero[data-active="scale"] .hero-word[data-solution="scale"]::after{background:var(--lavender);transform:scaleX(1) rotate(-.6deg);opacity:1}
  .hero[data-active="build"] .hero-word[data-solution="build"]::after{background:var(--peach);transform:scaleX(1) rotate(.8deg);opacity:1}
  .hero-sub{max-width:650px;margin:28px 0 0;color:var(--muted);font-size:clamp(1.05rem,1.55vw,1.32rem);line-height:1.65}
  .hero-mascot{--mascot-shift:0px;--mascot-rotate:0deg;position:relative;height:430px;width:390px;display:grid;place-items:start center;align-self:start;isolation:isolate;margin-top:58px;margin-left:-72px;overflow:visible}
  .hero-mascot::before{content:"";position:absolute;z-index:-2;width:380px;height:380px;left:52%;top:46%;border:1px dashed;border-color:rgba(32,33,36,.11) transparent rgba(32,33,36,.07) transparent;border-radius:50%;transform:translate(-50%,-50%) rotate(-18deg);pointer-events:none}
  .hero-mascot::after{content:"";position:absolute;z-index:-3;width:300px;height:300px;left:52%;top:46%;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(194,255,2,.18),transparent 68%);transition:background .3s ease,transform .35s var(--ease)}
  .hero-mascot img{position:relative;z-index:2;width:auto;height:clamp(350px,27vw,405px);max-width:none;transform:translateX(var(--mascot-shift)) rotate(var(--mascot-rotate)) scaleX(-1);transform-origin:50% 78%;filter:drop-shadow(0 18px 18px rgba(32,33,36,.10));transition:transform .36s var(--ease),filter .28s ease;pointer-events:none}
  .hero[data-active="launch"] .hero-mascot{--mascot-shift:-6px;--mascot-rotate:-.45deg}
  .hero[data-active="connect"] .hero-mascot{--mascot-shift:0px;--mascot-rotate:0deg}
  .hero[data-active="scale"] .hero-mascot{--mascot-shift:7px;--mascot-rotate:.45deg}
  .hero[data-active="build"] .hero-mascot{--mascot-shift:12px;--mascot-rotate:.65deg}
  .hero[data-active="launch"] .hero-mascot::after{background:radial-gradient(circle,rgba(194,255,2,.26),transparent 68%)}
  .hero[data-active="connect"] .hero-mascot::after{background:radial-gradient(circle,rgba(153,254,237,.29),transparent 68%)}
  .hero[data-active="scale"] .hero-mascot::after{background:radial-gradient(circle,rgba(217,214,253,.42),transparent 68%)}
  .hero[data-active="build"] .hero-mascot::after{background:radial-gradient(circle,rgba(255,189,155,.36),transparent 68%)}
  .hero-mascot__prompt{position:absolute;z-index:4;right:-2px;top:34px;max-width:172px;padding:10px 13px;border:1px solid rgba(32,33,36,.08);border-radius:999px;background:rgba(255,255,255,.92);box-shadow:0 12px 28px rgba(32,33,36,.08);color:var(--muted);font-size:.58rem;font-weight:800;line-height:1.35;transition:transform .28s var(--ease),background .2s ease}
  .hero-guide{--packet-x:16.666%;--packet-color:var(--lime);position:relative;max-width:1110px;height:38px;margin:18px auto 0}
  .hero-guide::before{content:"";position:absolute;left:8%;right:8%;top:50%;height:1px;background:repeating-linear-gradient(90deg,rgba(32,33,36,.20) 0 5px,transparent 5px 11px)}
  .hero-guide__node{position:absolute;top:50%;width:8px;height:8px;border:2px solid rgba(32,33,36,.18);border-radius:50%;background:#fff;transform:translate(-50%,-50%);transition:background .22s ease,border-color .22s ease,transform .22s ease}
  .hero-guide__node:nth-of-type(1){left:12.5%}.hero-guide__node:nth-of-type(2){left:37.5%}.hero-guide__node:nth-of-type(3){left:62.5%}.hero-guide__node:nth-of-type(4){left:87.5%}
  .hero-guide__packet{position:absolute;z-index:2;left:var(--packet-x);top:50%;width:12px;height:12px;border-radius:50%;background:var(--packet-color);box-shadow:0 0 0 5px color-mix(in srgb,var(--packet-color) 20%,transparent);transform:translate(-50%,-50%);transition:left .45s var(--ease),background .24s ease}
  .hero[data-active="launch"] .hero-guide{--packet-x:12.5%;--packet-color:var(--lime)}
  .hero[data-active="connect"] .hero-guide{--packet-x:37.5%;--packet-color:var(--mint)}
  .hero[data-active="scale"] .hero-guide{--packet-x:62.5%;--packet-color:var(--lavender)}
  .hero[data-active="build"] .hero-guide{--packet-x:87.5%;--packet-color:var(--peach)}
  .hero[data-active="launch"] .hero-guide__node:nth-of-type(1),.hero[data-active="connect"] .hero-guide__node:nth-of-type(2),.hero[data-active="scale"] .hero-guide__node:nth-of-type(3),.hero[data-active="build"] .hero-guide__node:nth-of-type(4){background:var(--packet-color);border-color:var(--packet-color);transform:translate(-50%,-50%) scale(1.3)}
  .solutions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:8px;align-items:stretch}
  .machine-card{--machine-accent:var(--lime);position:relative;min-width:0;display:flex;flex-direction:column;padding:25px;border:1px solid rgba(32,33,36,.09);border-radius:34px;background:rgba(255,255,255,.94);box-shadow:0 20px 55px rgba(32,33,36,.085);overflow:hidden;transition:transform .32s var(--ease),box-shadow .32s var(--ease),border-color .25s ease;background .25s ease}
  .machine-card::before{content:"";position:absolute;z-index:0;right:-90px;top:-105px;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,rgba(194,255,2,.18),transparent 68%);opacity:.5;pointer-events:none;transition:opacity .3s ease,transform .35s var(--ease)}
  .machine-card--connect{--machine-accent:var(--mint)}
  .machine-card--connect::before{background:radial-gradient(circle,rgba(153,254,237,.26),transparent 68%)}
  .machine-card--scale{--machine-accent:var(--lavender)}
  .machine-card--scale::before{background:radial-gradient(circle,rgba(217,214,253,.34),transparent 68%)}
  .machine-card--build{--machine-accent:var(--peach)}
  .machine-card--build::before{background:radial-gradient(circle,rgba(255,189,155,.34),transparent 68%)}
  .machine-card:hover,.machine-card:focus-within,.machine-card.is-active{transform:translateY(-7px);border-color:color-mix(in srgb,var(--machine-accent) 68%,rgba(32,33,36,.16));box-shadow:0 30px 72px rgba(32,33,36,.13)}
  .machine-card:hover::before,.machine-card:focus-within::before,.machine-card.is-active::before{opacity:1;transform:scale(1.08)}
  .machine-card__head,.machine-card__stage,.machine-card__info,.machine-card__actions{position:relative;z-index:1}
  .machine-card__top{display:flex;align-items:center;justify-content:space-between;gap:14px}
  .machine-card__number{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:var(--machine-accent);font-size:.65rem;font-weight:800}
  .machine-card__stage-label{color:var(--muted);font-size:.62rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .machine-card h2{margin:27px 0 0;font-size:clamp(1.65rem,2.15vw,2.5rem);line-height:1;letter-spacing:-.052em;font-weight:800;text-wrap:balance}
  .machine-card__summary{min-height:68px;margin:13px 0 0;color:var(--muted);font-size:.82rem;line-height:1.58}
  .machine-card__stage{height:300px;margin-top:22px;overflow:hidden;border:1px solid rgba(32,33,36,.07);border-radius:25px;isolation:isolate;transition:border-color .3s ease,box-shadow .3s ease}
  .machine-card:hover .machine-card__stage,.machine-card:focus-within .machine-card__stage{border-color:rgba(32,33,36,.12);box-shadow:0 16px 38px rgba(32,33,36,.08)}
  .build-machine{display:grid;place-items:center;background:radial-gradient(circle at 18% 20%,rgba(194,255,2,.22),transparent 24%),radial-gradient(circle at 82% 76%,rgba(255,189,155,.36),transparent 32%),linear-gradient(145deg,#fff,#f7f7f2)}
  .build-machine__panel{width:min(78%,230px);padding:18px;border:1px solid rgba(32,33,36,.09);border-radius:22px;background:rgba(255,255,255,.88);box-shadow:0 22px 48px rgba(32,33,36,.12)}
  .build-machine__panel span{display:block;height:9px;margin:9px 0;border-radius:999px;background:rgba(32,33,36,.12)}
  .build-machine__panel span:nth-child(1){width:54%;background:var(--peach)}
  .build-machine__panel span:nth-child(2){width:88%}
  .build-machine__panel span:nth-child(3){width:68%;background:var(--mint)}
  .build-machine__panel span:nth-child(4){width:76%}
  .launch-machine{background:radial-gradient(circle at 72% 12%,rgba(217,214,253,.48),transparent 28%),radial-gradient(circle at 20% 88%,rgba(153,254,237,.34),transparent 26%),linear-gradient(145deg,#fff,#f7f7f2)}
  .launch-preview-orbit{position:absolute;inset:11% 2% 4% 10%;border:1px solid rgba(32,33,36,.11);border-radius:50%;transform:rotate(-15deg)}
  .launch-preview-orbit::after{content:"";position:absolute;inset:18%;border:1px dashed rgba(32,33,36,.09);border-radius:50%;animation:previewSpin 24s linear infinite}
  .launch-preview-browser{position:absolute;z-index:3;left:9%;right:5%;top:28px;overflow:hidden;border:6px solid rgba(255,255,255,.94);border-radius:20px;background:#fff;box-shadow:0 22px 48px rgba(32,33,36,.14);transform:rotate(1.4deg);transition:transform .35s var(--ease)}
  .launch-preview-browser__bar{height:25px;display:flex;align-items:center;gap:5px;padding:0 8px;background:#ecece9}
  .launch-preview-browser__bar i{width:6px;height:6px;border-radius:50%;background:#c1c2bf}
  .launch-preview-browser img{display:block;width:100%;height:190px;object-fit:cover;object-position:top;transition:transform .55s var(--ease)}
  .launch-preview-status{position:absolute;z-index:5;left:15px;bottom:14px;display:grid;grid-template-columns:31px 1fr;align-items:center;gap:9px;min-width:188px;padding:10px 12px;border:1px solid rgba(255,255,255,.9);border-radius:15px;background:rgba(255,255,255,.93);box-shadow:0 15px 36px rgba(32,33,36,.11);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);transition:transform .35s var(--ease)}
  .launch-preview-status__icon{width:31px;height:31px;display:grid;place-items:center;border-radius:50%;background:var(--lime);font-size:.7rem;font-weight:900}
  .launch-preview-status strong,.launch-preview-status small{display:block}
  .launch-preview-status strong{font-size:.62rem;line-height:1.2}
  .launch-preview-status small{margin-top:3px;color:var(--muted);font-size:.48rem;line-height:1.25}
  .machine-card--launch:hover .launch-preview-browser,.machine-card--launch:focus-within .launch-preview-browser,.machine-card--launch.is-active .launch-preview-browser{transform:rotate(.5deg) translateY(-6px)}
  .machine-card--launch:hover .launch-preview-browser img,.machine-card--launch:focus-within .launch-preview-browser img,.machine-card--launch.is-active .launch-preview-browser img{transform:translateY(-5px) scale(1.015)}
  .machine-card--launch:hover .launch-preview-status,.machine-card--launch:focus-within .launch-preview-status,.machine-card--launch.is-active .launch-preview-status{transform:translateY(-5px)}
  .connect-machine{background:radial-gradient(circle at 50% 48%,rgba(255,255,255,.96),transparent 26%),linear-gradient(145deg,rgba(217,214,253,.72),rgba(153,254,237,.60) 58%,rgba(255,189,155,.33))}
  .connect-machine::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(32,33,36,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(32,33,36,.045) 1px,transparent 1px);background-size:26px 26px;opacity:.55}
  .punchout-preview-source{position:absolute;z-index:4;left:12px;top:50%;width:84px;height:84px;display:grid;place-items:center;text-align:center;border:1px solid rgba(255,255,255,.9);border-radius:50%;background:#fff;box-shadow:0 17px 38px rgba(32,33,36,.12);transform:translateY(-50%)}
  .punchout-preview-source::before{content:"";position:absolute;inset:-9px;border:1px dashed rgba(32,33,36,.16);border-radius:50%;animation:previewSpin 22s linear infinite}
  .punchout-preview-source strong{display:block;color:#1b74bb;font-size:1.13rem;letter-spacing:-.04em}
  .punchout-preview-source small{display:block;margin-top:3px;color:var(--muted);font-size:.42rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .punchout-preview-sync{position:absolute;z-index:5;left:46%;top:50%;width:68px;height:68px;display:grid;place-items:center;text-align:center;border-radius:50%;background:var(--ink);color:#fff;box-shadow:0 17px 38px rgba(32,33,36,.18);transform:translate(-50%,-50%)}
  .punchout-preview-sync::before{content:"";position:absolute;inset:-8px;border:1px dashed rgba(32,33,36,.18);border-radius:50%;animation:previewSpin 16s linear infinite reverse}
  .punchout-preview-sync span{font-size:.47rem;font-weight:800;line-height:1.2}
  .punchout-preview-line{position:absolute;z-index:2;top:50%;height:1px;background:repeating-linear-gradient(90deg,rgba(32,33,36,.34) 0 5px,transparent 5px 10px)}
  .punchout-preview-line--in{left:96px;width:calc(46% - 127px)}
  .punchout-preview-line--out{left:calc(46% + 34px);right:84px}
  .punchout-preview-packet{position:absolute;z-index:7;top:calc(50% - 4px);width:8px;height:8px;border-radius:50%;background:var(--lime);animation:punchoutPacket 5.2s linear infinite}
  .punchout-preview-packet--two{background:var(--mint);animation-delay:-1.7s}
  .punchout-preview-packet--three{background:var(--peach);animation-delay:-3.4s}
  .punchout-preview-phone{position:absolute;z-index:4;right:12px;top:37px;width:72px;height:222px;padding:5px;border-radius:22px;background:var(--ink);box-shadow:0 20px 42px rgba(32,33,36,.2);transform:rotate(3deg);transition:transform .35s var(--ease)}
