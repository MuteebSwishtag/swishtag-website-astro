---
import SharedFaq from '../../components/layout/SharedFaq.astro';
import faqs from '../../data/faqs.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import solutionsCssUrl from "../../styles/pages/solutions.css?rawcss";

export const prerender = true;

const title = "Solutions for Promotional Products Distributors | Swishtag";
const description = "Compare solution paths for promotional products distributors: Company Store Launch, PunchOut Solutions, Enterprise Company Store Automation, and Custom Software & Automation.";
const canonical = "https://cms.swishtag.com/solutions/";
const robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <script slot="head" type="application/ld+json" is:inline>
  {
      "@context":"https://schema.org",
      "@type":"CollectionPage",
      "name":"Solutions for Promotional Products Distributors",
      "url":"https://cms.swishtag.com/solutions/",
      "description":"Solution paths for promotional products distributors: launch a company store, connect PunchOut procurement, automate multi-store operations, or build custom software and integrations.",
      "mainEntity":{
        "@type":"ItemList",
        "itemListElement":[
          {"@type":"ListItem","position":1,"name":"Company Store Launch","url":"https://cms.swishtag.com/solutions/shopify-company-store/"},
          {"@type":"ListItem","position":2,"name":"PunchOut Solutions","url":"https://cms.swishtag.com/solutions/punchout-solutions/"},
          {"@type":"ListItem","position":3,"name":"Enterprise Company Store Automation","url":"https://cms.swishtag.com/solutions/enterprise-shopify-automation/"},
          {"@type":"ListItem","position":4,"name":"Custom Software & Automation","url":"https://cms.swishtag.com/solutions/custom-software-automation/"}
        ]
      }
    }
  </script>
  <link slot="head" rel="stylesheet" href={solutionsCssUrl} />
  <main class="solutions-page">
  <section class="hero" data-active="launch" id="top">
  <div class="page-shell">
  <div class="hero-head">
  <div class="hero-copy-block">
  <nav aria-label="Breadcrumb" class="breadcrumb"><a href="../">Home</a><span>/</span><strong>Solutions</strong></nav>
  <p class="eyebrow">Solutions for promotional products distributors</p>
  <h1 class="hero-title"><a class="hero-word" data-solution="launch" href="/solutions/shopify-company-store/">Launch.</a><br/><a class="hero-word" data-solution="connect" href="/solutions/punchout-solutions/">Connect.</a><br/><a class="hero-word" data-solution="scale" href="/solutions/enterprise-shopify-automation/">Scale.</a><br/><a class="hero-word" data-solution="build" href="/solutions/custom-software-automation/">Build.</a></h1>
  <p class="hero-sub">Choose where you are today. Launch a client store, connect Shopify stores with enterprise procurement workflows, scale multi-store operations, or build custom software around your workflow.</p>
  </div>
  <div class="hero-mascot">
  <img alt="Swishtag astronaut guiding visitors through Launch, Connect, Scale, and Build" decoding="async" fetchpriority="high" height="585" src="/assets/inline/solutions-hub-astronaut-39a3812dba.webp" width="420"/>
  <span class="hero-mascot__prompt" id="heroMascotPrompt">Starting a client store?</span>
  </div>
  </div>
  <div aria-hidden="true" class="hero-guide"><span class="hero-guide__node"></span><span class="hero-guide__node"></span><span class="hero-guide__node"></span><span class="hero-guide__node"></span><span class="hero-guide__packet"></span></div>
  <div class="solutions" id="solutionSelector">
  <article aria-label="Open Company Store Launch" class="machine-card machine-card--launch st-clickable-card" data-card-href="/solutions/shopify-company-store/" data-solution-card="launch" role="link" tabindex="0">
  <div class="machine-card__head">
  <div class="machine-card__top"><span class="machine-card__number">01</span><span class="machine-card__stage-label">Launch</span></div>
  <h2>Company Store Launch</h2>
  <p class="machine-card__summary">Launch a branded Shopify company store that gives your client an easier way to order again.</p>
  </div>
  <div aria-label="Company Store Launch storefront preview" class="machine-card__stage launch-machine">
  <span aria-hidden="true" class="launch-preview-orbit"></span>
  <div aria-hidden="true" class="launch-preview-browser">
  <div class="launch-preview-browser__bar"><i></i><i></i><i></i></div>
  <img alt="Shopify company store storefront preview" decoding="async" fetchpriority="high" height="418" loading="eager" src="/assets/inline/solutions-company-store-preview-4e1f4fdee7.webp" width="640"/>
  </div>
  <div aria-hidden="true" class="launch-preview-status"><span class="launch-preview-status__icon">✓</span><span><strong>Store ready to launch</strong><small>POD, stocked, or hybrid</small></span></div>
  </div>
  <div class="machine-card__info">
  <span class="machine-card__price"><strong>From $2,000</strong><small>Company store launch</small></span>
  <span class="machine-card__chips"><span>Shopify</span><span>Repeat orders</span><span>Fulfillment</span></span>
  </div>
  <div class="machine-card__actions"><a class="machine-more" href="/solutions/shopify-company-store/"><span>Explore Company Store</span><span aria-hidden="true" class="machine-more__arrow">↗</span></a></div>
  </article>
  
  <article aria-label="Open PunchOut Solutions" class="machine-card machine-card--connect st-clickable-card" data-card-href="/solutions/punchout-solutions/" data-solution-card="connect" role="link" tabindex="0">
  <div class="machine-card__head">
  <div class="machine-card__top"><span class="machine-card__number">02</span><span class="machine-card__stage-label">Connect</span></div>
  <h2>PunchOut Solutions</h2>
  <p class="machine-card__summary">Connect Shopify company stores with enterprise procurement systems, cXML or OCI catalogs, and buyer purchasing workflows.</p>
  </div>
  <div aria-label="PunchOut procurement connection preview" class="machine-card__stage connect-machine">
  <span aria-hidden="true" class="punchout-preview-line punchout-preview-line--in"></span>
  <span aria-hidden="true" class="punchout-preview-line punchout-preview-line--out"></span>
  <span aria-hidden="true" class="punchout-preview-packet"></span>
  <span aria-hidden="true" class="punchout-preview-packet punchout-preview-packet--two"></span>
  <span aria-hidden="true" class="punchout-preview-packet punchout-preview-packet--three"></span>
  <div aria-hidden="true" class="punchout-preview-source"><strong>BUYER</strong><small>Procurement</small></div>
  <div aria-hidden="true" class="punchout-preview-sync"><span>SHOPIFY<br/>STORE</span></div>
  <div aria-hidden="true" class="punchout-preview-phone"><div class="punchout-preview-phone__screen"><small>Catalog</small><strong>Order<br/>items</strong><div class="punchout-preview-products"><i></i><i></i><i></i><i></i></div></div></div>
  <span class="punchout-preview-label">cXML / OCI</span>
  </div>
  <div class="machine-card__info">
  <span class="machine-card__price"><strong>Custom</strong><small>Integration scope</small></span>
  <span class="machine-card__chips"><span>cXML / OCI</span><span>Procurement</span><span>Catalogs</span></span>
  </div>
  <div class="machine-card__actions"><a class="machine-more" href="/solutions/punchout-solutions/"><span>Explore PunchOut</span><span aria-hidden="true" class="machine-more__arrow">↗</span></a></div>
  </article>
  <article aria-label="Open Enterprise Automation" class="machine-card machine-card--scale st-clickable-card" data-card-href="/solutions/enterprise-shopify-automation/" data-solution-card="scale" role="link" tabindex="0">
  <div class="machine-card__head">
  <div class="machine-card__top"><span class="machine-card__number">03</span><span class="machine-card__stage-label">Scale</span></div>
  <h2>Enterprise Automation</h2>
  <p class="machine-card__summary">Bring multiple Shopify company stores into one control layer, then automate the workflows that slow operations down.</p>
  </div>
  <div aria-label="Enterprise company store Control Center preview" class="machine-card__stage scale-machine">
  <span aria-hidden="true" class="enterprise-preview-line enterprise-preview-line--1"></span><span aria-hidden="true" class="enterprise-preview-line enterprise-preview-line--2"></span><span aria-hidden="true" class="enterprise-preview-line enterprise-preview-line--3"></span><span aria-hidden="true" class="enterprise-preview-line enterprise-preview-line--4"></span>
  <div aria-hidden="true" class="enterprise-preview-browser"><div class="enterprise-preview-browser__bar"><i></i><i></i><i></i></div><img alt="Swishtag enterprise company store dashboard preview" decoding="async" height="262" loading="lazy" src="/assets/inline/solutions-enterprise-preview-9b286b8e36.webp" width="400"/></div>
  <span aria-hidden="true" class="enterprise-preview-node enterprise-preview-node--stores">Company Stores</span>
  <span aria-hidden="true" class="enterprise-preview-node enterprise-preview-node--punchout">PunchOut</span>
  <span aria-hidden="true" class="enterprise-preview-node enterprise-preview-node--orders">Order Automation</span>
  <span aria-hidden="true" class="enterprise-preview-node enterprise-preview-node--apis">Supplier APIs</span>
  </div>
  <div class="machine-card__info">
  <span class="machine-card__price"><strong>Custom</strong><small>Enterprise scope</small></span>
  <span class="machine-card__chips"><span>Multi-store</span><span>PunchOut</span><span>Automation</span></span>
  </div>
  <div class="machine-card__actions"><a class="machine-more" href="/solutions/enterprise-shopify-automation/"><span>Explore Automation</span><span aria-hidden="true" class="machine-more__arrow">↗</span></a></div>
  </article>
  <article aria-label="Open Custom Software and Automation" class="machine-card machine-card--build st-clickable-card" data-card-href="/solutions/custom-software-automation/" data-solution-card="build" role="link" tabindex="0">
  <div class="machine-card__head">
  <div class="machine-card__top"><span class="machine-card__number">04</span><span class="machine-card__stage-label">Build</span></div>
  <h2>Custom Software &amp; Automation</h2>
  <p class="machine-card__summary">Design a custom system, integration, SaaS workflow or automation layer around the way your team actually works.</p>
  </div>
  <div aria-label="Custom software workflow preview" class="machine-card__stage build-machine">
  <div aria-hidden="true" class="build-machine__panel"><span></span><span></span><span></span><span></span></div>
  </div>
  <div class="machine-card__info">
  <span class="machine-card__price"><strong>Custom</strong><small>Discovery + build</small></span>
  <span class="machine-card__chips"><span>Custom apps</span><span>APIs</span><span>Automation</span></span>
  </div>
  <div class="machine-card__actions"><a class="machine-more" href="/solutions/custom-software-automation/"><span>Explore Custom Builds</span><span aria-hidden="true" class="machine-more__arrow">↗</span></a></div>
  </article></div>
  <p class="hero-note">Start where you are. <span>Add more when you need it.</span></p>
  </div>
  </section>
  <section class="section comparison-section" id="compare">
  <div class="page-shell">
  <div class="comparison-head">
  <div><p class="eyebrow">Compare in 30 seconds</p><h2 class="section-title">Core solutions. Different levels of complexity.</h2></div>
  <p class="section-copy">You do not need the biggest package. Choose the smallest solution that solves the operational problem in front of you.</p>
  </div>
  <div class="comparison-wrap">
  <table class="comparison-table">
  <thead>
  <tr>
  <th>Capability</th>
  <th><div class="compare-product"><span class="compare-product__number">01</span><span><strong>Company Store Launch</strong><small>Launch</small></span></div></th>
  <th><div class="compare-product"><span class="compare-product__number">02</span><span><strong>PunchOut Solutions</strong><small>Connect</small></span></div></th>
  <th><div class="compare-product"><span class="compare-product__number">03</span><span><strong>Enterprise Automation</strong><small>Scale</small></span></div></th>
  <th><div class="compare-product"><span class="compare-product__number">04</span><span><strong>Custom Software</strong><small>Build</small></span></div></th>
  </tr>
  </thead>
  <tbody>
  <tr><td>Shopify company store</td><td><span class="check">Included</span></td><td><span class="check">Connected store</span></td><td><span class="check">Included</span></td><td><span class="optional">Optional</span></td></tr>
  <tr><td>Branded client experience</td><td><span class="check">Included</span></td><td><span class="check">Store-dependent</span></td><td><span class="check">Included</span></td><td><span class="check">Included</span></td></tr>
  <tr><td>POD / stocked inventory / hybrid</td><td><span class="check">Supported</span></td><td>Store-dependent</td><td><span class="check">Supported</span></td><td><span class="optional">Optional</span></td></tr>
  <tr><td>PunchOut procurement</td><td>—</td><td><span class="check">Core scope</span></td><td><span class="check">Available</span></td><td><span class="optional">Optional</span></td></tr>
  <tr><td>Catalog synchronization</td><td>Manual / app-based</td><td><span class="check">Procurement catalogs</span></td><td><span class="check">Available</span></td><td><span class="check">Available</span></td></tr>
  <tr><td>Multiple company stores</td><td>Single-store focus</td><td>Buyer-dependent</td><td><span class="check">Core use case</span></td><td><span class="optional">Optional</span></td></tr>
  <tr><td>Centralized reporting</td><td>Store level</td><td>Buyer-dependent</td><td><span class="check">Included in platform</span></td><td><span class="check">Available</span></td></tr>
  <tr><td>Supplier / order automation</td><td><span class="optional">Optional add-on</span></td><td><span class="check">Procurement flow</span></td><td><span class="check">Available</span></td><td><span class="check">Available</span></td></tr>
  <tr><td>PunchOut catalogs</td><td>—</td><td><span class="check">Core scope</span></td><td><span class="check">Available</span></td><td>—</td> </tr>
  <tr><td>Accounting / ERP integrations</td><td><span class="optional">Optional</span></td><td><span class="optional">Optional</span></td><td><span class="check">Available</span></td><td><span class="check">Available</span></td></tr>
  <tr><td>Custom workflows</td><td>Limited</td><td>Limited</td><td><span class="check">Built for it</span></td><td><span class="check">Core scope</span></td></tr>
  <tr><td>Starting investment</td><td><strong>$2,000</strong></td><td><strong>Custom</strong></td><td><strong>Custom</strong></td><td><strong>Custom</strong></td></tr>
  <tr><td>See details</td><td><a class="compare-link" href="/solutions/shopify-company-store/">View solution ↗</a></td><td><a class="compare-link" href="/solutions/punchout-solutions/">View solution ↗</a></td><td><a class="compare-link" href="/solutions/enterprise-shopify-automation/">View solution ↗</a></td><td><a class="compare-link" href="/solutions/custom-software-automation/">View solution ↗</a></td></tr>
  </tbody>
  </table>
  </div>
  </div>
  </section>
  <SharedFaq {...faqs.solutions} />
  <section class="final-section">
  <div class="page-shell">
  <div class="final-cta">
  <div><p class="eyebrow">Not sure which one fits?</p><h2>Tell us how your company stores work today.</h2><p>We will help you identify whether you need to launch, connect, automate, or build something custom.</p></div>
  <a class="btn btn--dark" href="../book-demo/?interest=solutions">Book a Demo <span aria-hidden="true">↗</span></a>
  </div>
  </div>
  </section>
  </main>
  <script slot="scripts" is:inline>
  (() => {
    const hero = document.querySelector('.solutions-page .hero');
    const solutionCards = [...document.querySelectorAll('.solutions-page [data-solution-card]')];
    const solutionWords = [...document.querySelectorAll('.solutions-page .hero-word[data-solution]')];
    const mascotPrompt = document.getElementById('heroMascotPrompt');
    const prompts = {
      launch: 'Starting a client store?',
      connect: 'Connecting enterprise procurement?',
      scale: 'Managing too many stores?',
      build: 'Need something custom?'
    };

    function activateSolution(key) {
      if (!hero || !key) return;
      hero.dataset.active = key;
      if (mascotPrompt) mascotPrompt.textContent = prompts[key] || prompts.launch;
      solutionCards.forEach((card) => {
        card.classList.toggle('is-active', card.dataset.solutionCard === key);
      });
    }

    [...solutionCards, ...solutionWords].forEach((el) => {
      const key = el.dataset.solutionCard || el.dataset.solution;
      el.addEventListener('pointerenter', () => activateSolution(key));
      el.addEventListener('focus', () => activateSolution(key));
    });

    activateSolution('launch');

    if ('IntersectionObserver' in window && matchMedia('(max-width: 900px)').matches) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) activateSolution(visible.target.dataset.solutionCard);
      }, { rootMargin: '-28% 0px -42%', threshold: [.15, .35, .55] });
      solutionCards.forEach((card) => observer.observe(card));
    }
  })();
  </script>
</BaseLayout>
