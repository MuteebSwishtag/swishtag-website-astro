---
import SharedFaq from '../../../components/layout/SharedFaq.astro';
import faqs from '../../../data/faqs.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import customSoftwareAutomationCssUrl from "../../../styles/pages/custom-software-automation.css?rawcss";

export const prerender = true;

const title = "Custom Software & Business Automation Solutions | Swishtag";
const description = "Have an ecommerce, integration, automation, SaaS or AI idea? Swishtag turns business problems into working systems with discovery, development, QA, deployment, documentation and training.";
const canonical = "https://cms.swishtag.com/solutions/custom-software-automation/";
const robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const formSubmissionMode = (import.meta.env.PUBLIC_FORM_SUBMISSION_MODE ?? "direct").toLowerCase();
const directFormEndpoint = import.meta.env.PUBLIC_DIRECT_FORM_ENDPOINT ?? "/api/forms/submit";
const wordpressFormEndpoint = import.meta.env.PUBLIC_WORDPRESS_FORM_ENDPOINT ?? "https://cms.swishtag.com/wp-json/astro-form/v1/submit";
const formEndpoint = formSubmissionMode === "wordpress" ? wordpressFormEndpoint : directFormEndpoint;
const formToken = formSubmissionMode === "wordpress" ? (import.meta.env.PUBLIC_ASTRO_FORM_TOKEN ?? "") : "";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <meta slot="head" property="og:type" content="website">
  <meta slot="head" property="og:site_name" content="Swishtag">
  <meta slot="head" property="og:title" content="Have an idea? Let’s build it. | Swishtag">
  <meta slot="head" property="og:description" content="Custom ecommerce technology, business automation, integrations, SaaS and practical AI, delivered from idea to working system.">
  <meta slot="head" property="og:url" content="https://cms.swishtag.com/solutions/custom-software-automation/">
  <meta slot="head" name="twitter:card" content="summary_large_image">
  <script slot="head" type="application/ld+json" is:inline>
  {
    "@context":"https://schema.org",
    "@graph":[
      {
        "@type":"Organization",
        "@id":"https://cms.swishtag.com/#organization",
        "name":"Swishtag",
        "url":"https://cms.swishtag.com/"
      },
      {
        "@type":"WebSite",
        "@id":"https://cms.swishtag.com/#website",
        "url":"https://cms.swishtag.com/",
        "name":"Swishtag",
        "publisher":{"@id":"https://cms.swishtag.com/#organization"}
      },
      {
        "@type":"WebPage",
        "@id":"https://cms.swishtag.com/solutions/custom-software-automation/#webpage",
        "url":"https://cms.swishtag.com/solutions/custom-software-automation/",
        "name":"Custom Software & Business Automation Solutions | Swishtag",
        "description":"Custom ecommerce technology, business automation, integrations, SaaS and AI-enabled systems from discovery to deployment.",
        "isPartOf":{"@id":"https://cms.swishtag.com/#website"},
        "about":{"@id":"https://cms.swishtag.com/#organization"}
      },
      {
        "@type":"Service",
        "@id":"https://cms.swishtag.com/solutions/custom-software-automation/#service",
        "name":"Custom Software & Business Automation",
        "serviceType":["Ecommerce Technology","Business Automation","System Integrations","SaaS Development","AI Automation","Custom Business Software"],
        "provider":{"@id":"https://cms.swishtag.com/#organization"},
        "url":"https://cms.swishtag.com/solutions/custom-software-automation/"
      },
      {
        "@type":"FAQPage",
        "@id":"https://cms.swishtag.com/solutions/custom-software-automation/#faq",
        "mainEntity":[
          {
            "@type":"Question",
            "name":"Do I need a technical specification before speaking with Swishtag?",
            "acceptedAnswer":{"@type":"Answer","text":"No. Start with the business problem, workflow or idea. Swishtag can help translate it into requirements, phases, architecture and a development plan."}
          },
          {
            "@type":"Question",
            "name":"Can Swishtag work with an existing system or MVP?",
            "acceptedAnswer":{"@type":"Answer","text":"Yes. A custom project can start from an idea, existing workflow, MVP or live platform that needs integrations, automation or rebuilding."}
          },
          {
            "@type":"Question",
            "name":"How are custom projects priced?",
            "acceptedAnswer":{"@type":"Answer","text":"Pricing depends on the approved scope, integrations, risks and phases. After discovery and requirements planning, Swishtag provides a development plan with timeline and cost."}
          }
        ]
      }
    ]
  }
  </script>
  <link slot="head" rel="stylesheet" href={customSoftwareAutomationCssUrl} />
  <main>
  <section class="hero">
    <div class="page-shell hero-grid">
      <div data-reveal>
        <p class="eyebrow">Custom ecommerce technology & automation</p>
        <h1 class="hero-title">Have an idea? <span class="highlight">Let’s build it.</span></h1>
        <p class="hero-statement">What would change if the system your business actually needs finally existed?</p>
        <p class="hero-copy">
          Whether you want to connect ecommerce with internal systems, remove repetitive work,
          build a SaaS product or add practical AI to a workflow, Swishtag can take the idea from
          business problem to a working, documented system.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="#discuss-idea">Discuss your idea <span aria-hidden="true">↗</span></a>
          <a class="btn btn--secondary" href="#process">See how we work</a>
        </div>
        <div class="hero-note"><span class="hero-note-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>No technical specification required. Build the rocket while you think about the idea.</span></div>
      </div>
  
  
      <div class="rocket-builder" id="rocketBuilder" data-reveal aria-label="Interactive Swishtag rocket builder">
        <div class="rocket-builder__top">
          <div>
            <span class="rocket-builder__kicker">Build your idea</span>
            <strong>Connect the parts. Then launch it.</strong>
          </div>
          <div class="rocket-builder__hud">
            <div class="rocket-progress" aria-live="polite"><b id="rocketProgressCount">0 / 5</b> connected</div>
            <button class="rocket-reset" id="rocketResetButton" type="button" aria-label="Rewind rocket builder" title="Rewind" disabled>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7H4v-4"></path><path d="M4.6 7.4A8 8 0 1 1 4 14"></path></svg>
            </button>
          </div>
        </div>
  
        <div class="rocket-builder__stage" id="rocketBuilderStage">
          <div class="launch-streaks" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  
          <span class="rocket-target" data-slot="nose"></span>
          <span class="rocket-target" data-slot="cabin"></span>
          <span class="rocket-target" data-slot="core"></span>
          <span class="rocket-target" data-slot="fins"></span>
          <span class="rocket-target" data-slot="engine"></span>
  
          <button class="rocket-part rocket-part--nose" type="button" data-part="nose" aria-label="Place rocket nose">
            <svg class="rocket-part__art" viewBox="0 0 100 70" aria-hidden="true">
              <path class="rp-fill" d="M50 6C29 24 21 42 23 62h54c2-20-6-38-27-56Z"/>
            </svg>
            <span class="rocket-part__label">Nose</span>
          </button>
  
          <button class="rocket-part rocket-part--cabin" type="button" data-part="cabin" aria-label="Place rocket cabin">
            <svg class="rocket-part__art" viewBox="0 0 100 82" aria-hidden="true">
              <rect class="rp-fill" x="20" y="8" width="60" height="66" rx="15"/>
              <circle class="rp-window" cx="50" cy="39" r="17"/>
            </svg>
            <span class="rocket-part__label">Cabin</span>
          </button>
  
          <button class="rocket-part rocket-part--core" type="button" data-part="core" aria-label="Place rocket core">
            <svg class="rocket-part__art" viewBox="0 0 100 84" aria-hidden="true">
              <path class="rp-fill" d="M21 8h58v68H21Z"/>
              <path class="rp-window" d="M35 24h30M35 39h21" fill="none"/>
            </svg>
            <span class="rocket-part__label">Core</span>
          </button>
  
          <button class="rocket-part rocket-part--fins" type="button" data-part="fins" aria-label="Place rocket fins">
            <svg class="rocket-part__art" viewBox="0 0 110 76" aria-hidden="true">
              <path class="rp-fill" d="M43 16 10 61l36-9V20Z"/>
              <path class="rp-fill" d="m67 16 33 45-36-9V20Z"/>
            </svg>
            <span class="rocket-part__label">Fins</span>
          </button>
  
          <button class="rocket-part rocket-part--engine" type="button" data-part="engine" aria-label="Place rocket engine">
            <svg class="rocket-part__art" viewBox="0 0 100 64" aria-hidden="true">
              <path class="rp-fill" d="M26 9h48l-8 31H34Z"/>
              <path class="rp-window" d="M39 40h22l-5 17H44Z"/>
            </svg>
            <span class="rocket-part__label">Engine</span>
          </button>
  
          <div class="rocket-assembly" aria-label="Rocket assembly area">
            <svg class="rocket-blueprint" role="img" aria-label="Swishtag rocket blueprint" viewBox="0 0 220 430">
              <g data-built-part="nose">
                <path class="rocket-shape rocket-shape--nose" d="M110 16C83 45 72 74 74 110h72c2-36-9-65-36-94Z"/>
              </g>
  
              <g data-built-part="cabin">
                <path class="rocket-shape rocket-shape--cabin" d="M74 100h72v112c0 8-6 14-14 14H88c-8 0-14-6-14-14Z"/>
                <circle class="rocket-window-shape" cx="110" cy="148" r="23"/>
                <path class="rocket-detail-shape" d="M88 188h44"/>
              </g>
  
              <g data-built-part="core">
                <path class="rocket-shape rocket-shape--core" d="M78 218h64v84H78Z"/>
                <path class="rocket-detail-shape" d="M89 245h42M89 263h28"/>
                <rect class="rocket-core-accent" x="89" y="280" width="42" height="9" rx="4.5"/>
              </g>
  
              <g data-built-part="fins">
                <path class="rocket-shape rocket-shape--fins" d="M79 256 35 334l44-18Z"/>
                <path class="rocket-shape rocket-shape--fins" d="m141 256 44 78-44-18Z"/>
              </g>
  
              <g data-built-part="engine">
                <path class="rocket-shape rocket-shape--engine" d="M86 301h48l-5 35H91Z"/>
                <path class="rocket-shape rocket-shape--nozzle" d="M91 334h14l-3 38H88Z"/>
                <path class="rocket-shape rocket-shape--nozzle" d="M103 334h14v38h-14Z"/>
                <path class="rocket-shape rocket-shape--nozzle" d="M115 334h14l3 38h-14Z"/>
              </g>
            </svg>
  
            <div class="rocket-thrust" aria-hidden="true"><span></span><span></span></div>
            <div class="launch-haze" aria-hidden="true"></div>
          </div>
        </div>
  
        <div class="rocket-builder__footer">
          <p class="rocket-builder__message" id="rocketBuilderMessage" aria-live="polite">
            <span><strong>Every strong system starts as separate pieces.</strong> Drag or tap each component to bring the idea together.</span>
            <a class="builder-cta" href="/book-demo/">Tell us what you want to build →</a>
          </p>
          <button class="ignition-btn" id="ignitionButton" type="button" disabled>Begin ignition</button>
        </div>
      </div>
  
    </div>
  </section>
  
  <section class="credibility" aria-label="Swishtag trust indicators">
    <div class="page-shell credibility-panel" data-reveal>
      <div class="credibility-copy">
        <h2>More than developers. One accountable delivery team.</h2>
        <p>Discovery, UX, engineering, integrations, QA, deployment, documentation and training, managed as one connected project.</p>
      </div>
  
      <div class="hero-trust-card-grid--custom">
        <div aria-label="Shopify Partner" class="hero-trust-card">
          <div class="hero-trust-card__logo">
            <div aria-hidden="true" class="trust-brand trust-brand--shopify">
              <svg viewBox="0 0 34 40"><path d="M8 10h20l2.2 25H5.8L8 10Z" fill="#95BF47"></path><path d="M11 12c.3-6 2.8-9 6.1-9 3.4 0 5.7 3 6 9" fill="none" stroke="#95BF47" stroke-width="3" stroke-linecap="round"></path><path d="M20.8 16.5c-1-.6-2.3-.9-3.5-.9-1.1 0-1.8.4-1.8 1.2 0 .7.6 1 1.9 1.5 2.4.9 3.4 2.2 3 4.3-.4 2.6-2.7 4.3-5.5 4.3-1.9 0-3.7-.5-4.9-1.4l1.2-3.2c1.2.9 2.5 1.3 3.9 1.3 1.1 0 1.9-.4 2-1.1.1-.7-.4-1.1-1.8-1.5-2.2-.8-3.3-2-2.9-4 .4-2.5 2.5-4.2 5.5-4.2 1.7 0 3.1.4 4.1 1l-1.2 2.7Z" fill="#fff"></path></svg>
              <span><b>shopify</b><small>PARTNER</small></span>
            </div>
          </div>
          <div class="hero-trust-card__copy"><small>OFFICIAL PARTNER</small><strong>Shopify Partner</strong></div>
        </div>
  
        <div aria-label="PPAI Member" class="hero-trust-card">
          <div class="hero-trust-card__logo"><div aria-hidden="true" class="trust-brand trust-brand--ppai"><b>PPAI<sup>®</sup></b><small>MEMBER</small></div></div>
          <div class="hero-trust-card__copy"><small>INDUSTRY MEMBERSHIP</small><strong>PPAI Member</strong></div>
        </div>
  
        <div aria-label="Trustpilot customer reviews" class="hero-trust-card">
          <div class="hero-trust-card__logo">
            <div><div class="hero-trustpilot-wordmark"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 1.8l3.15 6.37 7.03 1.02-5.09 4.96 1.2 7.01L12 17.86 5.71 21.16l1.2-7.01L1.82 9.19l7.03-1.02L12 1.8z" fill="#00B67A"></path></svg><strong>Trustpilot</strong></div><div aria-hidden="true" class="hero-trustpilot-stars"><span>★</span><span>★</span><span>★</span><span>★</span><span class="partial">★</span></div></div>
          </div>
          <div class="hero-trust-card__copy"><small>CUSTOMER REVIEWS</small><strong>Trusted client feedback</strong></div>
        </div>
  
        <div aria-label="Project delivery" class="hero-trust-card">
          <div class="hero-trust-card__logo"><div aria-hidden="true" class="trust-delivery-mark"><span>✓</span></div></div>
          <div class="hero-trust-card__copy"><small>DELIVERY RECORD</small><strong>100% Project Delivery</strong></div>
        </div>
      </div>
    </div>
  </section>
  
  <div class="page-nav-wrap" id="pageNavWrap">
    <div class="page-shell">
      <nav aria-label="On this page" class="page-nav-shell" id="pageNavShell">
        <button aria-controls="pageNavLinks" aria-expanded="false" class="page-nav-toggle" id="pageNavToggle" type="button">
          <span><small>On this page</small><strong id="pageNavCurrent">The Problem</strong></span><span aria-hidden="true" class="page-nav-toggle__icon"></span>
        </button>
        <div class="page-nav" id="pageNavLinks">
          <a href="#problem">The Problem</a>
          <a href="#what-we-build">What We Build</a>
          <a href="#blueprint">Blueprint</a>
          <a href="#process">Process</a>
          <a href="#roadmap">Roadmap</a>
          <a href="#visibility">Visibility</a>
          <a href="#delivery">Turnkey Delivery</a>
          <a href="#proof">Proof</a>
          <a href="#faq">FAQs</a>
          <a class="page-nav__cta" href="#discuss-idea">Discuss Your Idea</a>
        </div>
      </nav>
    </div>
  </div>
  
  <section class="section problem" id="problem" data-nav-label="The Problem">
    <div class="page-shell problem-simple" data-reveal>
      <p class="eyebrow">Start with what is not working</p>
      <h2 class="section-title">Is your team adapting to the software instead of the software adapting to the business?</h2>
      <p class="section-copy">When workarounds become the workflow, adding another app rarely fixes the real problem. Sometimes the better move is to design the missing system around how the business actually needs to operate.</p>
  
      <div class="problem-signals">
        <div class="problem-signal"><span>01 · Manual work</span><strong>The same information keeps getting copied, checked and re-entered.</strong></div>
        <div class="problem-signal"><span>02 · Disconnected systems</span><strong>Your ecommerce, ERP, CRM, suppliers or internal tools still depend on people to bridge the gaps.</strong></div>
        <div class="problem-signal"><span>03 · Software mismatch</span><strong>Off-the-shelf tools are forcing the business into a workflow that no longer fits.</strong></div>
      </div>
  
      <p class="problem-question">What if the system was built around <em>your operation</em> instead?</p>
    </div>
  </section>
  
  <section class="section solutions-section" id="what-we-build" data-nav-label="What We Build">
    <div class="page-shell">
      <p class="eyebrow">What we can build</p>
      <h2 class="section-title">Not “anything.” Business technology with a clear job to do.</h2>
      <p class="section-copy">We stay focused on ecommerce technology, integrations, business automation, SaaS, internal platforms and practical AI.</p>
  
      <div class="solution-grid">
        <article class="solution-card" data-reveal><div class="solution-icon">01</div><h3>Ecommerce Technology</h3><p>Customer portals, B2B workflows, marketplaces, multi-store systems and custom commerce experiences.</p></article>
        <article class="solution-card" data-reveal><div class="solution-icon">02</div><h3>Business Automation</h3><p>Replace repeated data entry, manual approvals, spreadsheet handoffs and status chasing with connected workflows.</p></article>
        <article class="solution-card" data-reveal><div class="solution-icon">03</div><h3>System Integrations</h3><p>Connect ecommerce, ERP, CRM, accounting, suppliers, fulfillment, payments and internal systems through APIs or middleware.</p></article>
        <article class="solution-card" data-reveal><div class="solution-icon">04</div><h3>SaaS Platforms</h3><p>Turn a repeatable business process or commercial idea into software with user roles, workflows, administration and a roadmap for scale.</p></article>
        <article class="solution-card" data-reveal><div class="solution-icon">05</div><h3>AI-Enabled Workflows</h3><p>Use AI where it earns its place: document processing, assistance, data extraction, classification, search or decision support.</p></article>
        <article class="solution-card" data-reveal><div class="solution-icon">06</div><h3>Internal Platforms & Middleware</h3><p>Build the missing software layer between teams and tools when existing products cannot support the operational workflow.</p></article>
      </div>
    </div>
  </section>
  
  <section class="section" id="blueprint" data-nav-label="Blueprint">
    <div class="page-shell blueprint-layout">
      <div data-reveal>
        <p class="eyebrow">Discovery before development</p>
        <h2 class="section-title">You don’t need a technical specification. You do need a clear problem.</h2>
        <p class="section-copy">Before expensive development starts, we turn the business goal into a structured requirement document, phases, assumptions, dependencies and acceptance criteria.</p>
        <a class="text-link" href="/book-demo/">Start with the idea <span class="arrow">→</span></a>
      </div>
  
      <div class="blueprint" data-reveal>
        <div class="blueprint-top"><strong>Solution Blueprint</strong><span class="blueprint-badge">Before build approval</span></div>
        <div class="blueprint-row"><span class="bp-num">01</span><span class="bp-title">Business goals & current workflow</span><span class="bp-state">Defined</span></div>
        <div class="blueprint-row"><span class="bp-num">02</span><span class="bp-title">Users, roles & requirements</span><span class="bp-state">Defined</span></div>
        <div class="blueprint-row"><span class="bp-num">03</span><span class="bp-title">Integrations & data flow</span><span class="bp-state">Mapped</span></div>
        <div class="blueprint-row"><span class="bp-num">04</span><span class="bp-title">MVP / development phases</span><span class="bp-state">Planned</span></div>
        <div class="blueprint-row"><span class="bp-num">05</span><span class="bp-title">Timeline, risks & investment</span><span class="bp-state">Reviewed</span></div>
      </div>
    </div>
  </section>
  
  <section class="section" id="process" data-nav-label="Process">
    <div class="page-shell">
      <div class="process-wrap" data-reveal>
        <p class="eyebrow">From idea to working system</p>
        <h2 class="section-title">One process. No coding before the problem makes sense.</h2>
        <p class="section-copy">You stay involved in business decisions. Swishtag handles the technical planning, product work, project management, QA and delivery.</p>
  
        <div class="process-flow">
          <article class="process-step"><span>01</span><div><h3>Understand</h3><p>Goals, users, workflow and the problem worth solving.</p></div></article>
          <article class="process-step"><span>02</span><div><h3>Define</h3><p>Requirements, acceptance criteria and dependencies.</p></div></article>
          <article class="process-step"><span>03</span><div><h3>Plan</h3><p>Architecture, phases, timeline, milestones and cost.</p></div></article>
          <article class="process-step"><span>04</span><div><h3>Build</h3><p>UX, engineering, integrations and automation.</p></div></article>
          <article class="process-step"><span>05</span><div><h3>Test</h3><p>Functional QA, integration testing and UAT.</p></div></article>
          <article class="process-step"><span>06</span><div><h3>Launch</h3><p>Production deployment and stabilization.</p></div></article>
          <article class="process-step"><span>07</span><div><h3>Hand over</h3><p>Documentation, access, training and ownership package.</p></div></article>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section" id="roadmap" data-nav-label="Roadmap">
    <div class="page-shell">
      <p class="eyebrow">Build what matters first</p>
      <h2 class="section-title">Would building less first make the idea safer?</h2>
      <p class="section-copy">A useful first phase is usually stronger than an oversized “MVP” carrying every feature imaginable. We split the roadmap around value, risk and what needs to be proven.</p>
  
      <div class="phase-grid">
        <article class="phase" data-reveal><span class="phase-no">Phase 01</span><div><h3>Core system</h3><p>Build the smallest complete version that solves the primary business problem.</p></div></article>
        <article class="phase" data-reveal><span class="phase-no">Phase 02</span><div><h3>Automation</h3><p>Remove repetitive work after the core workflow is stable and understood.</p></div></article>
        <article class="phase" data-reveal><span class="phase-no">Phase 03</span><div><h3>Integrations</h3><p>Connect the platforms, partners and data sources the system genuinely needs.</p></div></article>
        <article class="phase" data-reveal><span class="phase-no">Phase 04</span><div><h3>Scale & intelligence</h3><p>Add advanced workflows, reporting or AI when the extra value is clear.</p></div></article>
      </div>
    </div>
  </section>
  
  <section class="section visibility-section" id="visibility" data-nav-label="Visibility">
    <div class="page-shell visibility-layout">
      <div class="status-board" data-reveal aria-label="Example Swishtag project visibility dashboard">
        <div class="status-main">
          <div class="status-top"><strong>Project health</strong><span class="status-badge">On track</span></div>
          <div class="progress" aria-label="68 percent progress"></div>
          <div class="mini-grid">
            <div class="mini"><strong>Completed</strong><small>Requirements + UX flow</small></div>
            <div class="mini"><strong>In progress</strong><small>Core workflow build</small></div>
            <div class="mini"><strong>Next</strong><small>ERP integration</small></div>
          </div>
        </div>
        <div class="status-side">
          <div><strong>Decision needed</strong><p>Confirm approval path for exceptions.</p></div>
          <div><strong>Risk</strong><p>Third-party API limits under review.</p></div>
          <div><strong>Next review</strong><p>Milestone review with staging build.</p></div>
        </div>
      </div>
  
      <div data-reveal>
        <p class="eyebrow">Project visibility</p>
        <h2 class="section-title">You shouldn’t be wondering what your development team is doing.</h2>
        <p class="section-copy">We agree the reporting rhythm before development starts. Projects can include weekly progress updates plus milestone reviews covering completed work, current work, next decisions, blockers and timeline health.</p>
      </div>
    </div>
  </section>
  
  <section class="section" id="delivery" data-nav-label="Turnkey Delivery">
    <div class="page-shell">
      <div class="delivery-card" data-reveal>
        <div class="delivery-card__content">
          <p class="eyebrow">Turnkey delivery</p>
          <h2 class="section-title">One team. From business idea to production.</h2>
          <p class="section-copy">Instead of coordinating strategy, UX, development, integrations, QA and launch across separate vendors, you work with one accountable Swishtag team from discovery through handover.</p>
          <div class="delivery-benefits" aria-label="Turnkey delivery benefits">
            <span>One project owner</span><span>Milestone visibility</span><span>Documentation included</span><span>Training + handover</span>
          </div>
        </div>
  
        <div class="delivery-visual" aria-hidden="true">
          <div class="delivery-orbit delivery-orbit--one"></div>
          <div class="delivery-orbit delivery-orbit--two"></div>
          <div class="delivery-core"><small>Swishtag</small><strong>One accountable team</strong></div>
          <span class="delivery-chip delivery-chip--one">Discovery</span>
          <span class="delivery-chip delivery-chip--two">UX / UI</span>
          <span class="delivery-chip delivery-chip--three">Engineering</span>
          <span class="delivery-chip delivery-chip--four">Integrations</span>
          <span class="delivery-chip delivery-chip--five">QA</span>
          <span class="delivery-chip delivery-chip--six">Launch</span>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section" id="handover">
    <div class="page-shell handover-layout">
      <div data-reveal>
        <p class="eyebrow">Handover</p>
        <h2 class="section-title">We hand over a working system, not a pile of code.</h2>
        <p class="section-copy">The exact package depends on the project, but your team should understand what was built, how to operate it and what happens after launch.</p>
      </div>
  
      <div class="checklist" data-reveal>
        <div class="check">Production-ready system</div>
        <div class="check">Agreed source-code access</div>
        <div class="check">Admin & environment access</div>
        <div class="check">Technical documentation</div>
        <div class="check">User / admin manuals</div>
        <div class="check">Deployment notes</div>
        <div class="check">Training material</div>
        <div class="check">Team handover session</div>
      </div>
    </div>
  </section>
  
  <section class="section proof-section" id="proof" data-nav-label="Proof">
    <div class="page-shell">
      <p class="eyebrow">Proof we build systems</p>
      <h2 class="section-title">Custom engineering is already part of how Swishtag works.</h2>
      <p class="section-copy">Our existing work includes middleware, multi-store control, workflow automation, PunchOut and operational software for complex commerce environments.</p>
  
      <div class="case-grid">
        <article class="case primary" data-reveal><span class="case-kicker">Club Colors</span><span class="metric-big">150</span><h3>Shopify stores managed through a centralized approach.</h3><p>Custom middleware, workflow automation and PunchOut capability simplified control across a large company-store environment.</p></article>
        <article class="case" data-reveal><span class="case-kicker">Promo Plus</span><h3>Operational workflow turned into software.</h3><p>Artwork approvals, production workflows and industry data connections brought into one platform.</p></article>
        <article class="case" data-reveal><span class="case-kicker">PunchOut Solutions</span><h3>Complex B2B connectivity made manageable.</h3><p>A focused software layer designed around procurement connections and connected commerce.</p></article>
      </div>
    </div>
  </section>
  
  <SharedFaq {...faqs.customSoftware} navLabel="FAQs" />
  
  <section class="section contact-section" id="discuss-idea">
    <div class="page-shell form-layout">
      <div data-reveal>
        <p class="eyebrow">Discuss your idea</p>
        <h2 class="section-title">Still living in your head?</h2>
        <p class="section-copy">Tell us what is happening in the business today and what you wish happened instead. We can start there.</p>
        <p class="section-copy" style="font-size:1rem">If the project looks like a fit, the next step is to understand the workflow, define requirements and map the development path before coding begins.</p>
      </div>
  
      <form class="form-card" id="ideaForm" action={formEndpoint} method="post" data-form-token={formToken} data-reveal novalidate>
        <input type="hidden" name="form_source" value="custom-software">
        <div class="field sr-only" aria-hidden="true">
          <label for="idea-gotcha">Leave this empty</label>
          <input id="idea-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
        </div>
        <div class="fields">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="email">Work email</label>
            <input id="email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="project-type">What are you trying to build?</label>
            <select id="project-type" name="project_type" required>
              <option value="">Choose one</option>
              <option>Ecommerce technology</option>
              <option>Business automation</option>
              <option>System integration</option>
              <option>SaaS platform</option>
              <option>AI-enabled workflow</option>
              <option>Internal business platform</option>
              <option>Not sure yet</option>
            </select>
          </div>
          <div class="field">
            <label for="stage">Where are you today?</label>
            <select id="stage" name="stage" required>
              <option value="">Choose one</option>
              <option>Idea only</option>
              <option>Existing manual workflow</option>
              <option>Requirements already prepared</option>
              <option>Prototype or MVP exists</option>
              <option>Existing platform needs improvement</option>
            </select>
          </div>
          <div class="field full">
            <label for="project-problem">What problem are you trying to solve?</label>
            <textarea id="project-problem" name="problem" placeholder="What happens today, and what would you like to happen instead?" required></textarea>
          </div>
          <div class="field">
            <label for="integrations">Does it connect with other systems?</label>
            <select id="integrations" name="integrations">
              <option>Not sure yet</option><option>Yes</option><option>No</option>
            </select>
          </div>
          <div class="field">
            <label for="budget">Estimated investment</label>
            <select id="budget" name="budget">
              <option>Need help estimating</option>
              <option>Under $10k</option>
              <option>$10k–$25k</option>
              <option>$25k–$50k</option>
              <option>$50k–$100k</option>
              <option>$100k+</option>
            </select>
          </div>
          <div class="field full">
            <button class="btn btn--primary" id="ideaSubmitButton" type="submit">Send my idea <span aria-hidden="true">&#8599;</span></button>
            <div class="form-feedback" id="ideaFormFeedback" role="status" aria-live="polite"></div>
            <p class="form-note">No technical specification required. For larger or unclear projects, a dedicated Solution Blueprint may be recommended before development pricing is finalized.</p>
          </div>
        </div>
      </form>
    </div>
  </section>
  </main>
  <script slot="scripts" is:inline>
  (() => {
  /* Interactive rocket builder */
    const rocketBuilder = document.getElementById("rocketBuilder");
    const rocketStage = document.getElementById("rocketBuilderStage");
    const rocketParts = rocketBuilder ? [...rocketBuilder.querySelectorAll(".rocket-part")] : [];
    const ignitionButton = document.getElementById("ignitionButton");
    const rocketResetButton = document.getElementById("rocketResetButton");
    const rocketProgressCount = document.getElementById("rocketProgressCount");
    const rocketBuilderMessage = document.getElementById("rocketBuilderMessage");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  
    if (rocketBuilder && rocketStage && rocketParts.length) {
      const totalParts = rocketParts.length;
      const placedParts = new Set();
      let dragState = null;
      let launchTimers = [];
  
      const clearLaunchTimers = () => {
        launchTimers.forEach(timer => window.clearTimeout(timer));
        launchTimers = [];
      };
  
      const setBuilderMessage = html => {
        const messageSpan = rocketBuilderMessage?.querySelector("span");
        if (messageSpan) messageSpan.innerHTML = html;
      };
  
      const updateRocketProgress = () => {
        const count = placedParts.size;
        if (rocketProgressCount) rocketProgressCount.textContent = `${count} / ${totalParts}`;
        if (rocketResetButton) rocketResetButton.disabled = count === 0 && !rocketBuilder.classList.contains("is-launched");
  
        if (count === totalParts && !rocketBuilder.classList.contains("is-launched")) {
          rocketBuilder.classList.add("is-complete");
          if (ignitionButton) {
            ignitionButton.disabled = false;
            ignitionButton.textContent = "Begin ignition";
          }
          setBuilderMessage(
            '<strong>Your idea has taken shape.</strong> Now give it the strategy, engineering and execution it needs to <span class="soar-high">Soar High.</span>'
          );
        }
      };
  
      const resetRocket = () => {
        clearLaunchTimers();
        placedParts.clear();
        dragState = null;
        rocketBuilder.classList.remove("is-complete","is-igniting","is-launching","is-launched");
        rocketParts.forEach(part => {
          part.classList.remove("is-placed","is-dragging","is-wrong");
          part.style.removeProperty("left");
          part.style.removeProperty("top");
          part.style.removeProperty("transform");
          delete part.dataset.dragged;
        });
        rocketBuilder.querySelectorAll("[data-built-part]").forEach(group => group.classList.remove("is-built"));
        rocketBuilder.querySelectorAll(".rocket-target").forEach(target => target.classList.remove("is-filled","is-hot"));
        if (ignitionButton) {
          ignitionButton.disabled = true;
          ignitionButton.textContent = "Begin ignition";
        }
        if (rocketResetButton) rocketResetButton.disabled = true;
        setBuilderMessage(
          "<strong>Every strong system starts as separate pieces.</strong> Drag or tap each component to bring the idea together."
        );
        updateRocketProgress();
      };
  
      const getTargetPoint = part => {
        const target = rocketBuilder.querySelector(`.rocket-target[data-slot="${part.dataset.part}"]`);
        if (!target) return null;
        const stageRect = rocketStage.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        return {
          x: targetRect.left + targetRect.width / 2 - stageRect.left,
          y: targetRect.top + targetRect.height / 2 - stageRect.top,
          target
        };
      };
  
      const placePart = part => {
        if (!part || placedParts.has(part.dataset.part) || rocketBuilder.classList.contains("is-launching") || rocketBuilder.classList.contains("is-launched")) return;
        placedParts.add(part.dataset.part);
        part.classList.remove("is-dragging","is-wrong");
        part.style.removeProperty("transform");
        part.style.removeProperty("left");
        part.style.removeProperty("top");
        part.classList.add("is-placed");
        const target = rocketBuilder.querySelector(`.rocket-target[data-slot="${part.dataset.part}"]`);
        target?.classList.remove("is-hot");
        target?.classList.add("is-filled");
        const builtGroup = rocketBuilder.querySelector(`[data-built-part="${part.dataset.part}"]`);
        builtGroup?.classList.add("is-built");
        updateRocketProgress();
      };
  
      const returnPart = part => {
        if (!part) return;
        part.classList.remove("is-dragging");
        part.style.removeProperty("left");
        part.style.removeProperty("top");
        part.style.removeProperty("transform");
        part.classList.remove("is-wrong");
        void part.offsetWidth;
        part.classList.add("is-wrong");
        window.setTimeout(() => part.classList.remove("is-wrong"),360);
        rocketBuilder.querySelectorAll(".rocket-target").forEach(target => target.classList.remove("is-hot"));
      };
  
      rocketParts.forEach(part => {
        part.addEventListener("click", () => {
          if (part.dataset.dragged === "1") {
            part.dataset.dragged = "0";
            return;
          }
          if (placedParts.has(part.dataset.part)) return;
          placePart(part);
        });
  
        part.addEventListener("keydown", event => {
          if ((event.key === "Enter" || event.key === " ") && !placedParts.has(part.dataset.part)) {
            event.preventDefault();
            placePart(part);
          }
        });
  
        part.addEventListener("pointerdown", event => {
          if (placedParts.has(part.dataset.part) || rocketBuilder.classList.contains("is-complete")) return;
          if (event.pointerType === "touch" && window.innerWidth < 760) return;
  
          const stageRect = rocketStage.getBoundingClientRect();
          const partRect = part.getBoundingClientRect();
          dragState = {
            part,
            pointerId:event.pointerId,
            offsetX:event.clientX - partRect.left - partRect.width / 2,
            offsetY:event.clientY - partRect.top - partRect.height / 2,
            stageRect,
            startX:event.clientX,
            startY:event.clientY,
            moved:false
          };
          part.setPointerCapture?.(event.pointerId);
          part.classList.add("is-dragging");
          event.preventDefault();
        });
  
        part.addEventListener("pointermove", event => {
          if (!dragState || dragState.part !== part || dragState.pointerId !== event.pointerId) return;
          const dx = event.clientX - dragState.startX;
          const dy = event.clientY - dragState.startY;
          if (Math.hypot(dx,dy) > 5) dragState.moved = true;
  
          const x = event.clientX - dragState.stageRect.left - dragState.offsetX;
          const y = event.clientY - dragState.stageRect.top - dragState.offsetY;
          part.style.left = `${x}px`;
          part.style.top = `${y}px`;
          part.style.transform = "translate(-50%,-50%) scale(1.04)";
  
          const targetPoint = getTargetPoint(part);
          if (!targetPoint) return;
          const distance = Math.hypot(x - targetPoint.x,y - targetPoint.y);
          targetPoint.target.classList.toggle("is-hot",distance < 68);
        });
  
        const finishDrag = event => {
          if (!dragState || dragState.part !== part || dragState.pointerId !== event.pointerId) return;
          const targetPoint = getTargetPoint(part);
          const stageRect = dragState.stageRect;
          const x = event.clientX - stageRect.left - dragState.offsetX;
          const y = event.clientY - stageRect.top - dragState.offsetY;
          const distance = targetPoint ? Math.hypot(x - targetPoint.x,y - targetPoint.y) : Infinity;
          const shouldPlace = dragState.moved && distance < 76;
          const wasMoved = dragState.moved;
          dragState = null;
          part.releasePointerCapture?.(event.pointerId);
  
          if (wasMoved) part.dataset.dragged = "1";
          if (shouldPlace) placePart(part);
          else if (wasMoved) returnPart(part);
          else part.classList.remove("is-dragging");
        };
  
        part.addEventListener("pointerup",finishDrag);
        part.addEventListener("pointercancel",finishDrag);
      });
  
      rocketResetButton?.addEventListener("click",resetRocket);
  
      ignitionButton?.addEventListener("click",() => {
        if (placedParts.size !== totalParts || rocketBuilder.classList.contains("is-igniting") || rocketBuilder.classList.contains("is-launching") || rocketBuilder.classList.contains("is-launched")) return;
  
        ignitionButton.disabled = true;
        ignitionButton.textContent = "Igniting…";
        rocketBuilder.classList.add("is-igniting");
        setBuilderMessage(
          '<strong>Ignition is live.</strong> A strong idea needs more than code. It needs the right system behind it.'
        );
  
        const ignitionDelay = reducedMotion.matches ? 120 : 700;
        const cruiseDelay = reducedMotion.matches ? 260 : 1650;
  
        launchTimers.push(window.setTimeout(() => {
          rocketBuilder.classList.remove("is-igniting");
          rocketBuilder.classList.add("is-launching");
          ignitionButton.textContent = "Building thrust…";
          setBuilderMessage(
            '<strong>Momentum starts here.</strong> The pieces are connected, the engine is running, and the idea is ready to move.'
          );
        },ignitionDelay));
  
        launchTimers.push(window.setTimeout(() => {
          rocketBuilder.classList.remove("is-launching");
          rocketBuilder.classList.add("is-launched");
          ignitionButton.disabled = true;
          ignitionButton.textContent = "Soaring High";
          if (rocketResetButton) rocketResetButton.disabled = false;
          setBuilderMessage(
            '<strong>Now it has momentum.</strong> We help shape your idea, engineer the right system, and build what your business needs to <span class="soar-high">Soar High.</span>'
          );
        },cruiseDelay));
      });
    }

    const ideaForm = document.getElementById("ideaForm");
    const ideaFeedback = document.getElementById("ideaFormFeedback");
    const ideaSubmitButton = document.getElementById("ideaSubmitButton");
    const ideaFormToken = ideaForm?.dataset.formToken || "";
    const ideaFormLoadedAt = Date.now().toString();

    const showIdeaFeedback = (message, type) => {
      if (!ideaFeedback) return;
      ideaFeedback.textContent = message;
      ideaFeedback.classList.remove("is-error", "is-success");
      ideaFeedback.classList.add("is-visible", type === "success" ? "is-success" : "is-error");
    };

    const setIdeaSubmitting = isSubmitting => {
      if (!ideaSubmitButton) return;
      ideaSubmitButton.disabled = isSubmitting;
      ideaSubmitButton.innerHTML = isSubmitting
        ? 'Sending...'
        : 'Send my idea <span aria-hidden="true">&#8599;</span>';
    };

    const validateIdeaForm = () => {
      if (!ideaForm) return false;
      const requiredFields = [
        ["name", "Please enter your name."],
        ["email", "Please enter a valid work email."],
        ["project-type", "Please choose what you are trying to build."],
        ["stage", "Please choose where you are today."],
        ["project-problem", "Please describe the problem you want to solve."]
      ];

      for (const [id, message] of requiredFields) {
        const field = document.getElementById(id);
        if (!field || !field.value.trim()) {
          field?.focus();
          showIdeaFeedback(message, "error");
          return false;
        }
      }

      const email = document.getElementById("email");
      if (email && !email.checkValidity()) {
        email.focus();
        showIdeaFeedback("Please enter a valid work email.", "error");
        return false;
      }

      return true;
    };

    ideaForm?.addEventListener("submit", async event => {
      event.preventDefault();
      if (!validateIdeaForm()) return;
      if (document.getElementById("idea-gotcha")?.value.trim()) return;

      const payload = Object.fromEntries(new FormData(ideaForm).entries());
      payload.form_source = "custom-software";
      payload.page = window.location.href;
      payload.form_loaded_at = ideaFormLoadedAt;

      try {
        setIdeaSubmitting(true);
        const headers = {
          "Accept": "application/json",
          "Content-Type": "application/json"
        };
        if (ideaFormToken) headers["X-Astro-Form-Token"] = ideaFormToken;

        const response = await fetch(ideaForm.action, {
          method: "POST",
          headers,
          body: JSON.stringify(payload)
        });
        const contentType = response.headers.get("content-type") || "";
        if (!contentType.includes("application/json")) {
          const responseText = await response.text().catch(() => "");
          console.error("[Swishtag form] Non-JSON response from form service", {
            status: response.status,
            statusText: response.statusText,
            contentType,
            endpoint: ideaForm.action,
            responsePreview: responseText.slice(0, 500)
          });
          throw new Error("The form service returned an unexpected response. Please try again or email hello@swishtag.com directly.");
        }
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) {
          console.error("[Swishtag form] JSON error response from form service", {
            status: response.status,
            endpoint: ideaForm.action,
            result
          });
          throw new Error(result.message || "We could not send your idea right now.");
        }

        ideaForm.reset();
        showIdeaFeedback("Thanks. Your idea has been sent to Swishtag. We will review it and follow up by email.", "success");
      } catch (error) {
        showIdeaFeedback(error.message || "We could not send your idea right now. Please try again.", "error");
      } finally {
        setIdeaSubmitting(false);
      }
    });
  })();
  </script>
</BaseLayout>
