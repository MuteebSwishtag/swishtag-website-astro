---
import BaseLayout from '../../layouts/BaseLayout.astro';
import bookDemoCssUrl from "../../styles/pages/book-demo.css?rawcss";


const title = "Book a Demo | Swishtag";
const description = "Book a Swishtag demo for company stores or enterprise company-store automation.";
const canonical = "https://swishtag.com/book-demo/";
const robots = "index,follow";
const formSubmissionMode = (import.meta.env.PUBLIC_FORM_SUBMISSION_MODE ?? "direct").toLowerCase();
const directFormEndpoint = import.meta.env.PUBLIC_DIRECT_FORM_ENDPOINT ?? "/api/forms/submit";
const wordpressFormEndpoint = import.meta.env.PUBLIC_WORDPRESS_FORM_ENDPOINT ?? "https://cms.swishtag.com/wp-json/astro-form/v1/submit";
const formEndpoint = formSubmissionMode === "wordpress" ? wordpressFormEndpoint : directFormEndpoint;
const formToken = formSubmissionMode === "wordpress" ? (import.meta.env.PUBLIC_ASTRO_FORM_TOKEN ?? "") : "";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <link slot="head" rel="stylesheet" href={bookDemoCssUrl} />
  <main class="book-demo-page shell">
      <section class="hero">
        <span class="eyebrow"><i></i> Book a Demo</span>
        <h1>Book a Shopify demo for your workflow.</h1>
        <p>Tell us what you need, then pick a time. We'll tailor the demo for promotional products distributors.</p>
        <div class="hero-note">
          <span>15-minute demo</span>
          <span>Built for promo distributors</span>
          <span>No long form. Just 3 quick steps.</span>
        </div>
      </section>
  
      <section class="form-shell">
        <div class="card" id="demoCard" style="box-shadow: unset;" >
          <div class="card-inner">
            <div id="bookingFlow">
              <div class="stepper" aria-label="Booking steps">
                <div class="step active" data-step-indicator="1"><div class="step-badge">1</div><strong>Your details</strong></div>
                <div class="step" data-step-indicator="2"><div class="step-badge">2</div><strong>Your needs</strong></div>
                <div class="step" data-step-indicator="3"><div class="step-badge">3</div><strong>Pick a time</strong></div>
              </div>
  
              <form id="demoForm" action={formEndpoint} method="post" data-form-token={formToken} novalidate>
                <input type="hidden" name="form_source" value="book-demo">
                <div class="panel active" data-step="1">
                  <div class="panel-head">
                    <h2>Tell us about you</h2>
                    <p>So we know who we're meeting and where to send your confirmation.</p>
                  </div>
                  <div class="grid-2">
                    <div class="field">
                      <label for="firstName">First name</label>
                      <input id="firstName" name="firstName" type="text" autocomplete="given-name" placeholder="Enter your first name" required>
                    </div>
                    <div class="field">
                      <label for="lastName">Last name</label>
                      <input id="lastName" name="lastName" type="text" autocomplete="family-name" placeholder="Enter your last name" required>
                    </div>
                    <div class="field">
                      <label for="workEmail">Work email</label>
                      <input id="workEmail" name="workEmail"  placeholder="Enter your email address"  type="email" autocomplete="email" required>
                    </div>
                    <div class="field">
                      <label for="companyName">Company</label>
                      <input id="companyName" name="companyName" type="text" autocomplete="organization" required placeholder="Enter your company" >
                    </div>
                    <div class="field">
                      <label for="website">Website <span class="optional">(optional)</span></label>
                      <input id="website" name="website" type="text" inputmode="url" autocomplete="url" placeholder="example.com">
                    </div>
                    <div class="field">
                      <label for="country">Country</label>
                      <div class="combo">
                        <input id="country" name="country" type="text" role="combobox" aria-expanded="false" aria-controls="countryList" aria-autocomplete="list" aria-required="true" autocomplete="country-name" placeholder="Loading countries..." disabled required>
                        <ul id="countryList" class="combo-list" role="listbox" hidden></ul>
                      </div>
                    </div>
                    <div class="field">
                      <label for="city">City</label>
                      <div class="combo">
                        <input id="city" name="city" type="text" role="combobox" aria-expanded="false" aria-controls="cityList" aria-autocomplete="list" aria-required="true" aria-disabled="true" autocomplete="address-level2" placeholder="Choose a country first" disabled required>
                        <ul id="cityList" class="combo-list" role="listbox" hidden></ul>
                      </div>
                    </div>
                    <div class="field sr-only" aria-hidden="true">
                      <label for="nickname">Leave this empty</label>
                      <input id="nickname" name="nickname" type="text" tabindex="-1" autocomplete="off">
                    </div>
                  </div>
                  <div class="error" data-error></div>
                  <div class="actions">
                    <p class="fine-print">We'll only use this information to schedule your demo and follow up about the workflow you want to discuss.</p>
                    <button class="btn btn-primary" type="button" data-next>Continue <b>&rarr;</b></button>
                  </div>
                </div>
  
                <div class="panel" data-step="2">
                  <div class="panel-head">
                    <h2>What would you like to improve?</h2>
                    <p>Pick the option that best matches what you want to see in the demo.</p>
                  </div>
                  <div class="choices" role="radiogroup" aria-label="What would you like help with?">
                    <div class="choice"><input type="radio" id="need-launch" name="solutionInterest" value="Company Store" data-service="company-store-launch" data-intent="launch"><label for="need-launch"><strong>Company Store</strong><span>Launch a Shopify company store for a client program.</span></label></div>
                    <div class="choice"><input type="radio" id="need-scale" name="solutionInterest" value="Enterprise Company Store Automation" data-service="enterprise-company-store-automation" data-intent="automation"><label for="need-scale"><strong>Enterprise Company Store Automation</strong><span>Centralize multi-store operations, approvals, orders, and automation.</span></label></div>
                    <div class="choice"><input type="radio" id="need-unsure" name="solutionInterest" value="Not sure yet" data-service="not-sure-yet"><label for="need-unsure"><strong>Not sure yet</strong><span>Help me figure out the right path for my operation.</span></label></div>
                  </div>
                  <div class="field" style="margin-top:16px">
                    <label>How many company stores are you managing? <span class="optional">optional</span></label>
                    <div class="mini-choices">
                      <div class="chip"><input type="radio" id="stores-none" name="storeCount" value="None yet"><label for="stores-none">None yet</label></div>
                      <div class="chip"><input type="radio" id="stores-1-5" name="storeCount" value="1-5"><label for="stores-1-5">1-5</label></div>
                      <div class="chip"><input type="radio" id="stores-6-25" name="storeCount" value="6-25"><label for="stores-6-25">6-25</label></div>
                      <div class="chip"><input type="radio" id="stores-25-plus" name="storeCount" value="25+"><label for="stores-25-plus">25+</label></div>
                    </div>
                  </div>
                  <div class="field">
                    <label for="notes">Anything we should know before the demo? <span class="optional">optional</span></label>
                    <textarea id="notes" name="notes" placeholder="Current workflow, systems, client programs, or anything you want us to be ready for."></textarea>
                  </div>
                  <div class="error" data-error></div>
                  <div class="actions">
                    <button class="btn btn-ghost"  style="border-color: #4b5563; border-width: 2px;" type="button" data-back>Back</button>
                    <button class="btn btn-primary" type="button" data-next>Choose a meeting time <b>&rarr;</b></button>
                  </div>
                </div>
  
                <div class="panel" data-step="3">
                  <div class="panel-head">
                    <h2>Pick a time that works for you</h2>
                    <p>Choose a 15-minute slot. Hours are 10:00 AM to 6:00 PM New York time, shown in your timezone.</p>
                  </div>
                  <div class="picker-grid">
                    <div class="picker-box">
                      <h3>Choose a date</h3>
                      <p>Dates follow New York business days. A slot can fall on a different local date.</p>
                      <div class="date-list" id="dateList"></div>
                    </div>
                    <div class="picker-box">
                      <h3>Choose a time</h3>
                      <p id="timeIntro">Select a date to see available slots.</p>
                      <p class="slot-legend">Booked times stay visible and can't be selected.</p>
                      <div class="selected-date" id="selectedDatePill" hidden><i></i><span></span></div>
                      <div class="time-list" id="timeList"></div>
                      <div class="timezone" id="timezoneBox"><strong>Times shown in:</strong> <span id="timezoneText"></span></div>
                      <div class="summary-strip" id="bookingSummary"></div>
                    </div>
                  </div>
                  <div class="error" data-error></div>
                  <div class="actions">
                    <button class="btn btn-ghost" type="button" data-back>Back</button>
                    <button class="btn btn-primary" id="submitBtn" type="submit">Book my demo <b>&#8599;</b></button>
                  </div>
                </div>
              </form>
            </div>
  
            <section class="success" id="successState" aria-live="polite">
              <div class="success-wrap">
                <div class="success-copy">
                  <span class="success-kicker"><i></i> Mission confirmed</span>
                  <h2>You're cleared for launch.</h2>
                  <p>Your demo request is in. We'll follow up at <strong id="successEmail"></strong> and come prepared for your company-store workflow.</p>
                  <div class="success-card">
                    <div class="success-grid">
                      <div class="success-item"><small>Date</small><strong id="successDate">-</strong></div>
                      <div class="success-item"><small>Time</small><strong id="successTime">-</strong></div>
                      <div class="success-item"><small>Company</small><strong id="successCompany">-</strong></div>
                      <div class="success-item"><small>Focus</small><strong id="successFocus">-</strong></div>
                    </div>
                    <div class="success-note">Bring the messy workflow. We'll bring the ideas. You can keep exploring solutions or book another session if someone else from your team should join.</div>
                  </div>
                  <div class="success-actions">
                    <a class="btn btn-primary" href="../solutions/">Back to Solutions <b>&#8599;</b></a>
                    <button class="btn btn-light" type="button" id="bookAnotherBtn">Book another demo</button>
                  </div>
                </div>
                <div class="success-visual">
                  <div class="spark" aria-hidden="true"></div>
                  <div class="rocket-pack" aria-hidden="true"><span class="core"></span><span class="booster left"></span><span class="booster right"></span><span class="nozzle left"></span><span class="nozzle right"></span></div><div class="rocket-trail" aria-hidden="true"></div>
                  <img class="astronaut" src="/assets/inline/book-demo-astronaut-ddb5d215f2.webp" loading="lazy" decoding="async" alt="Swishtag astronaut mascot floating with a rocket pack in a mission confirmed pose">
                </div>
              </div>
            </section>
          </div>
        </div>
      </section>
    </main>
  <script>
    import { initBookDemoForm } from "./booking-form.js";
    initBookDemoForm();
  </script>
</BaseLayout>
