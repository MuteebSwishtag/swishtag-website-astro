---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Thank You | Swishtag";
const description = "Your Swishtag demo request has been received.";
const canonical = "https://cms.swishtag.com/thank-you/";
const robots = "noindex,follow";
---
<BaseLayout title={title} description={description} canonical={canonical} robots={robots}>
  <style is:inline slot="head">
  :root{--ink:#202124;--muted:#6f7177;--line:rgba(32,33,36,.09);--lime:#c2ff02;--mint:#99feed;--lav:#d9d6fd;--peach:#ffbd9b;--shadow:0 20px 60px rgba(32,33,36,.10)}
      *{box-sizing:border-box}body{margin:0;color:var(--ink);font-family:"Plus Jakarta Sans",system-ui,sans-serif;background:radial-gradient(circle at 8% 10%,rgba(255,189,155,.52),transparent 22rem),radial-gradient(circle at 92% 12%,rgba(217,214,253,.70),transparent 24rem),radial-gradient(circle at 88% 80%,rgba(153,254,237,.45),transparent 24rem),linear-gradient(180deg,#fffdfa 0%,#fbfaf6 55%,#f8fbf8 100%)}
      a{color:inherit}.shell{width:min(1080px,calc(100% - 28px));margin:0 auto}.top{display:flex;align-items:center;justify-content:space-between;gap:14px;height:76px}.brand{font-weight:900;letter-spacing:.08em;text-decoration:none}.back{font-size:.85rem;text-decoration:none;color:#666}.wrap{padding:16px 0 54px}.card{background:rgba(255,255,255,.95);border:1px solid var(--line);border-radius:34px;box-shadow:var(--shadow);overflow:hidden}.card::before{content:"";display:block;height:5px;background:linear-gradient(90deg,var(--lime),var(--mint),var(--lav),var(--peach))}.inner{padding:34px}.layout{display:grid;grid-template-columns:1.08fr .92fr;gap:24px;align-items:center}.kicker{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:999px;background:rgba(194,255,2,.12);border:1px solid rgba(167,188,22,.22);font-size:.76rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#5f7014}.kicker i{width:8px;height:8px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 5px rgba(194,255,2,.16)}h1{margin:16px 0 12px;font-size:clamp(2rem,4vw,3.4rem);line-height:.95;letter-spacing:-.05em}p{margin:0;color:var(--muted);font-size:1rem;line-height:1.7;max-width:540px}.summary{margin-top:20px;padding:18px;border-radius:24px;background:linear-gradient(135deg,rgba(255,255,255,.97),rgba(250,251,247,.96));border:1px solid #e4e5e0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.item{padding:14px;border-radius:18px;background:#fff;border:1px solid #ecece8}.item small,.item strong{display:block}.item small{font-size:.75rem;color:#8c8e94;margin-bottom:6px;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.item strong{font-size:1rem;line-height:1.35}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}.btn{appearance:none;border:0;border-radius:999px;padding:15px 18px;font-size:.92rem;font-weight:900;display:inline-flex;align-items:center;justify-content:center;gap:10px;text-decoration:none}.btn-primary{background:var(--ink);color:#fff}.btn-primary b{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:var(--lime);color:var(--ink)}.btn-light{background:#fff;color:var(--ink);border:1px solid #dcddda}.visual{position:relative;display:flex;justify-content:center;align-items:center;min-height:440px}.visual::before{content:"";position:absolute;inset:auto 10% 12% 10%;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(153,254,237,.22),transparent 66%)}.visual::after{content:"";position:absolute;inset:8% 18% auto 18%;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(217,214,253,.30),transparent 70%)}img{position:relative;z-index:2;width:min(100%,440px);height:auto;display:block;filter:drop-shadow(0 18px 28px rgba(32,33,36,.10))}.note{margin-top:14px;padding:14px;border-radius:16px;background:rgba(153,254,237,.17);border:1px solid rgba(111,192,181,.12);font-size:.88rem;color:#536268}.spark,.spark::before,.spark::after{position:absolute;border-radius:50%;content:""}.spark{width:10px;height:10px;background:var(--lime);left:18%;top:18%;box-shadow:0 0 0 8px rgba(194,255,2,.10)}.spark::before{width:8px;height:8px;background:var(--mint);right:-180px;top:62px;box-shadow:0 0 0 7px rgba(153,254,237,.10)}.spark::after{width:7px;height:7px;background:var(--peach);left:40px;top:250px;box-shadow:0 0 0 6px rgba(255,189,155,.10)}.rocket-pack{position:absolute;z-index:0;width:170px;height:225px;left:22%;top:31%;transform:rotate(-7deg);pointer-events:none}.rocket-pack .core{position:absolute;left:52px;top:18px;width:72px;height:118px;border-radius:28px 28px 22px 22px;background:linear-gradient(180deg,#fbfcf8 0%,#edf1ee 68%,#dde3e2 100%);border:3px solid #14243a;box-shadow:inset 0 -12px 20px rgba(20,36,58,.07),0 12px 24px rgba(32,33,36,.08)}.rocket-pack .core::before{content:"";position:absolute;left:16px;right:16px;top:20px;height:8px;border-radius:999px;background:var(--lime);opacity:.72}.rocket-pack .booster{position:absolute;top:40px;width:42px;height:128px;border-radius:20px 20px 16px 16px;background:linear-gradient(180deg,#f9faf7,#e8edeb 74%,#d9e0df);border:3px solid #14243a;box-shadow:inset 0 -10px 16px rgba(20,36,58,.07)}.rocket-pack .booster::before{content:"";position:absolute;left:8px;right:8px;top:22px;height:7px;border-radius:999px;background:var(--mint);opacity:.8}.rocket-pack .booster.left{left:16px}.rocket-pack .booster.right{right:4px}.rocket-pack .nozzle{position:absolute;top:163px;width:34px;height:25px;border-radius:8px 8px 14px 14px;background:#17283d;border:3px solid #0e1a2a}.rocket-pack .nozzle.left{left:20px}.rocket-pack .nozzle.right{right:8px}.rocket-pack .nozzle::after{content:"";position:absolute;left:50%;top:20px;width:23px;height:60px;transform:translateX(-50%);border-radius:50%;background:linear-gradient(180deg,rgba(153,254,237,.70),rgba(194,255,2,.20) 48%,transparent 88%);filter:blur(7px);opacity:.62;animation:thrusterGlow 3.8s ease-in-out infinite}.rocket-trail{position:absolute;z-index:0;left:24%;top:67%;width:150px;height:130px;pointer-events:none;background:radial-gradient(circle at 48% 12%,rgba(153,254,237,.64) 0 3px,transparent 4px),radial-gradient(circle at 72% 32%,rgba(194,255,2,.48) 0 2px,transparent 3px),radial-gradient(circle at 36% 52%,rgba(217,214,253,.70) 0 2px,transparent 3px),radial-gradient(circle at 61% 77%,rgba(153,254,237,.40) 0 2px,transparent 3px);opacity:.68;animation:trailPulse 4.2s ease-in-out infinite}@keyframes thrusterGlow{0%,100%{opacity:.48;transform:translateX(-50%) scaleY(.92)}50%{opacity:.74;transform:translateX(-50%) scaleY(1.08)}}@keyframes trailPulse{0%,100%{opacity:.48;transform:translateY(0)}50%{opacity:.76;transform:translateY(5px)}}@media (max-width:900px){.layout{grid-template-columns:1fr}.visual{order:-1;min-height:280px}img{width:min(100%,300px)}.rocket-pack{left:31%;top:30%;transform:rotate(-7deg) scale(.76);transform-origin:top left}.rocket-trail{left:31%;top:66%;width:110px;height:92px}}@media (max-width:720px){.top{height:66px}.inner{padding:22px 16px}.grid{grid-template-columns:1fr}.actions{flex-direction:column}.btn{width:100%}.visual{min-height:220px}.rocket-pack{left:27%;top:28%;transform:rotate(-7deg) scale(.68)}.rocket-trail{left:27%;top:64%;transform:scale(.82);transform-origin:top left}}@media (prefers-reduced-motion:reduce){.rocket-pack .nozzle::after,.rocket-trail{animation:none}}
  </style>
  <main class="shell wrap">
      <div class="card"><div class="inner"><div class="layout">
        <div>
          <span class="kicker"><i></i> Mission confirmed</span>
          <h1>You’re cleared for launch.</h1>
          <p>Your demo is booked. We’ve sent the details to your email and we’ll come prepared for your company-store workflow.</p>
          <div class="summary">
            <div class="grid">
              <div class="item"><small>Date</small><strong id="d">Wednesday, August 20</strong></div>
              <div class="item"><small>Time</small><strong id="t">10:30 AM · America/Chicago</strong></div>
              <div class="item"><small>Company</small><strong id="c">Your company</strong></div>
              <div class="item"><small>Focus</small><strong id="f">General Enquiry Demo</strong></div>
            </div>
            <div class="note">Bring the messy workflow. We’ll bring the ideas.</div>
          </div>
          <div class="actions">
            <a class="btn btn-primary" href="../solutions/"><span>Back to Solutions</span><b>↗</b></a>
            <a class="btn btn-light" href="../book-demo/">Book another demo</a>
          </div>
        </div>
        <div class="visual"><div class="spark"></div><div class="rocket-pack" aria-hidden="true"><span class="core"></span><span class="booster left"></span><span class="booster right"></span><span class="nozzle left"></span><span class="nozzle right"></span></div><div class="rocket-trail" aria-hidden="true"></div><img src="/assets/inline/book-demo-astronaut-ddb5d215f2.webp" alt="Swishtag astronaut mascot floating with a rocket pack in a mission confirmed pose"></div>
      </div></div></div>
    </main>
  <script is:inline slot="scripts">
const params = new URLSearchParams(location.search);
    const fields = {d:'date',t:'time',c:'company',f:'focus'};
    for (const [id,key] of Object.entries(fields)) {
      const value = params.get(key); if (value) document.getElementById(id).textContent = value;
    }
  </script>
</BaseLayout>
