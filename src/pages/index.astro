---
import BaseLayout from '../layouts/BaseLayout.astro';
import faqs from '../data/faqs.json';
import Hero from '../components/home/Hero.astro';
import Credibility from '../components/home/Credibility.astro';
import GrowthPain from '../components/home/GrowthPain.astro';
import Solutions from '../components/home/Solutions.astro';
import CustomerStory from '../components/home/CustomerStory.astro';
import PlatformPortfolio from '../components/home/PlatformPortfolio.astro';
import Systems from '../components/home/Systems.astro';
import Industries from '../components/home/Industries.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import HomeScripts from '../components/home/HomeScripts.astro';

export const prerender = true;

const title = "Promotional Products Technology Company | Swishtag";
const description = "Promotional products technology company for distributors, suppliers and decorators: Shopify company stores, PunchOut, automation and custom software.";
const canonical = "https://swishtag.com/";
---
<BaseLayout title={title} description={description} canonical={canonical} faq={faqs.home}>
  <link slot="head" rel="preload" as="image" type="image/webp" href="/assets/inline/home-hero-rocket-6095549f75.webp" fetchpriority="high" />
  <main id="home">
    <Hero />
    <Credibility />
    <GrowthPain />
    <Solutions />
    <CustomerStory />
    <PlatformPortfolio />
    <Systems />
    <Industries />
    <Faq />
    <FinalCta />
  </main>
  <HomeScripts slot="scripts" />
</BaseLayout>
