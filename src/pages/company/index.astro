---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyReferencePage from '../../components/reference-pages/CompanyReferencePage.astro';

export const prerender = true;

const title = 'About Swishtag | Promo Commerce Technology Team';
const description = 'Swishtag is a Shopify Partner and PPAI member building ecommerce, integrations, automation and software for promotional products businesses.';
const canonical = 'https://swishtag.com/company/';
const robots = 'index,follow';
---

<BaseLayout title={title} description={description} canonical={canonical} robots={robots} pageType="AboutPage">
  <CompanyReferencePage />
</BaseLayout>
